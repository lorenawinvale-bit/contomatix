<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Why does my link still show an old preview after I updated the tags?', acceptedAnswer: { '@type': 'Answer', text: 'Most platforms cache the preview and will not re-check automatically. Use the platform own debugging tool (Facebook Sharing Debugger, LinkedIn Post Inspector) to force a re-scrape.' } },
      { '@type': 'Question', name: 'Do I need separate tags for Twitter/X?', acceptedAnswer: { '@type': 'Answer', text: 'X reads its own twitter:card meta tags but falls back to standard Open Graph tags if those are not present.' } },
      { '@type': 'Question', name: 'Does this affect my SEO or search rankings?', acceptedAnswer: { '@type': 'Answer', text: 'Not directly. Open Graph tags are not a ranking factor but affect click-through rate on social shares.' } },
      { '@type': 'Question', name: 'What happens if I do not set an og:image?', acceptedAnswer: { '@type': 'Answer', text: 'Most platforms will show no image or auto-select one from the page with unpredictable results. Always set one explicitly.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything is generated in your browser with JavaScript - nothing is uploaded, logged, or stored on any server, including ours.' } }
    ]
  }) %>
</script>

<script>
(function () {
  var platform = 'facebook';
  var LABELS = { facebook: 'Facebook preview', linkedin: 'LinkedIn preview', twitter: 'X / Twitter preview' };
  var LIMITS = {
    facebook: { title: 60, desc: 110 },
    linkedin: { title: 70, desc: 100 },
    twitter: { title: 70, desc: 125 }
  };

  function truncate(text, max) {
    if (!text) return '';
    if (text.length <= max) return text;
    return text.slice(0, max - 1).trim() + '…';
  }

  function domainOf(raw) {
    try { return new URL(raw).hostname.replace(/^www\./, ''); } catch (e) { return 'example.com'; }
  }

  function build() {
    var url = document.getElementById('og-url').value.trim();
    var title = document.getElementById('og-title').value.trim();
    var desc = document.getElementById('og-desc').value.trim();
    var image = document.getElementById('og-image').value.trim();
    var limits = LIMITS[platform];

    document.getElementById('og-card-domain').textContent = domainOf(url || 'https://example.com');
    document.getElementById('og-card-title').textContent = title ? truncate(title, limits.title) : 'Your title will appear here';
    document.getElementById('og-card-desc').textContent = desc ? truncate(desc, limits.desc) : 'Your description will appear here.';
    var imgEl = document.getElementById('og-card-image');
    if (image) {
      imgEl.style.backgroundImage = 'url(' + JSON.stringify(image).slice(1, -1) + ')';
      imgEl.textContent = '';
    } else {
      imgEl.style.backgroundImage = 'none';
      imgEl.textContent = 'No image set';
    }

    var tags = [
      '<meta property="og:type" content="website">',
      '<meta property="og:url" content="' + (url || '') + '">',
      '<meta property="og:title" content="' + (title || '') + '">',
      '<meta property="og:description" content="' + (desc || '') + '">',
      '<meta property="og:image" content="' + (image || '') + '">',
      '<meta name="twitter:card" content="summary_large_image">',
      '<meta name="twitter:title" content="' + (title || '') + '">',
      '<meta name="twitter:description" content="' + (desc || '') + '">',
      '<meta name="twitter:image" content="' + (image || '') + '">'
    ].join('\n');
    document.getElementById('og-output').textContent = tags;
    document.getElementById('og-status').textContent = 'Updated';
  }

  function setPlatform(p) {
    platform = p;
    document.getElementById('og-platform-label').textContent = LABELS[p];
    ['facebook', 'linkedin', 'twitter'].forEach(function (key) {
      var btn = document.getElementById('og-btn-' + key);
      btn.classList.toggle('btn-primary', key === p);
      btn.classList.toggle('btn-outline', key !== p);
    });
    document.getElementById('og-card').classList.toggle('og-card-linkedin', p === 'linkedin');
    document.getElementById('og-card').classList.toggle('og-card-twitter', p === 'twitter');
    build();
  }

  document.querySelectorAll('#og-form input, #og-form textarea').forEach(function (el) {
    el.addEventListener('input', build);
  });
  document.getElementById('og-btn-facebook').addEventListener('click', function () { setPlatform('facebook'); });
  document.getElementById('og-btn-linkedin').addEventListener('click', function () { setPlatform('linkedin'); });
  document.getElementById('og-btn-twitter').addEventListener('click', function () { setPlatform('twitter'); });

  document.getElementById('og-copy').addEventListener('click', function () {
    navigator.clipboard.writeText(document.getElementById('og-output').textContent).then(function () {
      var status = document.getElementById('og-status');
      status.textContent = 'Copied!';
      setTimeout(function () { status.textContent = 'Updated'; }, 1800);
    });
  });

  setPlatform('facebook');
})();
</script>
