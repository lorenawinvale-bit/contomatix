<script>
(function () {
  function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function countLabel(len, max) { return len === 0 ? '' : (len + ' / ' + max + (len > max ? ' (over)' : '')); }

  function build() {
    var title = document.getElementById('mt-title').value.trim();
    var desc = document.getElementById('mt-desc').value.trim();
    var url = document.getElementById('mt-url').value.trim();
    var author = document.getElementById('mt-author').value.trim();
    var robots = document.getElementById('mt-robots').value;

    document.getElementById('mt-title-count').textContent = countLabel(title.length, 60);
    document.getElementById('mt-desc-count').textContent = countLabel(desc.length, 160);
    document.getElementById('mt-title-count').style.color = title.length > 60 ? '#B94340' : '';
    document.getElementById('mt-desc-count').style.color = desc.length > 160 ? '#B94340' : '';

    var lines = [
      '<meta charset="UTF-8">',
      '<meta name="viewport" content="width=device-width, initial-scale=1.0">',
      '<title>' + esc(title) + '</title>',
      '<meta name="description" content="' + esc(desc) + '">',
      '<meta name="robots" content="' + robots + '">'
    ];
    if (url) lines.push('<link rel="canonical" href="' + esc(url) + '">');
    if (author) lines.push('<meta name="author" content="' + esc(author) + '">');
    lines.push('<meta property="og:title" content="' + esc(title) + '">');
    lines.push('<meta property="og:description" content="' + esc(desc) + '">');
    if (url) lines.push('<meta property="og:url" content="' + esc(url) + '">');
    lines.push('<meta property="og:type" content="website">');

    document.getElementById('mt-output').textContent = lines.join('\n');
    document.getElementById('mt-status').textContent = 'Updated';
  }

  document.querySelectorAll('#mt-form input, #mt-form textarea, #mt-form select').forEach(function (el) {
    el.addEventListener('input', build);
  });

  document.getElementById('mt-copy').addEventListener('click', function () {
    navigator.clipboard.writeText(document.getElementById('mt-output').textContent).then(function () {
      var status = document.getElementById('mt-status');
      status.textContent = 'Copied!';
      setTimeout(function () { status.textContent = 'Updated'; }, 1800);
    });
  });

  document.getElementById('mt-download').addEventListener('click', function () {
    var text = document.getElementById('mt-output').textContent;
    var blob = new Blob([text], { type: 'text/html' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'meta-tags.html';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  build();
})();
</script>
