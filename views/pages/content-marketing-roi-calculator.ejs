<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var current = '';
  function num(id) { var v = $(id).value.trim(); if (v === '') return null; var n = parseFloat(v); return isNaN(n) ? null : n; }
  function money(n) { var c = $('cr-currency').value || '$'; return (n < 0 ? '-' : '') + c + Math.round(Math.abs(n)).toLocaleString('en-US'); }
  function money2(n) { var c = $('cr-currency').value || '$'; return c + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

  function build() {
    var months = num('cr-months');
    var create = num('cr-create') || 0, promo = num('cr-promo') || 0, tools = num('cr-tools') || 0, hours = num('cr-hours') || 0, rate = num('cr-rate') || 0;
    var leads = num('cr-leads'), close = num('cr-close'), value = num('cr-value'), direct = num('cr-direct') || 0;
    var time = hours * rate, cost = create + promo + tools + time;
    if (!months || cost <= 0) return null;
    var customers = (leads !== null && close !== null) ? leads * close / 100 : null;
    var fromLeads = (customers !== null && value !== null) ? customers * value : null;
    if (fromLeads === null && !direct) return null;
    var ret = (fromLeads || 0) + direct;
    var roi = (ret - cost) / cost * 100;
    var o = [];
    o.push('CONTENT MARKETING ROI (' + months + ' month' + (months === 1 ? '' : 's') + ')');
    o.push('');
    o.push('COSTS');
    if (create) o.push('Content creation: ' + money(create));
    if (promo) o.push('Distribution and promotion: ' + money(promo));
    if (tools) o.push('Tools and software: ' + money(tools));
    if (time) o.push('Internal time: ' + money(time) + ' (' + hours + ' hours x ' + money(rate) + ')');
    o.push('TOTAL COST: ' + money(cost));
    o.push('');
    o.push('RETURN');
    if (fromLeads !== null) o.push('Customers from content leads: ' + (Math.round(customers * 100) / 100) + ' (' + leads + ' leads x ' + close + '%)');
    if (fromLeads !== null) o.push('Revenue from those customers: ' + money(fromLeads));
    if (direct) o.push('Direct revenue: ' + money(direct));
    o.push('TOTAL RETURN: ' + money(ret));
    o.push('');
    o.push('ROI: ' + (Math.round(roi * 10) / 10) + '% ' + (roi > 0 ? '(paid back)' : roi === 0 ? '(break-even)' : '(not paid back yet)'));
    o.push('Net result: ' + money(ret - cost));
    if (leads) o.push('Cost per lead: ' + money2(cost / leads));
    if (customers) o.push('Cost per customer: ' + money2(cost / customers));
    if (close && value && close > 0) { var need = cost / (value * close / 100); o.push('Break-even leads at your close rate: ' + (Math.ceil(need * 10) / 10) + (leads ? ' (you had ' + leads + ')' : '')); }
    return { text: o.join('\n'), roi: roi, hasTime: time > 0, direct: direct, fromLeads: fromLeads };
  }

  function notes(r) {
    var n = [];
    if (!r.hasTime) n.push('No internal time is included. If your team spent hours on the content, add them to see a fuller cost.');
    if (r.fromLeads !== null && r.direct) n.push('Check that direct revenue and lead-based revenue do not count the same customers twice.');
    n.push('ROI depends on how you attribute leads to content. State your attribution rule and keep it the same between periods.');
    if (r.roi < 0) n.push('A negative ROI over a short window is common for search content, which can take months to rank. Re-run with a longer period.');
    $('cr-notes').innerHTML = n.map(function (t) { return '<div>&#9888; ' + t.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</div>'; }).join('');
  }

  function run() {
    var r = build();
    current = r ? r.text : '';
    $('cr-output').textContent = r ? r.text : 'Enter at least one cost and the leads, close rate and revenue per customer (or direct revenue) to start.';
    $('cr-status').textContent = r ? 'Calculated' : 'Waiting for input';
    if (r) notes(r); else $('cr-notes').innerHTML = '';
  }

  Array.prototype.slice.call($('cr-form').querySelectorAll('input')).forEach(function (e) { e.addEventListener('input', run); e.addEventListener('change', run); });
  $('cr-copy').addEventListener('click', function () {
    if (!current) return; var b = $('cr-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(current).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
  });
  $('cr-download').addEventListener('click', function () {
    if (!current) return;
    var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([current], { type: 'text/plain' })); a.download = 'content-marketing-roi.txt';
    document.body.appendChild(a); a.click(); a.remove();
  });
  run();
})();
</script>
