<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var STOP = 'a an the and or of to in on at for with by from as is are be it its this that your my our how what why index home page pages html htm php asp aspx jsp www'.split(' ');
  var rows = [], outText = '';

  function lines(t) { return t.split(/\r?\n/).map(function (l) { return l.trim(); }).filter(Boolean); }
  function pathOf(u) {
    var p = u;
    try { p = new URL(/^[a-z][a-z0-9+.-]*:\/\//i.test(u) ? u : 'https://x.invalid' + (u.charAt(0) === '/' ? '' : '/') + u).pathname; } catch (e) { p = u.split(/[?#]/)[0]; }
    try { p = decodeURI(p); } catch (e2) {}
    return p || '/';
  }
  function hostOf(u) {
    if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(u)) return '';
    try { return new URL(u).host.toLowerCase().replace(/^www\./, ''); } catch (e) { return ''; }
  }
  function norm(p) {
    p = p.toLowerCase().replace(/\.(html?|php\d?|aspx?|jsp)$/, '').replace(/\/index$/, '').replace(/\/+$/, '');
    return p || '/';
  }
  function stem(w) {
    if (w.length > 4 && /ies$/.test(w)) return w.slice(0, -3) + 'y';
    if (w.length > 3 && /s$/.test(w) && !/ss$/.test(w)) return w.slice(0, -1);
    return w;
  }
  function tokens(p) {
    return p.replace(/[^a-z0-9]+/g, ' ').trim().split(' ').filter(function (w) { return w && !/^\d{1,4}$/.test(w) && STOP.indexOf(w) === -1; }).map(stem);
  }
  function lastSeg(p) { var s = p.split('/'); return s[s.length - 1] || ''; }
  function uniq(a) { return a.filter(function (x, i) { return a.indexOf(x) === i; }); }
  function jaccard(a, b) {
    if (!a.length || !b.length) return 0;
    var inter = a.filter(function (x) { return b.indexOf(x) !== -1; }).length;
    return inter / (a.length + b.length - inter);
  }
  function csvCell(v) { v = String(v == null ? '' : v); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }
  function nginxEsc(p) { return p.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

  function build() {
    var olds = lines($('rm-old').value), news = lines($('rm-new').value);
    var out = $('rm-output'), status = $('rm-status');
    rows = []; outText = '';
    if (!olds.length || !news.length) { out.textContent = 'Paste old and new URLs to build the map.'; status.textContent = 'Waiting for input'; return; }
    var N = news.map(function (u) { var p = pathOf(u); var n = norm(p); return { url: u, path: p, n: n, last: lastSeg(n), tok: uniq(tokens(n)) }; });
    var newSet = {}; N.forEach(function (x) { newSet[x.n] = x; });
    var oldSet = {}; olds.forEach(function (u) { oldSet[norm(pathOf(u))] = true; });
    var counts = {};
    rows = olds.map(function (u) {
      var p = pathOf(u), n = norm(p), tok = uniq(tokens(n)), last = lastSeg(n);
      var best = null, score = 0, why = '';
      if (newSet[n]) { best = newSet[n]; score = 100; why = 'Same path'; }
      else {
        N.forEach(function (x) {
          var s = jaccard(tok, x.tok);
          if (last && x.last === last && x.last.length > 2) s = Math.max(s, 0.9);
          if (s > score || (s === score && best && x.n.length < best.n.length)) { score = s; best = x; }
        });
        score = Math.round(score * 100);
        why = score >= 90 && best && lastSeg(best.n) === last ? 'Same page name, new folder' : 'Word overlap';
      }
      var st = score >= 60 ? 'Match' : score >= 34 ? 'Review' : 'No match';
      var target = st === 'No match' ? '' : best.path;
      if (target) counts[target] = (counts[target] || 0) + 1;
      var note = [];
      if (n === '/') { note.push('Homepage: confirm this is intended'); }
      var tUrl = st === 'No match' ? '' : best.url;
      var sameUrl = !!target && target === p && (!hostOf(u) || !hostOf(tUrl) || hostOf(u) === hostOf(tUrl));
      return { old: u, oldPath: p, target: target, targetUrl: tUrl, score: score, st: st, why: st === 'No match' ? '' : why, note: note, same: sameUrl, hostChange: !!target && hostOf(u) && hostOf(tUrl) && hostOf(u) !== hostOf(tUrl) };
    });
    var matched = 0, review = 0, none = 0, chains = 0;
    rows.forEach(function (r) {
      if (r.st === 'Match') matched++; else if (r.st === 'Review') review++; else none++;
      if (r.target && !r.same && oldSet[norm(r.target)] && norm(r.target) !== norm(r.oldPath)) { r.note.push('Chain risk: target is also an old URL'); chains++; }
      if (r.same) r.note.push('Same URL on both sides: no redirect needed');
      else if (r.target && r.hostChange && r.target === r.oldPath) r.note.push('Same path on a new domain');
      if (r.target && counts[r.target] > 1) r.note.push(counts[r.target] + ' old URLs point here');
    });
    var fmt = $('rm-format').value, L = [];
    var usable = rows.filter(function (r) { return r.target && !r.same; });
    if (fmt === 'apache') {
      L.push('# 301 redirects, generated by the Contomatix Redirect Mapper. Review before use.');
      usable.forEach(function (r) { L.push('Redirect 301 ' + r.oldPath + ' ' + r.targetUrl); });
      if (!usable.length) L.push('# No redirect rules to write yet.');
    } else if (fmt === 'nginx') {
      L.push('# 301 redirects, generated by the Contomatix Redirect Mapper. Review before use.');
      usable.forEach(function (r) { L.push('rewrite ^' + nginxEsc(r.oldPath) + '$ ' + r.targetUrl + ' permanent;'); });
      if (!usable.length) L.push('# No redirect rules to write yet.');
    } else if (fmt === 'csv') {
      L.push('old_url,new_url,status,match_percent,reason,notes');
      rows.forEach(function (r) { L.push([r.old, r.targetUrl, r.st, r.score, r.why, r.note.join('; ')].map(csvCell).join(',')); });
    } else {
      L.push('SUMMARY: ' + olds.length + ' old URLs · ' + matched + ' match · ' + review + ' to review · ' + none + ' with no match' + (chains ? ' · ' + chains + ' chain risk' : ''));
      L.push('');
      rows.forEach(function (r) {
        L.push(r.oldPath + '\n    → ' + (r.target ? r.target + '  [' + r.st + ', ' + r.score + '% · ' + r.why + ']' : 'NO MATCH: map by hand or retire'));
        r.note.forEach(function (x) { L.push('    ! ' + x); });
      });
      var used = {}; rows.forEach(function (r) { if (r.target) used[norm(r.target)] = true; });
      var spare = N.filter(function (x) { return !used[x.n]; });
      if (spare.length) { L.push(''); L.push('NEW URLS WITH NO OLD URL POINTING AT THEM (' + spare.length + ')'); spare.slice(0, 25).forEach(function (x) { L.push('  - ' + x.path); }); }
    }
    outText = L.join('\n');
    out.textContent = outText;
    status.textContent = matched + ' match · ' + review + ' review · ' + none + ' none';
  }

  ['rm-old', 'rm-new'].forEach(function (id) { $(id).addEventListener('input', build); });
  $('rm-format').addEventListener('change', build);
  $('rm-copy').addEventListener('click', function () {
    if (!outText) return;
    var b = $('rm-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(outText).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
  });
  $('rm-csv').addEventListener('click', function () {
    if (!rows.length) return;
    var L = ['old_url,new_url,status,match_percent,reason,notes'];
    rows.forEach(function (r) { L.push([r.old, r.targetUrl, r.st, r.score, r.why, r.note.join('; ')].map(csvCell).join(',')); });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([L.join('\n')], { type: 'text/csv' }));
    a.download = 'redirect-map.csv';
    document.body.appendChild(a); a.click(); a.remove();
  });
  build();
})();
</script>
