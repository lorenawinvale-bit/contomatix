<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var current = '';
  function num(id) { var v = $(id).value.trim(); if (v === '') return null; var n = parseFloat(v); return isNaN(n) ? null : n; }
  function money(n) { var c = $('lc-currency').value || '$'; return c + Math.round(n).toLocaleString('en-US'); }
  function money2(n) { var c = $('lc-currency').value || '$'; return c + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

  function toggle() {
    var m = $('lc-model').value;
    $('lc-row-price').style.display = m === 'perlink' ? '' : 'none';
    $('lc-row-retainer').style.display = m === 'retainer' ? '' : 'none';
    $('lc-row-hours').style.display = m === 'inhouse' ? '' : 'none';
    $('lc-row-rate').style.display = m === 'inhouse' ? '' : 'none';
  }

  function build() {
    var m = $('lc-model').value, months = num('lc-months'), links = num('lc-links');
    if (!months || !links) return null;
    var content = num('lc-content') || 0, tools = num('lc-tools') || 0, loss = num('lc-loss') || 0, pages = num('lc-pages');
    var fees = null, label = '';
    if (m === 'perlink') { var p = num('lc-price'); if (p === null) return null; fees = p * links * months; label = money(p) + ' per link x ' + links + ' links x ' + months + ' months'; }
    if (m === 'retainer') { var r = num('lc-retainer'); if (r === null) return null; fees = r * months; label = money(r) + ' retainer x ' + months + ' months'; }
    if (m === 'inhouse') { var h = num('lc-hours'), rate = num('lc-rate'); if (h === null || rate === null) return null; fees = h * rate * months; label = h + ' hours x ' + money(rate) + ' x ' + months + ' months'; }
    var extras = (content + tools) * months;
    var total = fees + extras;
    var planned = links * months, live = planned * (1 - loss / 100);
    var out = [];
    out.push('LINK BUILDING COST');
    out.push('');
    out.push('Model: ' + ({ perlink: 'per link', retainer: 'monthly retainer', inhouse: 'in-house' })[m]);
    out.push('Link fees or time: ' + money(fees) + ' (' + label + ')');
    if (content) out.push('Content or assets: ' + money(content * months) + ' (' + money(content) + ' x ' + months + ' months)');
    if (tools) out.push('Tools and software: ' + money(tools * months) + ' (' + money(tools) + ' x ' + months + ' months)');
    out.push('TOTAL COST: ' + money(total));
    out.push('');
    out.push('Links planned: ' + planned);
    out.push('Links expected to go live and stay' + (loss ? ' (' + loss + '% lost)' : '') + ': ' + (Math.round(live * 10) / 10));
    if (live > 0) {
      out.push('Cost per planned link: ' + money2(total / planned));
      out.push('COST PER LIVE LINK: ' + money2(total / live));
    }
    if (pages) out.push('Cost per target page (' + pages + ' pages): ' + money(total / pages) + ', about ' + (Math.round(live / pages * 10) / 10) + ' live links each');
    out.push('Cost per month: ' + money(total / months));
    return { text: out.join('\n'), total: total, planned: planned, live: live, m: m, loss: loss, extras: extras, fees: fees };
  }

  function notes(r) {
    var n = [];
    if (r.extras > 0 && r.fees > 0 && r.extras / r.total >= 0.3) n.push('Content and tools are ' + Math.round(r.extras / r.total * 100) + '% of the total: compare quotes with the same inclusions.');
    if (!r.loss) n.push('You set no loss rate. If links can be rejected or removed, add an expected share to see a more honest cost per live link.');
    if (r.m === 'inhouse') n.push('In-house cost uses your time only. Add tools and content costs if you buy them.');
    n.push('Cost per link does not measure quality. Check relevance and how paid links are marked before you compare prices.');
    $('lc-notes').innerHTML = n.map(function (t) { return '<div>&#9888; ' + t.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</div>'; }).join('');
  }

  function run() {
    toggle();
    var r = build();
    current = r ? r.text : '';
    $('lc-output').textContent = r ? r.text : 'Enter the links per month and a price, retainer or hours to start.';
    $('lc-status').textContent = r ? 'Calculated' : 'Waiting for input';
    if (r) notes(r); else $('lc-notes').innerHTML = '';
  }

  Array.prototype.slice.call($('lc-form').querySelectorAll('input,select')).forEach(function (e) { e.addEventListener('input', run); e.addEventListener('change', run); });
  $('lc-copy').addEventListener('click', function () {
    if (!current) return; var b = $('lc-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(current).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
  });
  $('lc-download').addEventListener('click', function () {
    if (!current) return;
    var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([current], { type: 'text/plain' })); a.download = 'link-building-cost.txt';
    document.body.appendChild(a); a.click(); a.remove();
  });
  run();
})();
</script>
