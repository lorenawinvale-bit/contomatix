<% var gpal = { 'Link Building': '#0EA5A0', 'On-Page SEO': '#D97706', 'Keyword Research': '#DB2777', 'Technical SEO': '#334155', 'Content Strategy': '#B45309', 'SEO Reporting': '#0E7490' }; var isFirst = (page === 1 && activeCategory === 'All' && !search); %>
<section class="bl-hero">
  <div class="container">
    <span class="eyebrow">The Contomatix blog</span>
    <h1>SEO guides backed by our own data</h1>
    <p>Link building, on-page and technical SEO, written from what we measure on real sites. <%= totalPosts %> guides and counting.</p>
    <form class="bl-search" method="get" action="/blog" role="search">
      <% if (activeCategory && activeCategory !== 'All') { %><input type="hidden" name="category" value="<%= activeCategorySlug %>"><% } %>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" name="q" placeholder="Search <%= totalPosts %> guides" value="<%= search || '' %>" aria-label="Search the blog">
      <button type="submit">Search</button>
    </form>
    <div class="bl-cats">
      <% categories.filter(function(cat){ return cat.name === 'All' || cat.name === activeCategory || (catCounts[cat.name] || 0) >= 10; }).forEach(function(cat) { %>
        <a class="bl-cat <%= cat.name === activeCategory ? 'active' : '' %>" href="/blog?category=<%= cat.slug %><%= search ? '&q=' + encodeURIComponent(search) : '' %>"><%= cat.name %><em><%= cat.name === 'All' ? totalPosts : (catCounts[cat.name] || 0) %></em></a>
      <% }); %>
    </div>
    <% if (search) { %><p class="bl-result"><%= resultCount %> result<%= resultCount === 1 ? '' : 's' %> for &ldquo;<%= search %>&rdquo; &middot; <a href="/blog">Clear</a></p><% } %>
  </div>
</section>

<% if (posts.length) { %>
<section class="bl-grid-wrap">
  <div class="container">
    <div class="bl-grid">
      <% posts.forEach(function(p, gi) { var c = gpal[p.category] || '#0EA5A0'; var feat = isFirst && gi === 0; %>
        <a class="bl-card<%= feat ? ' bl-feat' : '' %>" href="/blog/<%= p.slug %>" style="--c:<%= c %>;--i:<%= gi %>">
          <div class="bl-img">
            <% if (p.image) { %><picture><source srcset="<%= p.image.replace(/\.png$/, '.webp') %>" type="image/webp"><img src="<%= p.image %>" alt="<%= p.title %>" width="1200" height="630" loading="<%= gi < 3 ? 'eager' : 'lazy' %>" decoding="async"></picture><% } %>
          </div>
          <div class="bl-body">
            <div class="bl-meta"><span class="bl-tag"><%= p.category %></span><span><%= p.date %></span></div>
            <h2><%= p.title %></h2>
            <% if (feat) { %><p class="bl-ex"><%= p.excerpt %></p><% } %>
            <div class="bl-by">
              <% if (p.authorInfo.hasPhoto) { %><img src="<%= p.authorInfo.photo %>" alt="" width="26" height="26"><% } else { %><span class="bl-ini"><%= p.authorInfo.name.split(' ').map(function(w){ return w[0]; }).join('') %></span><% } %>
              <span><%= p.authorInfo.name %></span><span class="bl-dot"></span><span><%= p.readMinutes %> min read</span>
              <u>&rarr;</u>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } else { %>
<div class="container"><p style="color:var(--text-dim);padding:40px 0;">No posts match yet, check back soon.</p></div>
<% } %>

<div class="container">
  <div class="newsletter-block">
    <div>
      <h2>Join our newsletter</h2>
      <p>Get exclusive access to the latest SEO strategy, link building tactics, and product updates.</p>
      <form class="newsletter-form" action="/contact" method="get">
        <input type="email" placeholder="Your email" required>
        <button class="btn btn-primary" type="submit">Submit</button>
      </form>
      <div class="newsletter-perks">
        <span>&#10003; 0% spam, 100% value</span>
        <span>&#10003; Proven strategies</span>
        <span>&#10003; Unsubscribe anytime</span>
      </div>
    </div>
    <div class="newsletter-visual">
      <img src="/images/illus-newsletter.svg" alt="Illustration of an email newsletter with SEO tips" width="520" height="420" loading="lazy">
    </div>
  </div>
</div>

<%
  var qParam = search ? '&q=' + encodeURIComponent(search) : '';
  var catParam = (activeCategorySlug && activeCategorySlug !== 'all') ? 'category=' + activeCategorySlug : '';
  function pageHref(n) {
    var parts = [];
    if (catParam) parts.push(catParam);
    if (n > 1) parts.push('page=' + n);
    if (search) parts.push('q=' + encodeURIComponent(search));
    return '/blog' + (parts.length ? '?' + parts.join('&') : '');
  }
%>
<% if (totalPages > 1) { %>
<div class="container">
  <div class="pagination">
    <% if (page > 1) { %>
      <a href="<%= pageHref(page - 1) %>" class="page-link">&laquo; Prev</a>
    <% } %>
    <% for (let i = 1; i <= totalPages; i++) { %>
      <% if (i === page) { %>
        <span class="current"><%= i %></span>
      <% } else { %>
        <a href="<%= pageHref(i) %>"><%= i %></a>
      <% } %>
    <% } %>
    <% if (page < totalPages) { %>
      <a href="<%= pageHref(page + 1) %>" class="page-link">Next &raquo;</a>
    <% } %>
  </div>
</div>
<% } %>
