<section class="blog-header">
  <div class="container">
    <h1>Contomatix blog</h1>
    <p>SEO strategy, link building tactics, and content insights — from the Contomatix team.</p>
  </div>
</section>

<div class="container blog-toolbar">
  <div class="category-tabs">
    <% categories.forEach(function(cat) { %>
      <a class="category-tab <%= cat === activeCategory ? 'active' : '' %>" href="/blog?category=<%= encodeURIComponent(cat) %><%= search ? '&q=' + encodeURIComponent(search) : '' %>"><%= cat %></a>
    <% }); %>
  </div>
  <form class="search-form" method="get" action="/blog">
    <% if (activeCategory && activeCategory !== 'All') { %><input type="hidden" name="category" value="<%= activeCategory %>"><% } %>
    <input class="search-box" type="search" name="q" placeholder="Search..." value="<%= search || '' %>">
  </form>
</div>

<% if (posts.length) { %>
<div class="container">
  <div class="post-grid post-grid-main">
    <% posts.forEach(function(p) { %>
      <a class="post-card" href="/blog/<%= p.slug %>">
        <div class="post-image">
          <% if (p.image) { %><img src="<%= p.image %>" alt="" width="360" height="225" loading="lazy"><% } %>
        </div>
        <div class="post-body">
          <span class="story-tag"><%= p.category %></span>
          <h3><%= p.title %></h3>
          <div class="post-byline">
            <% if (p.authorInfo.hasPhoto) { %>
              <img class="post-byline-avatar" src="<%= p.authorInfo.photo %>" alt="" width="24" height="24">
            <% } else { %>
              <span class="post-byline-avatar post-byline-initials"><%= p.authorInfo.name.split(' ').map(function(w){ return w[0]; }).join('') %></span>
            <% } %>
            <span class="post-byline-name"><%= p.authorInfo.name %></span>
            <span class="post-byline-sep">&middot;</span>
            <span class="post-byline-date"><%= p.date %></span>
            <span class="post-byline-sep">&middot;</span>
            <span class="post-byline-read"><%= p.readMinutes %> min read</span>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
</div>
<% } else { %>
<div class="container">
  <p style="color:var(--text-dim); padding: 40px 0;">No posts in this category yet — check back soon.</p>
</div>
<% } %>

<div class="container">
  <div class="newsletter-block">
    <div>
      <h2>Join our newsletter</h2>
      <p>Get exclusive access to the latest SEO strategy, link building tactics, and product updates.</p>
      <form class="newsletter-form" action="/contact" method="get">
        <input type="email" placeholder="Your email" required>
        <button class="btn btn-primary" type="submit">Submit</button>
      </form>
      <div class="newsletter-perks">
        <span>&#10003; 0% spam, 100% value</span>
        <span>&#10003; Proven strategies</span>
        <span>&#10003; Unsubscribe anytime</span>
      </div>
    </div>
    <div class="newsletter-visual">
      <img src="/images/illus-newsletter.svg" alt="" width="520" height="420" loading="lazy">
    </div>
  </div>
</div>

<%
  var qParam = search ? '&q=' + encodeURIComponent(search) : '';
%>
<% if (totalPages > 1) { %>
<div class="container">
  <div class="pagination">
    <% if (page > 1) { %>
      <a href="/blog?category=<%= encodeURIComponent(activeCategory) %><%= qParam %>&page=<%= page - 1 %>" class="page-link">&laquo; Prev</a>
    <% } %>
    <% for (let i = 1; i <= totalPages; i++) { %>
      <% if (i === page) { %>
        <span class="current"><%= i %></span>
      <% } else { %>
        <a href="/blog?category=<%= encodeURIComponent(activeCategory) %><%= qParam %>&page=<%= i %>"><%= i %></a>
      <% } %>
    <% } %>
    <% if (page < totalPages) { %>
      <a href="/blog?category=<%= encodeURIComponent(activeCategory) %><%= qParam %>&page=<%= page + 1 %>" class="page-link">Next &raquo;</a>
    <% } %>
  </div>
</div>
<% } %>
