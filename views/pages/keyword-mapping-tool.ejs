<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var STOP = 'a an the and or of to in on at for with by from as is are be it its this that your my our how what why best top free near me vs'.split(' ');
  var rowsOut = [];
  var text = '';

  function stem(w) {
    if (w.length > 4 && /ies$/.test(w)) return w.slice(0, -3) + 'y';
    if (w.length > 3 && /(ses|xes|ches|shes)$/.test(w)) return w.slice(0, -2);
    if (/^(saas|bias|gas|atlas|canvas|alias|lens|plus|bonus|focus|status|analysis|basis|thesis|campus|virus|chaos)$/.test(w)) return w;
    if (w.length > 3 && /s$/.test(w) && !/(ss|is|us)$/.test(w)) return w.slice(0, -1);
    return w;
  }
  function tokens(s) {
    return (s || '').toLowerCase().replace(/&/g, ' and ').split(/[^a-z0-9]+/).filter(Boolean)
      .filter(function (w) { return STOP.indexOf(w) === -1; }).map(stem);
  }
  function unique(a) { return a.filter(function (x, i) { return a.indexOf(x) === i; }); }
  function slugOf(k) {
    return String(k).toLowerCase().replace(/&/g, ' and ').split(/[^a-z0-9]+/).filter(function (w) { return w && STOP.indexOf(w) === -1; }).join('-') || 'new-page';
  }
  function csv(v) { v = String(v == null ? '' : v); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }
  function pathOf(u) { try { var x = new URL(u); return x.pathname + x.search; } catch (e) { return u; } }

  function parseKeywords(t) {
    return t.split('\n').map(function (l) { return l.trim(); }).filter(Boolean).map(function (l) {
      var m = /^(.*?)[,\t;]\s*([\d.,]+[kK]?)\s*$/.exec(l);
      var kw = m ? m[1].trim() : l, vol = '';
      if (m) { vol = m[2]; }
      var n = parseFloat(String(vol).replace(/,/g, '')); if (/k$/i.test(vol)) n = n * 1000;
      return { kw: kw, vol: vol, n: isNaN(n) ? 0 : n, tok: unique(tokens(kw)) };
    }).filter(function (k) { return k.kw; });
  }
  function parseUrls(t) {
    return t.split('\n').map(function (l) { return l.trim(); }).filter(Boolean).map(function (l) {
      var p = l.split('|'), u = p[0].trim(), title = (p[1] || '').trim();
      var path = pathOf(u);
      return { url: u, title: title, tok: unique(tokens(path.replace(/\.[a-z]+$/, '') + ' ' + title)) };
    });
  }

  function run() {
    var kws = parseKeywords($('km-kw').value), urls = parseUrls($('km-urls').value);
    var out = $('km-output'), status = $('km-status');
    rowsOut = []; text = '';
    if (!kws.length) { out.textContent = 'Paste keywords and page URLs to build the map.'; status.textContent = 'Waiting for input'; return; }
    var groups = {};
    kws.forEach(function (k) { var key = k.tok.slice().sort().join(' '); (groups[key] = groups[key] || []).push(k); });
    var used = {};
    var mapped = 0, review = 0, need = 0;
    var results = kws.map(function (k) {
      var best = null, bs = 0;
      urls.forEach(function (u) {
        if (!k.tok.length) return;
        var hit = k.tok.filter(function (t) { return u.tok.indexOf(t) !== -1; }).length;
        var s = hit / k.tok.length;
        if (s > bs || (s === bs && best && pathOf(u.url).length < pathOf(best.url).length)) { bs = s; best = u; }
      });
      var st, url = '';
      if (best && bs >= 0.67) { st = 'Mapped'; url = best.url; mapped++; used[best.url] = true; }
      else if (best && bs >= 0.34) { st = 'Review'; url = best.url; review++; used[best.url] = true; }
      else { st = 'Needs new page'; need++; }
      var dups = groups[k.tok.slice().sort().join(' ')];
      return { kw: k.kw, vol: k.vol, n: k.n, url: url, score: Math.round(bs * 100), st: st, grp: dups.length > 1 ? dups.map(function (d) { return d.kw; }).filter(function (x) { return x !== k.kw; }).join('; ') : '', slug: st === 'Needs new page' ? '/' + slugOf(k.kw) : '' };
    });
    results.sort(function (a, b) { return b.n - a.n; });
    rowsOut = results;
    var lines = ['SUMMARY: ' + kws.length + ' keywords · ' + mapped + ' mapped · ' + review + ' to review · ' + need + ' need a new page', ''];
    results.forEach(function (r) {
      var l = r.kw + (r.vol ? ' (' + r.vol + ')' : '') + '\n    → ' + (r.url ? pathOf(r.url) + '  [' + r.st + ', ' + r.score + '% word match]' : 'NEEDS A NEW PAGE, suggested ' + r.slug);
      if (r.grp) l += '\n    ! Same words as: ' + r.grp + ', target with one page';
      lines.push(l);
    });
    var orphans = urls.filter(function (u) { return !used[u.url]; });
    if (orphans.length) { lines.push(''); lines.push('PAGES WITH NO MATCHING KEYWORD (' + orphans.length + ')'); orphans.slice(0, 20).forEach(function (u) { lines.push('  - ' + pathOf(u.url)); }); }
    if (!urls.length) { lines.push(''); lines.push('Add your page URLs to see which keywords already have a page.'); }
    text = lines.join('\n');
    out.textContent = text;
    status.textContent = need + ' need a page' + (review ? ' · ' + review + ' to review' : '');
  }

  ['km-kw', 'km-urls'].forEach(function (id) { $(id).addEventListener('input', run); });
  $('km-copy').addEventListener('click', function () {
    if (!text) return;
    var b = $('km-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
  });
  $('km-csv').addEventListener('click', function () {
    if (!rowsOut.length) return;
    var lines = ['keyword,volume,status,mapped_url,word_match_percent,suggested_slug,same_words_as'];
    rowsOut.forEach(function (r) { lines.push([r.kw, r.vol, r.st, r.url, r.score, r.slug, r.grp].map(csv).join(',')); });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/csv' }));
    a.download = 'keyword-map.csv';
    document.body.appendChild(a); a.click(); a.remove();
  });
  run();
})();
</script>
