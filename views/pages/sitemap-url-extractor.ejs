<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Does this tool fetch my sitemap from a URL?', acceptedAnswer: { '@type': 'Answer', text: 'No. Paste the contents. Browsers block most cross-site requests to other sites files, and pasting keeps your data off every server.' } },
      { '@type': 'Question', name: 'What if my sitemap is a sitemap index?', acceptedAnswer: { '@type': 'Answer', text: 'The tool detects a sitemapindex root and lists the child sitemap locations. Each child file then needs to be pasted separately to get its page URLs.' } },
      { '@type': 'Question', name: 'Can I get the last modified dates too?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Switch the output format to CSV and each row includes the lastmod value when the sitemap provides one.' } },
      { '@type': 'Question', name: 'Does it work with compressed .xml.gz sitemaps?', acceptedAnswer: { '@type': 'Answer', text: 'Not directly. Unzip the file first and paste the XML text.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything is processed in your browser with JavaScript - nothing is uploaded, logged, or stored on any server, including ours.' } }
    ]
  }) %>
</script>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var current = { text: '', ext: 'txt' };

  function csvCell(v) { v = v || ''; return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }

  function extract(xmlText) {
    var doc = new DOMParser().parseFromString(xmlText, 'application/xml');
    var pe = doc.getElementsByTagName('parsererror')[0];
    if (pe) return { error: 'The file is not valid XML. Check for unclosed tags, a missing root element or an unescaped & character.' };
    var root = doc.documentElement;
    var name = root.localName || root.tagName;
    var itemTag = name === 'sitemapindex' ? 'sitemap' : name === 'urlset' ? 'url' : null;
    if (!itemTag) return { error: 'Root element is <' + name + '>, expected <urlset> or <sitemapindex>.' };
    var items = Array.prototype.slice.call(root.getElementsByTagNameNS('*', itemTag));
    var rows = [];
    items.forEach(function (el) {
      var loc = el.getElementsByTagNameNS('*', 'loc')[0];
      var lm = el.getElementsByTagNameNS('*', 'lastmod')[0];
      var u = loc ? loc.textContent.trim() : '';
      if (u) rows.push({ url: u, lastmod: lm ? lm.textContent.trim() : '' });
    });
    return { kind: name, rows: rows };
  }

  function run() {
    var text = $('se-input').value.trim();
    var out = $('se-output'), status = $('se-status');
    current = { text: '', ext: 'txt' };
    if (!text) { out.textContent = 'Paste a sitemap to extract its URLs.'; status.textContent = 'Waiting for input'; return; }
    var r = extract(text);
    if (r.error) { out.textContent = r.error; status.textContent = 'Error'; return; }
    var rows = r.rows, total = rows.length;
    var f = $('se-filter').value.trim();
    if (f) rows = rows.filter(function (x) { return x.url.indexOf(f) !== -1; });
    if ($('se-dedupe').checked) {
      var seen = {};
      rows = rows.filter(function (x) { if (seen[x.url]) return false; seen[x.url] = 1; return true; });
    }
    var csv = $('se-format').value === 'csv';
    var lines = csv ? ['url,lastmod'].concat(rows.map(function (x) { return csvCell(x.url) + ',' + csvCell(x.lastmod); })) : rows.map(function (x) { return x.url; });
    current = { text: lines.join('\n'), ext: csv ? 'csv' : 'txt' };
    var label = r.kind === 'sitemapindex' ? 'child sitemap' : 'URL';
    status.textContent = rows.length + ' ' + label + (rows.length === 1 ? '' : 's') + (rows.length !== total ? ' (of ' + total + ')' : '');
    var note = r.kind === 'sitemapindex' ? '# Sitemap index: these are child sitemaps, paste each one to get page URLs\n' : '';
    out.textContent = rows.length ? note + current.text : 'No URLs match.';
  }

  ['se-input', 'se-filter'].forEach(function (id) { $(id).addEventListener('input', run); });
  ['se-format', 'se-dedupe'].forEach(function (id) { $(id).addEventListener('change', run); });

  $('se-copy').addEventListener('click', function () {
    if (!current.text) return;
    var b = $('se-copy');
    var done = function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); };
    if (navigator.clipboard) navigator.clipboard.writeText(current.text).then(done);
  });
  $('se-download').addEventListener('click', function () {
    if (!current.text) return;
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([current.text], { type: 'text/plain' }));
    a.download = 'sitemap-urls.' + current.ext;
    document.body.appendChild(a); a.click(); a.remove();
  });
  run();
})();
</script>
