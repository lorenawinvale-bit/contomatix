<script>
(function () {
  function build() {
    var url = document.getElementById('utm-url').value.trim();
    var source = document.getElementById('utm-source').value.trim();
    var medium = document.getElementById('utm-medium').value.trim();
    var campaign = document.getElementById('utm-campaign').value.trim();
    var term = document.getElementById('utm-term').value.trim();
    var content = document.getElementById('utm-content').value.trim();
    var output = document.getElementById('utm-output');
    var status = document.getElementById('utm-status');

    if (!url || !source || !medium || !campaign) {
      output.textContent = 'Fill in Website URL, Source, Medium, and Campaign to generate your link.';
      status.textContent = 'Fill in the required fields';
      return;
    }

    var parsed;
    try {
      parsed = new URL(url);
    } catch (e) {
      output.textContent = 'That URL doesn\'t look valid. Include the protocol, e.g. https://example.com';
      status.textContent = 'Fix the URL';
      return;
    }

    parsed.searchParams.set('utm_source', source);
    parsed.searchParams.set('utm_medium', medium);
    parsed.searchParams.set('utm_campaign', campaign);
    if (term) parsed.searchParams.set('utm_term', term);
    if (content) parsed.searchParams.set('utm_content', content);

    output.textContent = parsed.toString();
    status.textContent = 'Updated';
  }

  document.querySelectorAll('#utm-form input').forEach(function (el) {
    el.addEventListener('input', build);
  });

  document.getElementById('utm-copy').addEventListener('click', function () {
    var text = document.getElementById('utm-output').textContent;
    if (!text || text.indexOf('Fill in') === 0 || text.indexOf("doesn't look valid") !== -1) return;
    navigator.clipboard.writeText(text).then(function () {
      var status = document.getElementById('utm-status');
      status.textContent = 'Copied!';
      setTimeout(function () { status.textContent = 'Updated'; }, 1800);
    });
  });
})();
</script>
