<script>
(function () {
  var LANGS = 'aa ab ae af ak am an ar as av ay az ba be bg bh bi bm bn bo br bs ca ce ch co cr cs cu cv cy da de dv dz ee el en eo es et eu fa ff fi fj fo fr fy ga gd gl gn gu gv ha he hi ho hr ht hu hy hz ia id ie ig ii ik io is it iu ja jv ka kg ki kj kk kl km kn ko kr ks ku kv kw ky la lb lg li ln lo lt lu lv mg mh mi mk ml mn mr ms mt my na nb nd ne ng nl nn no nr nv ny oc oj om or os pa pi pl ps pt qu rm rn ro ru rw sa sc sd se sg si sk sl sm sn so sq sr ss st su sv sw ta te tg th ti tk tl tn to tr ts tt tw ty ug uk ur uz ve vi vo wa wo xh yi yo za zh zu'.split(' ');
  var XHTML_NS = 'http://www.w3.org/1999/xhtml';

  function isAbsolute(u) { return /^https?:\/\//i.test(u); }
  function norm(u) { return (u || '').trim(); }

  function checkCode(code) {
    var c = code.trim();
    if (c.toLowerCase() === 'x-default') return null;
    var m = /^([A-Za-z]{2,3})(?:-([A-Za-z]{4}))?(?:-([A-Za-z]{2}|[0-9]{3}))?$/.exec(c);
    if (!m) return 'is not a valid language[-region] code';
    var lang = m[1].toLowerCase();
    var region = m[3];
    if (LANGS.indexOf(lang) === -1) {
      if (region === undefined && /^[A-Za-z]{2}$/.test(c)) return 'is not an ISO 639-1 language code (a country code on its own is not allowed)';
      return 'starts with "' + m[1] + '", which is not an ISO 639-1 language code';
    }
    if (region !== undefined) {
      if (/^[0-9]{3}$/.test(region)) return 'uses the numeric region "' + region + '", which is not an ISO 3166-1 Alpha 2 code, so Google does not support it';
      var r = region.toUpperCase();
      if (r === 'UK') return 'uses region UK, but the ISO 3166-1 code for the United Kingdom is GB';
      if (r === 'EU') return 'uses region EU, which is not a supported ISO 3166-1 Alpha 2 country code';
    }
    return null;
  }

  function validate(xmlText) {
    var errors = [], warnings = [], info = [];
    var doc = new DOMParser().parseFromString(xmlText, 'application/xml');
    var pe = doc.getElementsByTagName('parsererror')[0];
    if (pe) {
      errors.push('The file is not valid XML: ' + pe.textContent.split('\n')[0]);
      return { errors: errors, warnings: warnings, info: info };
    }
    var root = doc.documentElement;
    var rootName = root.localName || root.tagName;
    if (rootName !== 'urlset') {
      errors.push('Root element is <' + rootName + '>, expected <urlset>. Check each child sitemap on its own if this is an index file.');
      return { errors: errors, warnings: warnings, info: info };
    }
    var hasNs = false;
    for (var i = 0; i < root.attributes.length; i++) {
      var a = root.attributes[i];
      if (a.value === XHTML_NS) hasNs = true;
    }
    if (!hasNs) errors.push('The <urlset> element is missing xmlns:xhtml="' + XHTML_NS + '", which Google requires for hreflang annotations.');

    var urls = Array.prototype.slice.call(root.getElementsByTagNameNS('*', 'url'));
    if (!urls.length) { errors.push('No <url> entries found.'); return { errors: errors, warnings: warnings, info: info }; }

    var entries = {};
    var order = [];
    var withLinks = 0;
    urls.forEach(function (u, idx) {
      var locEl = u.getElementsByTagNameNS('*', 'loc')[0];
      var loc = locEl ? norm(locEl.textContent) : '';
      if (!loc) { errors.push('<url> #' + (idx + 1) + ' has no <loc>.'); return; }
      if (!isAbsolute(loc)) errors.push('<loc> is not an absolute URL: ' + loc);
      var links = Array.prototype.slice.call(u.getElementsByTagNameNS(XHTML_NS, 'link'));
      var alts = [];
      var seenCodes = {};
      links.forEach(function (l) {
        if ((l.getAttribute('rel') || '').toLowerCase() !== 'alternate') return;
        var code = l.getAttribute('hreflang');
        var href = norm(l.getAttribute('href'));
        if (!code) { errors.push(loc + ': an xhtml:link has no hreflang attribute.'); return; }
        if (!href) { errors.push(loc + ': hreflang "' + code + '" has no href.'); return; }
        if (!isAbsolute(href)) errors.push(loc + ': hreflang "' + code + '" href is not an absolute URL (' + href + ').');
        var bad = checkCode(code);
        if (bad) errors.push(loc + ': hreflang "' + code + '" ' + bad + '.');
        var key = code.toLowerCase();
        if (seenCodes[key] && seenCodes[key] !== href) errors.push(loc + ': hreflang "' + code + '" points to two different URLs.');
        else if (seenCodes[key]) warnings.push(loc + ': hreflang "' + code + '" is listed more than once.');
        seenCodes[key] = href;
        alts.push({ code: code, href: href });
      });
      if (alts.length) withLinks++;
      entries[loc] = alts;
      order.push(loc);
    });

    if (!withLinks) {
      warnings.push('No xhtml:link hreflang annotations found in any <url>.');
      return { errors: errors, warnings: warnings, info: info };
    }

    order.forEach(function (loc) {
      var alts = entries[loc];
      if (!alts.length) { warnings.push(loc + ': has no hreflang annotations, but other entries do.'); return; }
      var selfListed = alts.some(function (a) { return a.href === loc; });
      if (!selfListed) errors.push(loc + ': does not list itself as one of its alternates.');
      var hasDefault = alts.some(function (a) { return a.code.toLowerCase() === 'x-default'; });
      if (!hasDefault) info.push(loc + ': no x-default (optional).');
      alts.forEach(function (a) {
        if (a.href === loc) return;
        if (!entries.hasOwnProperty(a.href)) {
          warnings.push(loc + ': alternate ' + a.href + ' (' + a.code + ') has no <url> entry of its own, so it cannot link back.');
          return;
        }
        var back = entries[a.href].some(function (b) { return b.href === loc; });
        if (!back) errors.push('Missing return link: ' + loc + ' points to ' + a.href + ' (' + a.code + '), but that page does not point back, so Google ignores the pair.');
      });
    });

    info.unshift('Checked ' + order.length + ' URL(s), ' + withLinks + ' with hreflang annotations.');
    return { errors: errors, warnings: warnings, info: info.slice(0, 12) };
  }

  function render(r) {
    var out = document.getElementById('hv-output');
    var status = document.getElementById('hv-status');
    var lines = [];
    var cap = function (arr) { return arr.length > 40 ? arr.slice(0, 40).concat(['…and ' + (arr.length - 40) + ' more']) : arr; };
    status.textContent = r.errors.length ? r.errors.length + ' error(s) found' : 'No errors found';
    if (r.errors.length) { lines.push('ERRORS'); cap(r.errors).forEach(function (e) { lines.push('  ✗ ' + e); }); }
    if (r.warnings.length) { lines.push(''); lines.push('WARNINGS'); cap(r.warnings).forEach(function (w) { lines.push('  ! ' + w); }); }
    if (r.info.length) { lines.push(''); lines.push('INFO'); r.info.forEach(function (i) { lines.push('  · ' + i); }); }
    out.textContent = lines.join('\n');
  }

  function run() {
    var text = document.getElementById('hv-input').value.trim();
    if (!text) {
      document.getElementById('hv-output').textContent = 'Paste a sitemap to check it.';
      document.getElementById('hv-status').textContent = 'Waiting for input';
      return;
    }
    render(validate(text));
  }

  document.getElementById('hv-input').addEventListener('input', run);
  run();
})();
</script>
