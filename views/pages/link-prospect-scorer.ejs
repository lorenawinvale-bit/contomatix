    provider: { '@id': site.baseUrl + '/#organization' }
  }) %>
</script>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.baseUrl },
      { '@type': 'ListItem', position: 2, name: 'Free Tools', item: site.baseUrl + '/tools' },
      { '@type': 'ListItem', position: 3, name: 'Link Prospect Scorer', item: site.baseUrl + '/tools/link-prospect-scorer' }
    ]
  }) %>
</script>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is link prospecting?', acceptedAnswer: { '@type': 'Answer', text: 'It is finding and checking sites that could link to you, before you reach out. The aim is a short list of relevant, live pages instead of a long list of anything.' } },
      { '@type': 'Question', name: 'Is the score a Google metric?', acceptedAnswer: { '@type': 'Answer', text: 'No. It is our own checklist turned into points so prospects can be compared. Google does not publish a prospect score.' } },
      { '@type': 'Question', name: 'Does the tool visit the site or check its authority?', acceptedAnswer: { '@type': 'Answer', text: 'No. It uses only your answers. Authority scores come from third-party tools and are not part of the score.' } },
      { '@type': 'Question', name: 'Why is a site that sells links an automatic skip?', acceptedAnswer: { '@type': 'Answer', text: 'Google spam policy lists buying or selling links for ranking purposes and excessive link exchanges as link spam, so a link from such a site carries risk whatever the rest of the score says.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything is calculated in your browser with JavaScript - nothing is uploaded, logged, or stored on any server, including ours.' } }
    ]
  }) %>
</script>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var current = '';
  var TYPE = { article: [15, 'Inside article text'], resource: [12, 'Curated resource list'], author: [8, 'Author bio or byline'], directory: [5, 'Directory or listing'], profile: [2, 'Profile or comment page'], footer: [0, 'Footer, sidebar or sitewide block'] };

  function run() {
    var rel = +$('lp-rel').value, readers = +$('lp-readers').value, fresh = +$('lp-fresh').value, out = +$('lp-out').value, idx = +$('lp-indexed').value;
    var type = $('lp-type').value, attr = $('lp-attr').value, contact = +$('lp-contact').value, sells = $('lp-sells').value === 'yes';
    var pts = { Relevance: rel * 10, Audience: Math.round(readers / 3 * 20), Freshness: fresh * 5, 'Few other links': out * 5, Indexed: idx * 5, Placement: TYPE[type][0], 'Named contact': contact * 5 };
    var total = 0; Object.keys(pts).forEach(function (k) { total += pts[k]; });
    var max = { Relevance: 30, Audience: 20, Freshness: 10, 'Few other links': 10, Indexed: 10, Placement: 15, 'Named contact': 5 };
    var flags = [];
    if (sells) flags.push('The site advertises paid links, paid guest posts or link swaps. Google lists buying or selling links for ranking purposes and excessive link exchanges as link spam.');
    if (rel === 0) flags.push('The page is unrelated to your topic. Relevance is the first thing an editor checks.');
    if (type === 'footer') flags.push('Footer, sidebar and sitewide links are the weakest placement and are named in Google\'s link spam examples when widely distributed.');
    if (idx === 0) flags.push('The page is not indexed, so Google may never see the link.');
    if (attr === 'nofollow') flags.push('The link would be qualified (nofollow, sponsored or ugc). It can still send visitors, but do not count on it passing credit.');
    var verdict = sells || rel === 0 || type === 'footer' || idx === 0 ? 'SKIP' : total >= 70 ? 'PURSUE' : total >= 45 ? 'HOLD' : 'SKIP';
    var site = $('lp-site').value.trim();
    var L = [];
    L.push('LINK PROSPECT SCORE' + (site ? ': ' + site : ''));
    L.push('');
    L.push('SCORE: ' + total + ' / 100');
    L.push('VERDICT: ' + verdict + (verdict === 'PURSUE' ? ' (a relevant, live page where an editorial link is plausible)' : verdict === 'HOLD' ? ' (look again at relevance and readers, or find a better page on the same site)' : ' (unlikely to pay back, or too close to link spam)'));
    L.push('');
    L.push('BREAKDOWN');
    Object.keys(pts).forEach(function (k) { L.push(k + ': ' + pts[k] + ' / ' + max[k]); });
    L.push('Placement chosen: ' + TYPE[type][1]);
    if (flags.length) { L.push(''); L.push('FLAGS'); flags.forEach(function (f) { L.push('- ' + f); }); }
    L.push('');
    L.push('NEXT STEP');
    L.push(verdict === 'PURSUE' ? 'Check the link attribute, confirm the page is indexed, then write a short email that names something specific on the page.' : verdict === 'HOLD' ? 'Re-check relevance and audience, and look for a stronger page on the same site before you spend time on outreach.' : 'Move on to a better prospect.');
    L.push('');
    L.push('This score is a working method from Contomatix, not a Google metric.');
    current = L.join('\n');
    $('lp-output').textContent = current;
    $('lp-status').textContent = verdict + ' (' + total + ')';
  }

  Array.prototype.slice.call($('lp-form').querySelectorAll('input,select')).forEach(function (e) { e.addEventListener('input', run); e.addEventListener('change', run); });
  $('lp-copy').addEventListener('click', function () {
    if (!current) return; var b = $('lp-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(current).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
  });
  $('lp-download').addEventListener('click', function () {
    if (!current) return;
    var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([current], { type: 'text/plain' })); a.download = 'link-prospect-score.txt';
    document.body.appendChild(a); a.click(); a.remove();
  });
  run();
})();
</script>
