<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var canvas = document.createElement('canvas'); var ctx = canvas.getContext('2d');
  function width(text, font) { if (!ctx) return Math.round(text.length * 6.6); ctx.font = font; return Math.round(ctx.measureText(text).width); }
  function descWidth(t) { return width(t, '14px Arial, Helvetica, sans-serif'); }
  function titleWidth(t) { return width(t, '20px Arial, Helvetica, sans-serif'); }
  function status(len) {
    if (!len) return { k: 'warn', t: 'Empty', cls: 'mdc-warn' };
    if (len < 120) return { k: 'warn', t: 'Short: room to add a benefit', cls: 'mdc-warn' };
    if (len <= 155) return { k: 'ok', t: 'In range', cls: 'mdc-good' };
    if (len <= 160) return { k: 'warn', t: 'Borderline: may be cut', cls: 'mdc-warn' };
    return { k: 'bad', t: 'Too long: likely cut', cls: 'mdc-bad' };
  }
  function clip(text, max) {
    if (text.length <= max) return text;
    var cut = text.slice(0, max); var i = cut.lastIndexOf(' ');
    return (i > max * 0.6 ? cut.slice(0, i) : cut).replace(/[\s,;:.\-]+$/, '') + ' ...';
  }
  var mode = 'd';
  function stat(big, label, cls) { var d = document.createElement('div'); d.className = 'mdc-stat'; var b = document.createElement('b'); b.textContent = big; if (cls) b.className = cls; var s = document.createElement('span'); s.textContent = label; d.appendChild(b); d.appendChild(s); return d; }
  function check(list, kind, text) { var li = document.createElement('li'); li.className = kind; li.textContent = text; list.appendChild(li); }
  function words(s) { return (s.toLowerCase().match(/[a-z0-9']+/g) || []); }

  function run() {
    var title = $('mdc-title').value.trim(), desc = $('mdc-desc').value, url = $('mdc-url').value.trim(), kw = $('mdc-kw').value.trim().toLowerCase();
    var d = desc.replace(/\s+/g, ' ').trim(); var len = d.length; var st = status(len); var w = d ? descWidth(d) : 0;
    var stats = $('mdc-stats'); stats.textContent = '';
    stats.appendChild(stat(String(len), 'characters (with spaces)', st.cls));
    stats.appendChild(stat(String(d ? d.split(' ').length : 0), 'words'));
    stats.appendChild(stat(w + ' px', 'estimated width (14px Arial)', w > 920 ? 'mdc-bad' : (w > 0 ? 'mdc-good' : '')));
    stats.appendChild(stat(String(title.length), 'title characters', title.length > 60 ? 'mdc-warn' : ''));
    $('mdc-status').textContent = st.t;
    var list = $('mdc-checks'); list.textContent = '';
    if (!d) { check(list, 'warn', 'Paste a meta description to check it.'); }
    else {
      check(list, st.k, 'Length: ' + len + ' characters. ' + st.t + '.');
      check(list, w > 920 ? 'warn' : 'ok', 'Estimated width: ' + w + ' px. ' + (w > 920 ? 'Over about 920 px, a commonly quoted desktop limit, so the end may be cut.' : 'Under about 920 px, a commonly quoted desktop limit.'));
      if (len > 120) check(list, 'ok', 'Tip: on mobile the visible text may be shorter, so put the main point in the first 120 characters.');
      if (/[\r\n\t]/.test(desc)) check(list, 'warn', 'The text contains line breaks or tabs. Use a single line.');
      if (/<[^>]+>/.test(desc)) check(list, 'bad', 'The text contains HTML tags. Remove them.');
      if (/ {2,}/.test(desc)) check(list, 'warn', 'The text contains double spaces.');
      if (title && d.toLowerCase().indexOf(title.toLowerCase()) === 0) check(list, 'warn', 'The description starts by repeating the title. Say something new.');
      var counts = {}; words(d).forEach(function (x) { if (x.length > 3) counts[x] = (counts[x] || 0) + 1; });
      var rep = Object.keys(counts).filter(function (x) { return counts[x] >= 4; });
      if (rep.length) check(list, 'warn', 'The word "' + rep[0] + '" appears ' + counts[rep[0]] + ' times. Repeating a word can read as stuffing.');
      if (kw) {
        var dl = d.toLowerCase(); var pos = dl.indexOf(kw);
        if (pos === -1) check(list, 'warn', 'The target keyword "' + kw + '" is not in the description.');
        else check(list, pos < 120 ? 'ok' : 'warn', 'The target keyword is in the description' + (pos < 120 ? ', within the first 120 characters.' : ', but after the first 120 characters.'));
        if (title) check(list, title.toLowerCase().indexOf(kw) === -1 ? 'warn' : 'ok', title.toLowerCase().indexOf(kw) === -1 ? 'The target keyword is not in the title.' : 'The target keyword is in the title.');
      }
    }
    if (title) check(list, title.length > 60 ? 'warn' : (title.length < 30 ? 'warn' : 'ok'), 'Title: ' + title.length + ' characters, about ' + titleWidth(title) + ' px. ' + (title.length > 60 ? 'Over 60 characters, so it may be cut.' : (title.length < 30 ? 'Short: room for more.' : 'Within a safe length.')));
    // preview
    var serp = $('mdc-serp'); serp.textContent = ''; serp.className = 'mdc-serp' + (mode === 'm' ? ' mobile' : '');
    var host = url ? url.replace(/^https?:\/\//, '').replace(/\/$/, '').replace(/\//g, ' > ') : 'example.com > page';
    var u = document.createElement('div'); u.className = 'u'; u.textContent = host; var t = document.createElement('div'); t.className = 't'; t.textContent = title ? clip(title, mode === 'm' ? 55 : 60) : 'Your page title';
    var dd = document.createElement('div'); dd.className = 'd'; dd.textContent = d ? clip(d, mode === 'm' ? 120 : 155) : 'Your meta description will appear here.';
    serp.appendChild(u); serp.appendChild(t); serp.appendChild(dd);
  }

  function bulk() {
    var lines = $('mdc-bulk-in').value.split('\n').map(function (l) { return l.trim(); }).filter(Boolean);
    var tb = $('mdc-bulk-table').querySelector('tbody'); tb.textContent = '';
    var sum = $('mdc-bulk-sum'); var csv = $('mdc-bulk-csv');
    if (!lines.length) { $('mdc-bulk-table').style.display = 'none'; csv.style.display = 'none'; sum.textContent = ''; return; }
    var seen = {}; var rows = lines.map(function (l, i) {
      var parts = l.indexOf('|') !== -1 ? l.split('|') : [null, l]; var desc = (parts.length > 1 ? parts.slice(1).join('|') : parts[0]).trim();
      var key = desc.toLowerCase(); seen[key] = (seen[key] || 0) + 1; return { n: i + 1, text: desc, len: desc.length, w: descWidth(desc), key: key };
    });
    var counts = { ok: 0, long: 0, short: 0, dup: 0 };
    rows.forEach(function (r) {
      var s = status(r.len); var dup = seen[r.key] > 1; if (dup) counts.dup++; if (s.k === 'ok') counts.ok++; else if (r.len > 155) counts.long++; else counts.short++;
      r.status = s.t + (dup ? ' (duplicate)' : '');
      var tr = document.createElement('tr');
      [String(r.n), r.text, String(r.len), r.w + ' px', r.status].forEach(function (v, i) { var td = document.createElement('td'); td.textContent = v; if (i === 1) td.className = 'txt'; if (i === 4) td.className = s.cls; tr.appendChild(td); });
      tb.appendChild(tr);
    });
    $('mdc-bulk-table').style.display = ''; csv.style.display = '';
    sum.textContent = rows.length + ' checked: ' + counts.ok + ' in range, ' + counts.long + ' too long, ' + counts.short + ' short, ' + counts.dup + ' duplicates.';
    csv.onclick = function () {
      var out = '"#","Text","Characters","Est. width px","Status"\n' + rows.map(function (r) { return [r.n, '"' + r.text.replace(/"/g, '""') + '"', r.len, r.w, '"' + r.status + '"'].join(','); }).join('\n');
      var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([out], { type: 'text/csv' })); a.download = 'meta-description-check.csv'; a.click();
    };
  }

  ['mdc-title', 'mdc-desc', 'mdc-url', 'mdc-kw'].forEach(function (id) { $(id).addEventListener('input', run); });
  $('mdc-bulk-in').addEventListener('input', bulk);
  $('mdc-tab-d').addEventListener('click', function () { mode = 'd'; $('mdc-tab-d').className = 'btn btn-primary btn-sm'; $('mdc-tab-m').className = 'btn btn-outline btn-sm'; run(); });
  $('mdc-tab-m').addEventListener('click', function () { mode = 'm'; $('mdc-tab-m').className = 'btn btn-primary btn-sm'; $('mdc-tab-d').className = 'btn btn-outline btn-sm'; run(); });
  run();
})();
</script>
