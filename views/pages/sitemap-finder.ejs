<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var copyText = '';
  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function origin(v) {
    v = v.trim(); if (!v) return null;
    if (!/^https?:\/\//i.test(v)) v = 'https://' + v;
    try { var u = new URL(v); if (!u.hostname || u.hostname.indexOf('.') === -1) return null; return { origin: u.origin, host: u.hostname.replace(/^www\./, ''), proto: u.protocol }; } catch (e) { return null; }
  }
  function link(url, label) { return '<a href="' + esc(url) + '" target="_blank" rel="noopener noreferrer">' + esc(label || url) + '</a>'; }

  function run() {
    var o = origin($('sf-domain').value);
    if (!o) { $('sf-output').textContent = 'Enter a domain to start.'; $('sf-status').textContent = 'Waiting for input'; copyText = ''; return; }
    var paths = ['/robots.txt', '/sitemap.xml', '/sitemap_index.xml', '/wp-sitemap.xml', '/sitemap-index.xml'];
    var h = [], txt = [];
    h.push('<strong>1. Open the robots.txt</strong>');
    h.push('<div>' + link(o.origin + '/robots.txt') + '</div>');
    txt.push(o.origin + '/robots.txt');
    h.push('<br><strong>2. Try the common sitemap paths</strong>');
    paths.slice(1).forEach(function (p) { h.push('<div>' + link(o.origin + p) + '</div>'); txt.push(o.origin + p); });
    h.push('<br><strong>3. Search Google for it</strong>');
    var q1 = 'site:' + o.host + ' inurl:sitemap', q2 = 'site:' + o.host + ' filetype:xml';
    h.push('<div>' + link('https://www.google.com/search?q=' + encodeURIComponent(q1), q1) + '</div>');
    h.push('<div>' + link('https://www.google.com/search?q=' + encodeURIComponent(q2), q2) + '</div>');
    txt.push(q1, q2);

    var robots = $('sf-robots').value;
    if (robots.trim()) {
      var lines = [], m, re = /^\s*sitemap:\s*(\S+)/gim;
      while ((m = re.exec(robots))) lines.push(m[1]);
      h.push('<br><strong>4. Sitemap lines in the pasted robots.txt</strong>');
      if (!lines.length) h.push('<div>&#9888; No <code>Sitemap:</code> line found. The site may not declare its sitemap here, so try the paths above.</div>');
      var seen = {};
      lines.forEach(function (u) {
        var notes = [];
        if (!/^https?:\/\//i.test(u)) notes.push('not an absolute URL, so it is not valid');
        else {
          try { var x = new URL(u); if (x.hostname.replace(/^www\./, '') !== o.host) notes.push('different domain from the one you entered'); if (x.protocol !== o.proto) notes.push('uses ' + x.protocol.replace(':', '') + ' while the site address uses ' + o.proto.replace(':', '')); } catch (e) { notes.push('not a valid URL'); }
        }
        if (seen[u]) notes.push('listed more than once'); seen[u] = 1;
        h.push('<div>' + (notes.length ? '&#9888; ' : '&#10003; ') + (/^https?:\/\//i.test(u) ? link(u) : esc(u)) + (notes.length ? ' <em>(' + esc(notes.join('; ')) + ')</em>' : '') + '</div>');
        txt.push(u);
      });
      if (lines.length) h.push('<div style="margin-top:6px;">' + lines.length + ' Sitemap line' + (lines.length === 1 ? '' : 's') + ' found. Open each to confirm it returns valid XML.</div>');
    }
    $('sf-output').innerHTML = h.join('\n');
    $('sf-status').textContent = 'Ready: open the links';
    copyText = txt.join('\n');
  }

  Array.prototype.slice.call($('sf-form').querySelectorAll('input,textarea')).forEach(function (e) { e.addEventListener('input', run); e.addEventListener('change', run); });
  $('sf-copy').addEventListener('click', function () {
    if (!copyText) return; var b = $('sf-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(copyText).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy the list'; }, 1500); });
  });
  run();
})();
</script>
