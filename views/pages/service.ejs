<%
var counts = locals.counts || { posts: 0, tools: 0 };
var allFaqs = (service.faqs || []).concat(service.moreFaqs || []);
%>
<section class="sv-hero">
  <span class="sv-aurora sv-aurora-1" aria-hidden="true"></span>
  <span class="sv-aurora sv-aurora-2" aria-hidden="true"></span>
  <div class="container sv-hero-grid">
    <div class="sv-hero-copy">
      <span class="sv-eyebrow"><%= service.title %> service</span>
      <h1><%= service.heroTitle || (service.title + ' Services') %></h1>
      <p class="sv-lead"><%= service.heroLead || service.summary %></p>
      <div class="sv-actions">
        <a href="/contact" class="btn btn-primary">Get a free audit &rarr;</a>
        <a href="https://wa.me/<%= site.whatsappNumber %>" target="_blank" rel="noopener" class="btn btn-outline">WhatsApp us</a>
      </div>
      <ul class="sv-chips" aria-label="How we work">
        <li>Free audit first</li><li>You own your accounts</li><li>Short notice periods</li><li>Reporting tied to outcomes</li>
      </ul>
    </div>
    <div class="sv-hero-card">
      <% if (service.widget === 'link-vet') { %>
        <%- include('../partials/vet-widget', { widgetId: 'vet-service' }) %>
      <% } else if (service.widget === 'check' && service.checker) { %>
        <%- include('../partials/check-widget', { widgetId: 'chk-service', checker: service.checker }) %>
      <% } else { %>
        <div class="sv-snapshot">
          <span class="sv-vet-kicker">At a glance</span>
          <dl>
            <% (service.facts || []).slice(0, 4).forEach(function(f) { %>
              <dt><%= f[0] %></dt><dd><%= f[1] %></dd>
            <% }); %>
          </dl>
        </div>
      <% } %>
    </div>
  </div>
  <div class="container">
    <div class="sv-stats">
      <div><b data-count="<%= counts.posts %>">0</b><span>guides we published</span></div>
      <div><b data-count="<%= counts.tools %>">0</b><span>free SEO tools</span></div>
      <div><b data-count="<%= services.length %>">0</b><span>core services</span></div>
      <div><b>0</b><span>PBNs, link farms or link blasts</span></div>
    </div>
  </div>
</section>

<main class="sv-main">
  <div class="container sv-wrap">

    <% if (service.answer) { %>
      <div class="sv-answer sv-r">
        <span><%= service.title %> in short</span>
        <p><%= service.answer %></p>
      </div>
    <% } %>

    <% if (service.problems && service.problems.length) { %>
      <section class="sv-block sv-r">
        <span class="sv-kicker">Why teams come to us</span>
        <h2><%= service.problemsTitle || 'Problems we fix' %></h2>
        <div class="sv-bento sv-bento-4">
          <% service.problems.forEach(function(p, i) { %>
            <article class="sv-card sv-card-num">
              <i><%= i + 1 %></i>
              <h3><%= p.h %></h3>
              <p><%= p.t %></p>
            </article>
          <% }); %>
        </div>
      </section>
    <% } %>

    <section class="sv-block sv-r">
      <span class="sv-kicker">The details</span>
      <h2>What our <%= service.title.toLowerCase() %> service is</h2>
      <p class="sv-prose"><%= service.description %></p>
      <% if (service.facts && service.facts.length) { %>
        <div class="sv-facts">
          <% service.facts.forEach(function(f) { %>
            <div><strong><%= f[0] %></strong><span><%= f[1] %></span></div>
          <% }); %>
        </div>
      <% } %>
    </section>

    <% if (service.process && service.process.length) { %>
      <section class="sv-block sv-r">
        <span class="sv-kicker">The process</span>
        <h2>How a <%= service.title.toLowerCase() %> campaign runs</h2>
        <ol class="sv-steps">
          <% service.process.forEach(function(step, i) { %>
            <li>
              <span class="sv-step-num"><%= i + 1 %></span>
              <h3><%= step.title %></h3>
              <p><%= step.text %></p>
            </li>
          <% }); %>
        </ol>
      </section>
    <% } %>

    <section class="sv-block sv-r">
      <span class="sv-kicker">What you get</span>
      <h2>What is included in our <%= service.title.toLowerCase() %> service</h2>
      <ul class="sv-included">
        <% service.points.forEach(function(pt) { %>
          <li><%= pt %></li>
        <% }); %>
      </ul>
    </section>

    <% if (service.offers && service.offers.length) { %>
      <section class="sv-block sv-r">
        <span class="sv-kicker">Services</span>
        <h2><%= service.offersTitle || 'Services we offer' %></h2>
        <div class="sv-bento sv-bento-4">
          <% service.offers.forEach(function(o) { %>
            <article class="sv-card"><h3><%= o.h %></h3><p><%= o.t %></p></article>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (service.proof && service.proof.length) { %>
      <section class="sv-proof sv-r">
        <span class="sv-kicker sv-kicker-light">Receipts, not promises</span>
        <h2>What our own research found</h2>
        <p class="sv-proof-lead">We run the checks on ourselves and publish the results, including the parts that do not flatter us.</p>
        <div class="sv-bento sv-bento-4">
          <% service.proof.forEach(function(p) { %>
            <a class="sv-proof-card" href="<%= p.href %>">
              <b><%= p.big %></b>
              <span><%= p.text %></span>
              <em>Read the data &rarr;</em>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (service.engagement && service.engagement.length) { %>
      <section class="sv-block sv-r">
        <span class="sv-kicker">Working together</span>
        <h2><%= service.engagementTitle || 'How engagements and pricing work' %></h2>
        <div class="sv-bento sv-bento-3">
          <% service.engagement.forEach(function(par, i) { %>
            <article class="sv-card sv-card-num"><i><%= i + 1 %></i><p><%= par %></p></article>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (service.types && service.types.length) { %>
      <section class="sv-block sv-r">
        <span class="sv-kicker">Coverage</span>
        <h2><%= service.typesHeading || 'Types we cover' %></h2>
        <div class="sv-bento sv-bento-4">
          <% service.types.forEach(function(t) { %>
            <article class="sv-card"><h3><%= t.title %></h3><p><%= t.text %></p></article>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (service.sections && service.sections.length) { %>
      <% service.sections.forEach(function(sec) { %>
        <section class="sv-block sv-read sv-r">
          <h2><%= sec.h %></h2>
          <% sec.p.forEach(function(par) { %><p><%= par %></p><% }); %>
        </section>
      <% }); %>
    <% } %>

    <% if (allFaqs.length) { %>
      <section class="sv-block sv-r">
        <span class="sv-kicker">Questions</span>
        <h2><%= service.title %> FAQs</h2>
        <div class="faq-list" style="margin-top: 22px;">
          <% allFaqs.forEach(function(f) { %>
            <details>
              <summary><%= f.q %><span class="faq-icon"></span></summary>
              <p><%= f.a %></p>
            </details>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (service.related && service.related.length) { %>
      <section class="sv-block sv-r">
        <span class="sv-kicker">Keep reading</span>
        <h2>Related guides and tools</h2>
        <div class="sv-related">
          <% service.related.forEach(function(r) { %><a href="<%= r[1] %>"><%= r[0] %> <span>&rarr;</span></a><% }); %>
        </div>
      </section>
    <% } %>

    <div class="cta-band sv-final sv-r">
      <span class="cta-orb cta-orb-1"></span>
      <span class="cta-orb cta-orb-2"></span>
      <h2>See where you stand before you pay</h2>
      <p>Tell us about your site. We will run the free audit and show you what is worth doing for <%= service.title.toLowerCase() %>.</p>
      <div class="sv-actions" style="justify-content:center;">
        <a href="/contact" class="btn btn-primary">Get a free audit &rarr;</a>
        <a href="https://wa.me/<%= site.whatsappNumber %>" target="_blank" rel="noopener" class="btn btn-glass">Chat on WhatsApp</a>
      </div>
    </div>
  </div>
</main>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    description: service.answer ? service.answer + ' ' + service.description : service.description,
    serviceType: service.title,
    areaServed: 'Worldwide',
    audience: { '@type': 'Audience', audienceType: 'Website owners, in-house marketing teams and SEO agencies' },
    provider: { '@id': site.baseUrl + '/#organization' },
    url: site.baseUrl + '/services/' + service.slug
  }) %>
</script>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.baseUrl },
      { '@type': 'ListItem', position: 2, name: service.title, item: site.baseUrl + '/services/' + service.slug }
    ]
  }) %>
</script>

<% if (allFaqs && allFaqs.length) { %>
<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: allFaqs.map(function(f) {
      return {
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      };
    })
  }) %>
</script>
<% } %>
