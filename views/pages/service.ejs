<section class="page-hero">
  <div id="ambient-canvas" class="ambient-canvas"></div>
  <div class="container page-hero-inner">
    <span class="eyebrow">Service</span>
    <div class="service-hero-row">
      <div class="service-icon service-icon-lg">
        <%- include('../partials/icons', { icon: service.icon }) %>
      </div>
      <h1><%= service.title %> Services</h1>
    </div>
    <p><%= service.summary %></p>
    <div class="hero-actions" style="margin-top: 22px;">
      <a href="/contact" class="btn btn-primary">Get a free audit &rarr;</a>
      <a href="https://wa.me/<%= site.whatsappNumber %>" target="_blank" rel="noopener" class="btn btn-outline">WhatsApp us</a>
    </div>
  </div>
</section>

<section>
  <div class="container service-single">
    <div>
      <% if (service.answer) { %>
        <p class="service-answer" style="border-left:4px solid var(--teal, #0EA5A0);padding:12px 16px;background:rgba(14,165,160,.07);border-radius:6px;font-size:1.05rem;margin-bottom:22px;"><strong><%= service.title %> in short:</strong> <%= service.answer %></p>
      <% } %>
      <h2>Overview</h2>
      <p style="color: var(--text-dim);"><%= service.description %></p>
      <% if (service.facts && service.facts.length) { %>
        <h2 style="margin-top: 1.8em;"><%= service.title %> at a glance</h2>
        <dl class="service-facts" style="display:grid;grid-template-columns:minmax(120px,200px) 1fr;gap:10px 18px;margin:12px 0 0;">
          <% service.facts.forEach(function(f) { %>
            <dt style="font-weight:700;"><%= f[0] %></dt>
            <dd style="margin:0;color:var(--text-dim);"><%= f[1] %></dd>
          <% }); %>
        </dl>
      <% } %>

      <%- include('../partials/video-panel', { videoTitle: service.title + ' — how it works', demoImage: '/images/demo/' + service.slug + '.svg' }) %>

      <h2>What's included</h2>
      <ul class="service-points">
        <% service.points.forEach(function(pt) { %>
          <li><%= pt %></li>
        <% }); %>
      </ul>

      <% if (service.process && service.process.length) { %>
        <h2 style="margin-top: 1.8em;">How It Works</h2>
        <ol class="service-process">
          <% service.process.forEach(function(step, i) { %>
            <li>
              <span class="service-process-num"><%= i + 1 %></span>
              <div>
                <strong><%= step.title %></strong>
                <p style="color: var(--text-dim); margin-top: 4px;"><%= step.text %></p>
              </div>
            </li>
          <% }); %>
        </ol>
      <% } %>

      <% if (service.types && service.types.length) { %>
        <h2 style="margin-top: 1.8em;"><%= service.typesHeading || 'Types We Cover' %></h2>
        <div class="service-types-grid">
          <% service.types.forEach(function(t) { %>
            <div class="service-type-card">
              <strong><%= t.title %></strong>
              <p style="color: var(--text-dim); margin-top: 4px;"><%= t.text %></p>
            </div>
          <% }); %>
        </div>
      <% } %>

      <% if (service.sections && service.sections.length) { %>
        <% service.sections.forEach(function(sec) { %>
          <h2 style="margin-top: 1.8em;"><%= sec.h %></h2>
          <% sec.p.forEach(function(par) { %>
            <p style="color: var(--text-dim);"><%= par %></p>
          <% }); %>
        <% }); %>
      <% } %>

      <% var allFaqs = (service.faqs || []).concat(service.moreFaqs || []); %>
      <% if (allFaqs.length) { %>
        <h2 style="margin-top: 1.8em;"><%= service.title %> FAQs</h2>
        <div class="faq-list" style="margin-top: 22px;">
          <% allFaqs.forEach(function(f) { %>
            <details>
              <summary><%= f.q %><span class="faq-icon"></span></summary>
              <p><%= f.a %></p>
            </details>
          <% }); %>
        </div>
      <% } %>

      <% if (service.related && service.related.length) { %>
        <h2 style="margin-top: 1.8em;">Related guides and tools</h2>
        <ul class="service-points">
          <% service.related.forEach(function(r) { %>
            <li><a href="<%= r[1] %>"><%= r[0] %></a></li>
          <% }); %>
        </ul>
      <% } %>

      <div class="cta-band" style="margin-top: 44px;">
        <span class="cta-orb cta-orb-1"></span>
        <span class="cta-orb cta-orb-2"></span>
        <h2>Interested in <span class="grad-text"><%= service.title %></span>?</h2>
        <p>Get in touch and we'll walk you through how it fits your site.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Get in touch</a>
          <a href="https://wa.me/<%= site.whatsappNumber %>" target="_blank" rel="noopener" class="btn btn-glass">Chat on WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    description: service.answer ? service.answer + ' ' + service.description : service.description,
    serviceType: service.title,
    areaServed: 'Worldwide',
    audience: { '@type': 'Audience', audienceType: 'Website owners, in-house marketing teams and SEO agencies' },
    provider: { '@id': site.baseUrl + '/#organization' },
    url: site.baseUrl + '/services/' + service.slug
  }) %>
</script>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.baseUrl },
      { '@type': 'ListItem', position: 2, name: service.title, item: site.baseUrl + '/services/' + service.slug }
    ]
  }) %>
</script>

<% if (allFaqs && allFaqs.length) { %>
<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: allFaqs.map(function(f) {
      return {
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      };
    })
  }) %>
</script>
<% } %>
