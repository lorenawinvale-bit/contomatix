<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Does this tool check my rank automatically?', acceptedAnswer: { '@type': 'Answer', text: 'No. It builds the grid and the Google Maps links, and you type in the rank you see at each point. It then calculates the average, the top-3 and top-10 coverage and the heatmap.' } },
      { '@type': 'Question', name: 'Do sponsored results count as my rank?', acceptedAnswer: { '@type': 'Answer', text: 'No. Paid listings are labelled Sponsored and appear above the normal results. Count your position among the organic listings only.' } },
      { '@type': 'Question', name: 'Why do I get a different rank from someone else?', acceptedAnswer: { '@type': 'Answer', text: 'Local results depend on where the searcher is, and can also vary with the device, account and time. Treat a grid as a snapshot and compare checks made in the same way.' } },
      { '@type': 'Question', name: 'How do I find my latitude and longitude?', acceptedAnswer: { '@type': 'Answer', text: 'Open Google Maps, right-click your business location and click the pair of numbers at the top of the menu. They are copied, and you can paste them into the centre field.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything is calculated in your browser with JavaScript - nothing is uploaded, logged, or stored on any server, including ours.' } }
    ]
  }) %>
</script>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var ranks = {};      // "r,c" -> number | 'nf'
  var points = [];
  var KM_PER_DEG = 111.32;

  function parseCenter(s) {
    var m = /^\s*(-?\d+(?:\.\d+)?)\s*[,;\s]\s*(-?\d+(?:\.\d+)?)\s*$/.exec(s || '');
    if (!m) return null;
    var lat = parseFloat(m[1]), lng = parseFloat(m[2]);
    if (lat < -90 || lat > 90 || lng < -180 || lng > 180) return null;
    return { lat: lat, lng: lng };
  }

  function build() {
    var kw = $('gg-kw').value.trim();
    var c = parseCenter($('gg-center').value);
    var n = parseInt($('gg-size').value, 10);
    var gap = parseFloat($('gg-gap').value);
    var km = $('gg-unit').value === 'mi' ? gap * 1.609344 : gap;
    points = [];
    if (!kw || !c || !(km > 0)) return false;
    var dLat = km / KM_PER_DEG;
    var dLng = km / (KM_PER_DEG * Math.cos(c.lat * Math.PI / 180));
    var half = (n - 1) / 2, z = $('gg-zoom').value;
    for (var r = 0; r < n; r++) {
      for (var col = 0; col < n; col++) {
        var lat = c.lat + (half - r) * dLat;
        var lng = c.lng + (col - half) * dLng;
        points.push({
          key: r + ',' + col, r: r, c: col,
          lat: lat, lng: lng,
          url: 'https://www.google.com/maps/search/' + encodeURIComponent(kw) + '/@' + lat.toFixed(5) + ',' + lng.toFixed(5) + ',' + z + 'z'
        });
      }
    }
    return true;
  }

  function colour(v) {
    if (v === 'nf') return '#f4c7c3';
    if (v === undefined || v === '') return '#f3eee6';
    if (v <= 3) return '#b7e1c1';
    if (v <= 10) return '#fbe7a1';
    return '#f9cfa5';
  }

  function render() {
    var grid = $('gg-grid'), status = $('gg-status');
    grid.innerHTML = '';
    if (!build()) {
      status.textContent = 'Waiting for input';
      $('gg-stats').textContent = '';
      return;
    }
    var n = parseInt($('gg-size').value, 10);
    grid.style.gridTemplateColumns = 'repeat(' + n + ', minmax(0, 1fr))';
    points.forEach(function (p) {
      var cell = document.createElement('div');
      cell.style.cssText = 'border:1px solid #e3d8c8;border-radius:8px;padding:5px;text-align:center;font-size:0.72rem;';
      var v = ranks[p.key];
      cell.style.background = colour(v);
      var a = document.createElement('a');
      a.href = p.url; a.target = '_blank'; a.rel = 'noopener';
      a.textContent = 'Open ↗';
      a.style.cssText = 'display:block;margin-bottom:4px;color:#0f766e;font-weight:600;';
      var inp = document.createElement('input');
      inp.type = 'number'; inp.min = 1; inp.max = 20; inp.placeholder = '#';
      inp.style.cssText = 'width:100%;padding:3px;text-align:center;border:1px solid #d8cdbb;border-radius:5px;';
      if (typeof v === 'number') inp.value = v;
      var nf = document.createElement('label');
      nf.style.cssText = 'display:flex;gap:3px;justify-content:center;align-items:center;margin-top:3px;font-size:0.68rem;';
      var cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = v === 'nf';
      nf.appendChild(cb); nf.appendChild(document.createTextNode('not found'));
      inp.addEventListener('input', function () {
        var x = parseInt(inp.value, 10);
        if (x >= 1 && x <= 20) { ranks[p.key] = x; cb.checked = false; } else { delete ranks[p.key]; }
        cell.style.background = colour(ranks[p.key]); stats();
      });
      cb.addEventListener('change', function () {
        if (cb.checked) { ranks[p.key] = 'nf'; inp.value = ''; } else { delete ranks[p.key]; }
        cell.style.background = colour(ranks[p.key]); stats();
      });
      cell.appendChild(a); cell.appendChild(inp); cell.appendChild(nf);
      grid.appendChild(cell);
    });
    status.textContent = points.length + ' points';
    stats();
  }

  function stats() {
    var total = points.length, nums = [], nf = 0;
    points.forEach(function (p) {
      var v = ranks[p.key];
      if (typeof v === 'number') nums.push(v); else if (v === 'nf') nf++;
    });
    var checked = nums.length + nf;
    var out = $('gg-stats');
    if (!checked) { out.textContent = 'Checked 0 of ' + total + ' points.'; return; }
    var avg = nums.length ? (nums.reduce(function (a, b) { return a + b; }, 0) / nums.length).toFixed(1) : '—';
    var t3 = nums.filter(function (x) { return x <= 3; }).length;
    var t10 = nums.filter(function (x) { return x <= 10; }).length;
    out.innerHTML = 'Checked <strong>' + checked + '</strong> of ' + total + ' points<br>' +
      'Average rank (where found): <strong>' + avg + '</strong><br>' +
      'Top 3: <strong>' + t3 + '</strong> (' + Math.round(t3 / checked * 100) + '% of checked) · Top 10: <strong>' + t10 + '</strong> (' + Math.round(t10 / checked * 100) + '%)<br>' +
      'Not found in top 20: <strong>' + nf + '</strong>';
  }

  function copyText() {
    if (!points.length) return;
    var n = parseInt($('gg-size').value, 10), lines = ['Keyword: ' + $('gg-kw').value.trim()];
    for (var r = 0; r < n; r++) {
      var row = [];
      for (var c = 0; c < n; c++) {
        var v = ranks[r + ',' + c];
        row.push(typeof v === 'number' ? String(v) : (v === 'nf' ? '20+' : '-'));
      }
      lines.push(row.join('\t'));
    }
    var text = lines.join('\n') + '\n' + $('gg-stats').textContent;
    if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () {
      var b = $('gg-copy'); b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy results'; }, 1500);
    });
  }

  ['gg-kw', 'gg-center', 'gg-gap'].forEach(function (id) { $(id).addEventListener('input', function () { ranks = {}; render(); }); });
  ['gg-size', 'gg-unit', 'gg-zoom'].forEach(function (id) { $(id).addEventListener('change', function () { if (id === 'gg-size') ranks = {}; render(); }); });
  $('gg-copy').addEventListener('click', copyText);
  render();
})();
</script>
