<section class="page-hero">
  <div id="ambient-canvas" class="ambient-canvas"></div>
  <div class="container page-hero-inner">
    <span class="eyebrow">Team</span>
    <h1>The people behind Contomatix</h1>
    <p>A small, focused team working on link building, SEO, and content.</p>
  </div>
</section>

<section>
  <div class="container team-grid">
    <% team.forEach(function(member) { %>
      <div class="team-card">
        <% if (member.hasPhoto) { %>
          <div class="team-avatar team-avatar-photo">
            <img src="<%= member.photo %>" alt="<%= member.name %>" width="88" height="88">
            <span class="team-avatar-badge" aria-hidden="true"><%- include('../partials/logo', { logoSize: 18, logoId: 'badge-' + member.name.replace(/\s+/g,'') }) %></span>
          </div>
        <% } else { %>
          <div class="team-avatar"><%= member.name.split(' ').map(function(w){ return w[0]; }).join('') %></div>
        <% } %>
        <h2><%= member.name %></h2>
        <div class="role"><%= member.role %></div>
        <p class="bio"><%= member.bio %></p>
        <a href="/team/<%= member.slug %>" class="team-linkedin">Read posts (<%= member.postCount %>) &rarr;</a>
        <% if (member.linkedin) { %>
          <a href="<%= member.linkedin %>" class="team-linkedin" target="_blank" rel="noopener noreferrer">LinkedIn &rarr;</a>
        <% } %>
      </div>
    <% }); %>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">How we work</span>
      <h2>A small team, on purpose</h2>
      <p>Contomatix stays deliberately small rather than scaling into a large account-manager-and-junior-writer pyramid. Every client works directly with the people setting strategy, not a rotating point of contact reading from someone else's notes.</p>
    </div>
    <div class="process-list">
      <div class="process-step">
        <span class="step-num">01</span>
        <h3>Strategy stays with the founders</h3>
        <p>Keyword research, link targeting, and campaign direction are set by the same two people on every account — not handed off to a junior team once the contract is signed.</p>
      </div>
      <div class="process-step">
        <span class="step-num">02</span>
        <h3>Execution is manual, not templated</h3>
        <p>Outreach, vetting, and placements are done by hand against each site's actual niche and competitors, rather than run through an automated tool with a client's name swapped in.</p>
      </div>
      <div class="process-step">
        <span class="step-num">03</span>
        <h3>You see the same reporting we do</h3>
        <p>Clients get the same live link sheet and monthly reporting the team itself works from — not a summarized dashboard built to look busy.</p>
      </div>
      <div class="process-step">
        <span class="step-num">04</span>
        <h3>Direct access, not a support queue</h3>
        <p>Questions go straight to the person who can answer them — over WhatsApp, email, or a call — instead of a ticketing system with a multi-day response time.</p>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Contomatix Team',
    itemListElement: team.map(function(m, i) {
      var person = {
        '@type': 'Person',
        name: m.name,
        jobTitle: m.role,
        description: m.bio,
        url: site.baseUrl + '/team/' + m.slug,
        worksFor: { '@id': site.baseUrl + '/#organization' }
      };
      if (m.linkedin) person.sameAs = [m.linkedin];
      return { '@type': 'ListItem', position: i + 1, item: person };
    })
  }) %>
</script>
