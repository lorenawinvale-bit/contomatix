<%
var ICS = ['<path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4z"/>', '<path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>', '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>', '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>'];
var tone = ['#0EA5A0', '#DB2777', '#D97706', '#0E7490'];
%>
<section class="pg-hero">
  <div class="container">
    <span class="eyebrow">Team</span>
    <h1>The people behind Contomatix</h1>
    <p>A small team on purpose. You talk to the people who plan and run the work, not an account manager reading from someone else's notes.</p>
    <div class="pg-chips">
      <span><b><%= team.length %></b> people</span>
      <span><b><%= totalPosts %></b> guides published</span>
      <span><b>24h</b> reply time</span>
      <span><b>0</b> account-manager layers</span>
    </div>
  </div>
</section>

<section class="tm-wrap">
  <div class="container">
    <div class="tm-grid">
      <% team.forEach(function (m, i) { var ini = m.name.split(' ').map(function (w) { return w[0]; }).join(''); %>
      <article class="tm-card" style="--c:<%= tone[i % 4] %>;--i:<%= i %>">
        <div class="tm-top">
          <div class="tm-ph">
            <% if (m.hasPhoto) { %><img src="<%= m.photo %>" alt="<%= m.name %>" width="96" height="96" loading="<%= i < 2 ? 'eager' : 'lazy' %>"><% } else { %><span><%= ini %></span><% } %>
            <i class="tm-ring"></i>
          </div>
          <div class="tm-id">
            <h2><%= m.name %></h2>
            <div class="tm-role"><%= m.role %></div>
            <div class="tm-links">
              <% if (m.linkedin) { %><a href="<%= m.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="<%= m.name %> on LinkedIn"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M6.5 8.5H3.8V20h2.7V8.5zM5.1 3.5a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2zM20.2 13c0-3-1.6-4.7-4-4.7-1.5 0-2.4.8-2.9 1.5V8.5h-2.6V20h2.7v-6.2c0-1.6.8-2.5 2.1-2.5s1.9.9 1.9 2.5V20h2.8V13z"/></svg>LinkedIn</a><% } %>
              <% if (m.postCount > 0) { %><a href="/team/<%= m.slug %>">Articles<em><%= m.postCount %></em></a><% } %>
            </div>
          </div>
        </div>
        <p class="tm-bio"><%= m.bio %></p>
        <div class="tm-lab">Owns</div>
        <div class="tm-tags"><% (m.focus || []).forEach(function (f) { %><span><%= f %></span><% }); %></div>
        <% if (m.postCount > 0) { %>
        <div class="tm-stats">
          <div><b><%= m.postCount %></b><small>guides written</small></div>
          <div><b><%= m.topCats.length %></b><small>topics covered</small></div>
          <div class="tm-cats"><small>Writes about</small><span><%= m.topCats.join(' · ') %></span></div>
        </div>
        <div class="tm-lab">Latest from <%= m.name.split(' ')[0] %></div>
        <ul class="tm-posts"><% m.latest.forEach(function (p) { %><li><a href="/blog/<%= p.slug %>"><span><%= p.title %></span><time><%= p.date %></time></a></li><% }); %></ul>
        <% } else { %>
        <div class="tm-lab">Talk to <%= m.name.split(' ')[0] %></div>
        <div class="tm-direct"><p>Strategy calls, link targets and campaign priorities go straight to <%= m.name.split(' ')[0] %>, no account manager in between.</p><a href="/contact">Book a free audit call &rarr;</a></div>
        <% } %>
      </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="tm-how">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">How we work</span>
      <h2>A small team, on purpose</h2>
      <p>We stay small rather than scaling into an account-manager-and-junior-writer pyramid. Every client works directly with the people setting strategy.</p>
    </div>
    <div class="pg-cards four">
      <% [['Strategy stays with the founders', 'Keyword research, link targeting and campaign direction are set by the same people on every account, not handed to a junior team once the contract is signed.'], ['Execution is manual, not templated', 'Outreach, vetting and placements are done by hand against each site\'s niche and competitors, not run through a tool with a client\'s name swapped in.'], ['You see the same reporting we do', 'Clients get the live link sheet and monthly reporting the team works from, not a dashboard built to look busy.'], ['Direct access, not a support queue', 'Questions go straight to the person who can answer them, over WhatsApp, email or a call, instead of a ticket with a multi-day response time.']].forEach(function (s, n) { %>
      <div class="pg-card" style="--c:<%= tone[n] %>"><span class="pg-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- ICS[n] %></svg></span><em>0<%= n + 1 %></em><h3><%= s[0] %></h3><p><%= s[1] %></p></div>
      <% }); %>
    </div>
  </div>
</section>

<section class="cta">
  <div class="container">
    <div class="cta-band">
      <span class="cta-orb cta-orb-1"></span><span class="cta-orb cta-orb-2"></span><span class="cta-orb cta-orb-3"></span>
      <h2>Talk to the people doing the work</h2>
      <p>Send us your domain and one of us will review your backlink profile and keywords, including the parts you will not want to hear.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">Get a free audit &rarr;</a>
        <a href="https://wa.me/<%= site.whatsappNumber %>" target="_blank" rel="noopener" class="btn btn-glass">Chat on WhatsApp</a>
      </div>
      <p class="cta-note">Free audit · No obligation · Reply within 24 hours</p>
    </div>
  </div>
</section>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Contomatix Team',
    itemListElement: team.map(function(m, i) {
      var person = {
        '@type': 'Person',
        name: m.name,
        jobTitle: m.role,
        description: m.bio,
        url: site.baseUrl + '/team/' + m.slug,
        worksFor: { '@id': site.baseUrl + '/#organization' }
      };
      if (m.hasPhoto) person.image = site.baseUrl + m.photo;
      if (m.linkedin) person.sameAs = [m.linkedin];
      return { '@type': 'ListItem', position: i + 1, item: person };
    })
  }) %>
</script>
