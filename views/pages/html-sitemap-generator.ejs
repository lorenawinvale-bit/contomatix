<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var current = '', fullPage = '';
  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function titleCase(s) {
    return s.replace(/[-_]+/g, ' ').replace(/\.(html?|php|aspx?)$/i, '').replace(/\b([a-z])/g, function (m) { return m.toUpperCase(); }).replace(/\b(Seo|Faq|Ppc|Api|Ai|Css|Html|Cta|Roi|Kpi|Usa|Uk|B2b|B2c|Url|Ux|Ui)\b/g, function (m) { return m.toUpperCase(); }).trim();
  }

  function parse() {
    var raw = $('hs-input').value;
    var out = [], seen = {};
    var locs = raw.match(/<loc>\s*([^<\s]+)\s*<\/loc>/gi);
    var lines = [];
    if (locs && locs.length) {
      locs.forEach(function (m) { lines.push(m.replace(/<\/?loc>/gi, '').trim()); });
    } else {
      raw.split('\n').forEach(function (l) { l = l.trim(); if (l) lines.push(l); });
    }
    var skip = $('hs-exclude').value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
    lines.forEach(function (line) {
      var parts = line.split('|'), url = parts[0].trim(), custom = (parts[1] || '').trim();
      if (!/^https?:\/\//i.test(url)) return;
      if (/\.xml(\.gz)?$/i.test(url)) return;
      if (skip.some(function (s) { return url.indexOf(s) !== -1; })) return;
      var key = url.replace(/#.*$/, '').replace(/\/$/, '');
      if (seen[key]) return; seen[key] = 1;
      var u; try { u = new URL(url); } catch (e) { return; }
      var segs = u.pathname.split('/').filter(Boolean);
      var last = segs.length ? decodeURIComponent(segs[segs.length - 1]) : '';
      out.push({ url: url, u: u, segs: segs, title: custom || (segs.length ? titleCase(last) : 'Home') });
    });
    return out;
  }

  function build() {
    var items = parse();
    if (!items.length) return null;
    var origin = items[0].u.origin, rel = $('hs-relative').checked, group = $('hs-group').value, doSort = $('hs-sort').checked;
    var skippedCross = 0;
    var groups = {}, order = [];
    items.forEach(function (it) {
      var href = it.url;
      if (rel && it.u.origin === origin) href = it.u.pathname + it.u.search;
      it.href = href;
      var g = group === 'folder' ? (it.segs.length > 1 ? titleCase(it.segs[0]) : (it.segs.length === 1 ? 'Main pages' : 'Main pages')) : 'All pages';
      if (!groups[g]) { groups[g] = []; order.push(g); }
      groups[g].push(it);
    });
    if (group === 'folder') {
      order.sort(function (a, b) { if (a === 'Main pages') return -1; if (b === 'Main pages') return 1; return a.localeCompare(b); });
    }
    var site = $('hs-site').value.trim();
    var h = [];
    h.push('<nav aria-label="Sitemap" class="html-sitemap">');
    order.forEach(function (g) {
      var list = groups[g].slice();
      if (doSort) list.sort(function (a, b) { return a.title.localeCompare(b.title); });
      if (group === 'folder' || order.length > 1) h.push('  <h2>' + esc(g) + '</h2>');
      h.push('  <ul>');
      list.forEach(function (it) { h.push('    <li><a href="' + esc(it.href) + '">' + esc(it.title) + '</a></li>'); });
      h.push('  </ul>');
    });
    h.push('</nav>');
    var snippet = h.join('\n');
    var page = '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n<title>' + esc(site ? site + ' Sitemap' : 'Sitemap') + '</title>\n<style>body{font:16px/1.6 Arial,sans-serif;max-width:760px;margin:40px auto;padding:0 16px;color:#111}h1{font-size:1.8rem}h2{font-size:1.2rem;margin-top:1.6rem}a{color:#0b6b66}</style>\n</head>\n<body>\n<h1>' + esc(site ? site + ' sitemap' : 'Sitemap') + '</h1>\n' + snippet + '\n</body>\n</html>\n';
    return { snippet: snippet, page: page, count: items.length, groups: order.length, rel: rel };
  }

  function run() {
    var r = build();
    current = r ? r.snippet : ''; fullPage = r ? r.page : '';
    $('hs-output').textContent = r ? r.snippet : 'Paste some URLs to start.';
    $('hs-status').textContent = r ? r.count + ' links ready' : 'Waiting for input';
    $('hs-summary').innerHTML = r ? '&#10003; ' + r.count + ' unique links in ' + r.groups + ' section' + (r.groups === 1 ? '' : 's') + '. XML files and duplicates were skipped.<br>&#9888; Check each link returns a 200 before you publish: an HTML sitemap with dead links frustrates visitors.' : '';
  }

  Array.prototype.slice.call($('hs-form').querySelectorAll('input,select,textarea')).forEach(function (e) {
    e.addEventListener('input', run); e.addEventListener('change', run);
  });
  $('hs-copy').addEventListener('click', function () {
    if (!current) return;
    var b = $('hs-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(current).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy HTML'; }, 1500); });
  });
  $('hs-download').addEventListener('click', function () {
    if (!fullPage) return;
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([fullPage], { type: 'text/html' }));
    a.download = 'sitemap.html';
    document.body.appendChild(a); a.click(); a.remove();
  });
  run();
})();
</script>
