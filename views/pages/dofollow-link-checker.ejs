  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Is dofollow an official HTML attribute?', acceptedAnswer: { '@type': 'Answer', text: 'No. There is no dofollow value. A link is followed by default and becomes nofollow, sponsored or ugc only when the rel attribute says so.' } },
      { '@type': 'Question', name: 'Can this tool check the backlinks pointing to my site?', acceptedAnswer: { '@type': 'Answer', text: 'It checks the HTML you paste. To check a backlink, open the page that links to you, copy its HTML, paste it here and enter your domain. The report shows how that link is marked.' } },
      { '@type': 'Question', name: 'Why is a link without rel still marked nofollow?', acceptedAnswer: { '@type': 'Answer', text: 'The page has a robots meta tag containing nofollow, which applies to all links on the page. The checker shows this as a page-level setting.' } },
      { '@type': 'Question', name: 'What is the difference between sponsored, ugc and nofollow?', acceptedAnswer: { '@type': 'Answer', text: 'Sponsored is for paid or compensated links, ugc is for user-generated content such as comments and forum posts, and nofollow is the general hint when neither applies. Google treats all three as hints.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. The HTML is parsed in your browser with JavaScript. Nothing is uploaded, logged or stored on any server, including ours.' } }
    ]
  }) %>
</script>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var text = '';

  function hostOf(h) { return String(h || '').toLowerCase().replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/[\/?#].*$/, ''); }

  function run() {
    var src = $('dl-html').value, out = $('dl-output'), status = $('dl-status');
    var mine = hostOf($('dl-domain').value), onlyExt = $('dl-only').checked;
    text = '';
    if (!src.trim()) { out.textContent = 'Paste HTML to list its links.'; status.textContent = 'Waiting for input'; return; }
    var doc = new DOMParser().parseFromString(src, 'text/html');
    var pageNofollow = false;
    doc.querySelectorAll('meta[name]').forEach(function (m) {
      var n = (m.getAttribute('name') || '').toLowerCase();
      if ((n === 'robots' || n === 'googlebot') && /nofollow|none/i.test(m.getAttribute('content') || '')) pageNofollow = true;
    });
    var counts = { followed: 0, nofollow: 0, sponsored: 0, ugc: 0, internal: 0, external: 0, skipped: 0 };
    var rows = [];
    doc.querySelectorAll('a[href]').forEach(function (a) {
      var href = (a.getAttribute('href') || '').trim();
      var label = (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 50) || (a.querySelector('img') ? '[image link]' : '[no anchor text]');
      if (!href || /^(#|mailto:|tel:|javascript:|sms:)/i.test(href)) { counts.skipped++; return; }
      var rel = (a.getAttribute('rel') || '').toLowerCase().split(/\s+/).filter(Boolean);
      var kinds = [];
      ['nofollow', 'sponsored', 'ugc'].forEach(function (k) { if (rel.indexOf(k) !== -1) { kinds.push(k); counts[k]++; } });
      var isAbs = /^(https?:)?\/\//i.test(href);
      var scope = !isAbs ? 'internal' : (mine && hostOf(href.replace(/^\/\//, '')) === mine ? 'internal' : 'external');
      counts[scope]++;
      var followed = !kinds.length && !pageNofollow;
      if (followed) counts.followed++;
      if (onlyExt && scope === 'internal') return;
      rows.push({ followed: followed, kinds: kinds, scope: scope, href: href, label: label });
    });
    var L = [];
    var total = doc.querySelectorAll('a[href]').length - counts.skipped;
    L.push('Web links: ' + total + '   Followed: ' + counts.followed + '   Nofollow: ' + counts.nofollow + '   Sponsored: ' + counts.sponsored + '   UGC: ' + counts.ugc);
    L.push('Internal: ' + counts.internal + '   External: ' + counts.external + '   Skipped (mailto, tel, #, javascript): ' + counts.skipped);
    if (pageNofollow) { L.push(''); L.push('! A robots meta tag with nofollow is present, so every link on this page is treated as nofollow.'); }
    L.push('');
    if (!rows.length) L.push('No web links to show.');
    rows.forEach(function (r) {
      var tag = r.followed ? 'FOLLOWED ' : (r.kinds.length ? r.kinds.join('+').toUpperCase() : 'NOFOLLOW (page-level)');
      L.push(tag + '  [' + r.scope + ']  ' + r.href);
      L.push('         anchor: ' + r.label);
    });
    text = L.join('\n');
    out.textContent = text;
    status.textContent = counts.followed + ' followed · ' + (total - counts.followed) + ' not followed';
  }

  ['dl-html', 'dl-domain'].forEach(function (id) { $(id).addEventListener('input', run); });
  $('dl-only').addEventListener('change', run);
  $('dl-copy').addEventListener('click', function () {
    if (!text) return;
    var b = $('dl-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
  });
  run();
})();
</script>
