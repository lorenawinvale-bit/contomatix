<script>
(function () {
  function esc(s) { return (s || '').replace(/&/g, '&amp;'); }

  function build() {
    var lines = document.getElementById('sm-urls').value.split('\n').map(function (l) { return l.trim(); }).filter(Boolean);
    var changefreq = document.getElementById('sm-changefreq').value;
    var priority = document.getElementById('sm-priority').value;

    if (!lines.length) {
      document.getElementById('sm-output').textContent = '<!-- Add at least one URL to generate a sitemap -->';
      document.getElementById('sm-status').textContent = 'Add URLs to generate';
      return;
    }

    var entries = lines.map(function (url, i) {
      var parts = ['  <url>', '    <loc>' + esc(url) + '</loc>'];
      if (changefreq) parts.push('    <changefreq>' + changefreq + '</changefreq>');
      if (priority) parts.push('    <priority>' + (i === 0 ? priority : '0.5') + '</priority>');
      parts.push('  </url>');
      return parts.join('\n');
    });

    var xml = '<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n' + entries.join('\n') + '\n</urlset>';
    document.getElementById('sm-output').textContent = xml;
    document.getElementById('sm-status').textContent = 'Updated';
  }

  document.querySelectorAll('#sm-form textarea, #sm-form select').forEach(function (el) {
    el.addEventListener('input', build);
    el.addEventListener('change', build);
  });

  document.getElementById('sm-copy').addEventListener('click', function () {
    var text = document.getElementById('sm-output').textContent;
    if (!text || text.indexOf('Add at least one') !== -1) return;
    navigator.clipboard.writeText(text).then(function () {
      var status = document.getElementById('sm-status');
      status.textContent = 'Copied!';
      setTimeout(function () { status.textContent = 'Updated'; }, 1800);
    });
  });

  document.getElementById('sm-download').addEventListener('click', function () {
    var text = document.getElementById('sm-output').textContent;
    if (!text || text.indexOf('Add at least one') !== -1) return;
    var blob = new Blob([text], { type: 'application/xml' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'sitemap.xml';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  build();
})();
</script>
