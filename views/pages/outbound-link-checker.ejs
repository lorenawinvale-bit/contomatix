<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is an outbound link?', acceptedAnswer: { '@type': 'Answer', text: 'It is a link on your page that points to a page on a different domain. Links to other pages on your own domain are internal links.' } },
      { '@type': 'Question', name: 'Should outbound links be nofollow?', acceptedAnswer: { '@type': 'Answer', text: 'Not by default. Google says regular links you expect it to follow need no rel attribute. It asks for sponsored on paid links, ugc on user-generated links, and nofollow when you would rather not be associated with the page.' } },
      { '@type': 'Question', name: 'Does the tool visit the links to see if they work?', acceptedAnswer: { '@type': 'Answer', text: 'No. It reads only the HTML you paste and never fetches any URL, so it cannot tell whether a link is broken.' } },
      { '@type': 'Question', name: 'How many outbound links is too many?', acceptedAnswer: { '@type': 'Answer', text: 'Google gives no limit. Link where it helps the reader, and use the report to spot a page where links look excessive or off-topic.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything is analysed in your browser with JavaScript - nothing is uploaded, logged, or stored on any server, including ours.' } }
    ]
  }) %>
</script>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var current = '';
  var SHORT = /^(bit\.ly|t\.co|goo\.gl|tinyurl\.com|ow\.ly|buff\.ly|is\.gd|rebrand\.ly|cutt\.ly|t\.ly|lnkd\.in|shorturl\.at)$/i;
  var AFF_Q = /[?&](ref|aff|affiliate|aff_id|tag|partner|clickid|subid|irclickid)=/i;
  var AFF_P = /\/(go|out|recommends|refer|visit)\//i;

  function host(u) { try { return new URL(u).hostname.replace(/^www\./, '').toLowerCase(); } catch (e) { return ''; } }
  function attr(tag, name) { var m = tag.match(new RegExp('\\b' + name + '\\s*=\\s*("([^"]*)"|\'([^\']*)\'|([^\\s>]+))', 'i')); return m ? (m[2] !== undefined ? m[2] : (m[3] !== undefined ? m[3] : m[4])) : ''; }
  function clean(s) { return s.replace(/<img[^>]*alt=["']([^"']*)["'][^>]*>/gi, '$1').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim(); }

  function build() {
    var raw = $('ol-input').value;
    if (!/<a\b/i.test(raw)) return null;
    var me = $('ol-domain').value.trim().toLowerCase().replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/.*$/, '');
    if (!me) {
      var c = raw.match(/<link[^>]*rel=["']canonical["'][^>]*>/i) || raw.match(/<meta[^>]*property=["']og:url["'][^>]*>/i);
      if (c) me = host(attr(c[0], 'href') || attr(c[0], 'content'));
    }
    var pageNofollow = /<meta[^>]*name=["']robots["'][^>]*content=["'][^"']*nofollow/i.test(raw);
    var re = /<a\b([^>]*)>([\s\S]*?)<\/a>/gi, m, all = 0, ext = [], doms = {};
    while ((m = re.exec(raw))) {
      var tag = m[1], href = attr(tag, 'href');
      if (!href || /^(#|mailto:|tel:|javascript:)/i.test(href)) continue;
      all++;
      if (!/^https?:\/\//i.test(href) && href.indexOf('//') !== 0) continue;
      if (href.indexOf('//') === 0) href = 'https:' + href;
      var h = host(href);
      if (!h || (me && (h === me || h.slice(-(me.length + 1)) === '.' + me))) continue;
      var rel = attr(tag, 'rel').toLowerCase();
      var st = /sponsored/.test(rel) ? 'sponsored' : /ugc/.test(rel) ? 'ugc' : /nofollow/.test(rel) ? 'nofollow' : 'followed';
      var text = clean(m[2]);
      ext.push({ href: href, host: h, st: st, text: text });
      var d = doms[h] || (doms[h] = { n: 0, followed: 0, qualified: 0 }); d.n++; if (st === 'followed') d.followed++; else d.qualified++;
    }
    return { all: all, ext: ext, doms: doms, me: me, pageNofollow: pageNofollow };
  }

  function render() {
    var r = build();
    if (!r) { $('ol-output').textContent = "Paste a page's HTML to start."; $('ol-notes').innerHTML = ''; $('ol-status').textContent = 'Waiting for input'; current = ''; return; }
    var n = r.ext.length, names = Object.keys(r.doms).sort(function (a, b) { return r.doms[b].n - r.doms[a].n; });
    var cnt = { followed: 0, nofollow: 0, sponsored: 0, ugc: 0 };
    r.ext.forEach(function (e) { cnt[e.st]++; });
    var http = r.ext.filter(function (e) { return /^http:\/\//i.test(e.href); });
    var short = r.ext.filter(function (e) { return SHORT.test(e.host); });
    var aff = r.ext.filter(function (e) { return AFF_Q.test(e.href) || AFF_P.test(e.href); });
    var empty = r.ext.filter(function (e) { return !e.text; });
    var seen = {}, dup = [];
    r.ext.forEach(function (e) { var k = e.href.replace(/#.*$/, ''); seen[k] = (seen[k] || 0) + 1; });
    Object.keys(seen).forEach(function (k) { if (seen[k] > 1) dup.push(k + ' (' + seen[k] + 'x)'); });
    var L = [];
    L.push('OUTBOUND LINK REPORT'); L.push('');
    L.push('Your domain: ' + (r.me || 'not detected (all absolute links counted as external)'));
    L.push('Links on page: ' + r.all + '   External: ' + n + '   Different domains: ' + names.length);
    L.push('Followed: ' + cnt.followed + '   Nofollow: ' + cnt.nofollow + '   Sponsored: ' + cnt.sponsored + '   Ugc: ' + cnt.ugc);
    if (r.pageNofollow) L.push('Page-level robots meta contains nofollow: links on this page are treated as nofollow.');
    L.push(''); L.push('BY DOMAIN');
    names.slice(0, 40).forEach(function (d) { var x = r.doms[d]; L.push(('  ' + d + '  ').slice(0, 40) + x.n + ' link' + (x.n > 1 ? 's' : '') + '  (' + x.followed + ' followed, ' + x.qualified + ' qualified)'); });
    if (names.length > 40) L.push('  ... and ' + (names.length - 40) + ' more domains');
    function list(title, a) { if (a.length) { L.push(''); L.push(title + ' (' + a.length + ')'); a.slice(0, 15).forEach(function (e) { L.push('  ' + (e.href || e)); }); } }
    list('INSECURE (http) LINKS', http); list('SHORTENED LINKS', short); list('AFFILIATE-LOOKING LINKS', aff);
    if (dup.length) { L.push(''); L.push('SAME URL LINKED MORE THAN ONCE (' + dup.length + ')'); dup.slice(0, 15).forEach(function (x) { L.push('  ' + x); }); }
    if (empty.length) { L.push(''); L.push('LINKS WITH NO VISIBLE TEXT (' + empty.length + ')'); empty.slice(0, 10).forEach(function (e) { L.push('  ' + e.href); }); }
    current = L.join('\n');
    $('ol-output').textContent = current;
    var notes = [];
    if (!n) notes.push('No external links found. If you expected some, check that you pasted the full page source and that your domain is right.');
    if (aff.length && aff.some(function (e) { return e.st === 'followed'; })) notes.push('<strong>Affiliate-looking links without sponsored.</strong> If you earn money from these, Google asks you to mark them <code>rel="sponsored"</code>.');
    if (http.length) notes.push('<strong>' + http.length + ' link(s) use http.</strong> Check whether an https version exists.');
    if (short.length) notes.push('<strong>' + short.length + ' shortened link(s).</strong> Replace them with the real destination so readers and crawlers can see it.');
    if (n && !cnt.nofollow && !cnt.sponsored && !cnt.ugc) notes.push('All external links are followed. That is normal for editorial links; mark paid or user-submitted ones.');
    $('ol-notes').innerHTML = notes.length ? '<ul style="padding-left:18px;margin:0;"><li>' + notes.join('</li><li>') + '</li></ul>' : '';
    $('ol-status').textContent = n + ' external link' + (n === 1 ? '' : 's') + ' checked';
  }

  $('ol-input').addEventListener('input', render);
  $('ol-domain').addEventListener('input', render);
  $('ol-copy').addEventListener('click', function () { if (current && navigator.clipboard) navigator.clipboard.writeText(current); });
  $('ol-download').addEventListener('click', function () { if (!current) return; var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([current], { type: 'text/plain' })); a.download = 'outbound-link-report.txt'; a.click(); });
})();
</script>
