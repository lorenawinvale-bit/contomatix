  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Should I use hyphens or underscores in a slug?', acceptedAnswer: { '@type': 'Answer', text: 'Hyphens. Google documentation recommends hyphens instead of underscores to separate words in URLs.' } },
      { '@type': 'Question', name: 'Does capitalization matter in a URL?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Google treats /APPLE and /apple as different URLs, so using one case throughout, usually lowercase, avoids accidental duplicates.' } },
      { '@type': 'Question', name: 'Should I remove stop words from a slug?', acceptedAnswer: { '@type': 'Answer', text: 'It is a style choice rather than a rule. Removing words like the and of makes slugs shorter, but a slug that reads naturally to a person is just as good.' } },
      { '@type': 'Question', name: 'What happens to non-Latin characters?', acceptedAnswer: { '@type': 'Answer', text: 'They are kept as typed and the tool warns you. Google says non-ASCII characters should be percent-encoded in the final URL.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything is processed in your browser with JavaScript - nothing is uploaded, logged, or stored on any server, including ours.' } }
    ]
  }) %>
</script>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var STOP = 'a an the and or but of to in on at for with by from as is are was were be been it its this that these those'.split(' ');
  var MAP = { 'ß': 'ss', 'æ': 'ae', 'Æ': 'AE', 'œ': 'oe', 'Œ': 'OE', 'ø': 'o', 'Ø': 'O', 'đ': 'd', 'Đ': 'D', 'ł': 'l', 'Ł': 'L', 'þ': 'th', 'ð': 'd' };
  var current = '';

  function slugify(title, o) {
    var s = title.trim();
    if (o.accents) {
      s = s.replace(/[ßæÆœŒøØđĐłŁþð]/g, function (c) { return MAP[c]; });
      s = s.normalize('NFD').replace(/[̀-ͯ]/g, '');
    }
    s = s.replace(/['’‘]/g, '');
    if (o.lower) s = s.toLowerCase();
    var words = s.split(/[^\p{L}\p{N}]+/u).filter(Boolean);
    if (o.stop) {
      var kept = words.filter(function (w) { return STOP.indexOf(w.toLowerCase()) === -1; });
      if (kept.length) words = kept;
    }
    if (o.max) {
      var out = [], len = 0;
      for (var i = 0; i < words.length; i++) {
        var add = words[i].length + (out.length ? 1 : 0);
        if (len + add > o.max) break;
        out.push(words[i]); len += add;
      }
      if (!out.length && words.length) out.push(words[0].slice(0, o.max));
      words = out;
    }
    return words.join(o.sep);
  }

  function run() {
    var text = $('sg-input').value;
    var out = $('sg-output'), status = $('sg-status');
    current = '';
    var titles = text.split('\n').map(function (t) { return t.trim(); }).filter(Boolean);
    if (!titles.length) { out.textContent = 'Type a title to generate its slug.'; status.textContent = 'Waiting for input'; return; }
    var max = parseInt($('sg-max').value, 10);
    var o = { sep: $('sg-sep').value, lower: $('sg-lower').checked, accents: $('sg-accents').checked, stop: $('sg-stop').checked, max: max > 0 ? max : 0 };
    var slugs = titles.map(function (t) { return slugify(t, o); });
    current = slugs.join('\n');
    var nonAscii = slugs.filter(function (s) { return /[^\x00-\x7f]/.test(s); }).length;
    status.textContent = slugs.length + ' slug' + (slugs.length === 1 ? '' : 's') + (nonAscii ? ' · ' + nonAscii + ' with non-ASCII characters' : '');
    out.textContent = slugs.map(function (s) { return s || '(empty: no letters or numbers found)'; }).join('\n') + (nonAscii ? '\n\nNote: Google says non-ASCII characters in a URL should be percent-encoded.' : '');
  }

  ['sg-input', 'sg-max'].forEach(function (id) { $(id).addEventListener('input', run); });
  ['sg-sep', 'sg-lower', 'sg-accents', 'sg-stop'].forEach(function (id) { $(id).addEventListener('change', run); });
  $('sg-copy').addEventListener('click', function () {
    if (!current) return;
    var b = $('sg-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(current).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
  });
  run();
})();
</script>
