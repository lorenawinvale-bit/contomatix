<script>
(function () {
  var mode = 'desktop';
  var LIMITS = {
    desktop: { title: 60, desc: 160 },
    mobile: { title: 78, desc: 120 }
  };

  function truncate(text, max) {
    if (text.length <= max) return text;
    return text.slice(0, max - 1).trim() + '…';
  }

  function parseUrl(raw) {
    try {
      var u = new URL(raw);
      var host = u.hostname.replace(/^www\./, '');
      var parts = u.pathname.split('/').filter(Boolean);
      var breadcrumb = [host].concat(parts).join(' › ');
      var siteName = host.split('.')[0];
      siteName = siteName.charAt(0).toUpperCase() + siteName.slice(1);
      return { host: host, breadcrumb: breadcrumb, siteName: siteName, valid: true };
    } catch (e) {
      return { host: 'example.com', breadcrumb: raw || 'example.com', siteName: 'Example', valid: false };
    }
  }

  function countLabel(len, max) {
    var status = len === 0 ? '' : (len > max ? ' (over limit)' : ' / ' + max);
    return len + status;
  }

  function build() {
    var url = document.getElementById('sp-url').value.trim();
    var title = document.getElementById('sp-title').value.trim();
    var desc = document.getElementById('sp-desc').value.trim();
    var limits = LIMITS[mode];

    document.getElementById('sp-title-count').textContent = countLabel(title.length, limits.title);
    document.getElementById('sp-desc-count').textContent = countLabel(desc.length, limits.desc);
    document.getElementById('sp-title-count').style.color = title.length > limits.title ? '#B94340' : '';
    document.getElementById('sp-desc-count').style.color = desc.length > limits.desc ? '#B94340' : '';

    var parsed = parseUrl(url || 'https://example.com');
    document.getElementById('sp-preview-sitename').textContent = parsed.siteName;
    document.getElementById('sp-preview-url').textContent = parsed.breadcrumb;
    document.getElementById('sp-favicon').src = 'https://www.google.com/s2/favicons?domain=' + encodeURIComponent(parsed.host) + '&sz=64';
    document.getElementById('sp-preview-title').textContent = title ? truncate(title, limits.title) : 'Your page title will appear here';
    document.getElementById('sp-preview-desc').textContent = desc ? truncate(desc, limits.desc) : 'Your meta description will appear here.';
  }

  document.querySelectorAll('#serp-form input, #serp-form textarea').forEach(function (el) {
    el.addEventListener('input', build);
  });

  function setMode(newMode) {
    mode = newMode;
    document.getElementById('sp-desktop-btn').classList.toggle('btn-primary', mode === 'desktop');
    document.getElementById('sp-desktop-btn').classList.toggle('btn-outline', mode !== 'desktop');
    document.getElementById('sp-mobile-btn').classList.toggle('btn-primary', mode === 'mobile');
    document.getElementById('sp-mobile-btn').classList.toggle('btn-outline', mode !== 'mobile');
    document.getElementById('sp-preview').classList.toggle('serp-preview-mobile', mode === 'mobile');
    build();
  }

  document.getElementById('sp-desktop-btn').addEventListener('click', function () { setMode('desktop'); });
  document.getElementById('sp-mobile-btn').addEventListener('click', function () { setMode('mobile'); });

  setMode('desktop');
})();
</script>
