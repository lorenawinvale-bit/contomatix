<script>
(function () {
  var BOTS = [
    { token: 'GPTBot', company: 'OpenAI', purpose: 'Model training' },
    { token: 'OAI-SearchBot', company: 'OpenAI', purpose: 'ChatGPT search citations' },
    { token: 'ChatGPT-User', company: 'OpenAI', purpose: 'Live user requests' },
    { token: 'ClaudeBot', company: 'Anthropic', purpose: 'Model training' },
    { token: 'Claude-SearchBot', company: 'Anthropic', purpose: 'Search result quality' },
    { token: 'Claude-User', company: 'Anthropic', purpose: 'Live user requests' },
    { token: 'PerplexityBot', company: 'Perplexity', purpose: 'Indexing and crawling' },
    { token: 'Perplexity-User', company: 'Perplexity', purpose: 'Live user requests' },
    { token: 'Google-Extended', company: 'Google', purpose: 'Gemini training / AI grounding' },
    { token: 'Applebot-Extended', company: 'Apple', purpose: 'Apple Intelligence training' },
    { token: 'CCBot', company: 'Common Crawl', purpose: 'Open dataset for many AI labs' }
  ];

  function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;'); }

  function parseRobots(text) {
    var lines = text.split('\n').map(function (l) { return l.trim(); });
    var groups = [];
    var current = null;
    lines.forEach(function (line) {
      if (!line || line.indexOf('#') === 0) return;
      var idx = line.indexOf(':');
      if (idx === -1) return;
      var field = line.slice(0, idx).trim().toLowerCase();
      var value = line.slice(idx + 1).trim();
      if (field === 'user-agent') {
        if (!current || current.rules.length) { current = { agents: [], rules: [] }; groups.push(current); }
        current.agents.push(value);
      } else if ((field === 'disallow' || field === 'allow') && current) {
        current.rules.push({ type: field, path: value });
      }
    });
    return groups;
  }

  function statusFor(token, groups) {
    var exact = groups.find(function (g) { return g.agents.some(function (a) { return a.toLowerCase() === token.toLowerCase(); }); });
    var group = exact;
    var usedWildcard = false;
    if (!group) {
      group = groups.find(function (g) { return g.agents.indexOf('*') !== -1; });
      usedWildcard = true;
    }
    if (!group || !group.rules.length) return { blocked: false, usedWildcard: usedWildcard, noRule: true };
    var blocksRoot = group.rules.some(function (r) { return r.type === 'disallow' && (r.path === '/' || r.path === ''); });
    var allowsRoot = group.rules.some(function (r) { return r.type === 'allow' && (r.path === '/' || r.path === ''); });
    if (blocksRoot && !allowsRoot) return { blocked: true, usedWildcard: usedWildcard, noRule: false };
    return { blocked: false, usedWildcard: usedWildcard, noRule: false };
  }

  function run() {
    var text = document.getElementById('lc-input').value.trim();
    var output = document.getElementById('lc-output');
    var status = document.getElementById('lc-status');

    if (!text) {
      output.textContent = 'Paste a robots.txt file to check it.';
      status.textContent = 'Waiting for input';
      return;
    }

    var groups = parseRobots(text);
    var blockedCount = 0;
    var rows = BOTS.map(function (bot) {
      var r = statusFor(bot.token, groups);
      if (r.blocked) blockedCount++;
      var badge, note;
      if (r.blocked) { badge = '<span style="color:#B5730E;font-weight:700;">BLOCKED</span>'; note = r.usedWildcard ? 'via wildcard (*) rule' : 'named directly'; }
      else if (r.noRule) { badge = '<span style="color:#0B807C;font-weight:700;">ALLOWED</span>'; note = 'no matching rule — default allow'; }
      else { badge = '<span style="color:#0B807C;font-weight:700;">ALLOWED</span>'; note = r.usedWildcard ? 'via wildcard (*) rule' : 'named directly'; }
      return '<div style="display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid #EAE0D2;"><div><strong>' + esc(bot.token) + '</strong><div style="font-size:0.8rem;color:#8A8371;">' + esc(bot.company) + ' — ' + esc(bot.purpose) + '</div></div><div style="text-align:right;white-space:nowrap;">' + badge + '<div style="font-size:0.75rem;color:#8A8371;">' + note + '</div></div></div>';
    });

    output.innerHTML = rows.join('');
    status.textContent = (BOTS.length - blockedCount) + ' of ' + BOTS.length + ' AI crawlers allowed';
  }

  document.getElementById('lc-input').addEventListener('input', run);
  run();
})();
</script>
