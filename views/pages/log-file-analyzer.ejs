<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var current = '';
  var LINE = /^(\S+) \S+ \S+ \[([^\]]+)\] "([A-Z]+) (\S+)(?: [^"]*)?" (\d{3}) (\S+)(?: "([^"]*)" "([^"]*)")?/;

  function parse(text) {
    var rows = [], bad = 0;
    text.split(/\r?\n/).forEach(function (l) {
      if (!l.trim()) return;
      var m = LINE.exec(l);
      if (!m) { bad++; return; }
      var d = m[2].split(':')[0];
      rows.push({ ip: m[1], day: d, method: m[3], url: m[4], status: +m[5], ua: (m[8] || '').toLowerCase() });
    });
    return { rows: rows, bad: bad };
  }

  function top(map, n) { return Object.keys(map).sort(function (a, b) { return map[b] - map[a]; }).slice(0, n); }

  function render() {
    var text = $('lf-input').value;
    if (!text.trim()) { $('lf-output').textContent = 'Paste log lines to start.'; $('lf-notes').innerHTML = ''; $('lf-status').textContent = 'Waiting for input'; current = ''; return; }
    var p = parse(text), rows = p.rows;
    if (!rows.length) { $('lf-output').textContent = 'No readable lines. This tool reads the combined log format used by Apache and Nginx.'; $('lf-status').textContent = 'No lines read'; current = ''; return; }
    var re = new RegExp($('lf-bot').value, 'i');
    var bot = rows.filter(function (r) { return re.test(r.ua); });
    var codes = {}, urls = {}, bad404 = {}, err5 = {}, redir = {}, days = {}, params = 0, files = {};
    bot.forEach(function (r) {
      var cls = Math.floor(r.status / 100) + 'xx'; codes[cls] = (codes[cls] || 0) + 1;
      urls[r.url] = (urls[r.url] || 0) + 1;
      if (r.status === 404 || r.status === 410) bad404[r.url] = (bad404[r.url] || 0) + 1;
      if (r.status >= 500) err5[r.url] = (err5[r.url] || 0) + 1;
      if (r.status >= 300 && r.status < 400) redir[r.url] = (redir[r.url] || 0) + 1;
      if (r.url.indexOf('?') !== -1) params++;
      days[r.day] = (days[r.day] || 0) + 1;
      var ext = (r.url.split('?')[0].match(/\.([a-z0-9]{2,5})$/i) || [0, 'page'])[1].toLowerCase(); files[ext] = (files[ext] || 0) + 1;
    });
    var uniq = Object.keys(urls).length, n = bot.length;
    var pct = function (x) { return n ? Math.round(x / n * 100) + '%' : '0%'; };
    var L = [];
    L.push('LOG FILE REPORT'); L.push('');
    L.push('Lines read: ' + rows.length + '   Unreadable lines: ' + p.bad);
    L.push('Requests from selected crawler: ' + n + ' (' + Math.round(n / rows.length * 100) + '% of all)   Unique URLs: ' + uniq);
    if (n) {
      L.push('Status: 2xx ' + (codes['2xx'] || 0) + ' (' + pct(codes['2xx'] || 0) + ')   3xx ' + (codes['3xx'] || 0) + ' (' + pct(codes['3xx'] || 0) + ')   4xx ' + (codes['4xx'] || 0) + ' (' + pct(codes['4xx'] || 0) + ')   5xx ' + (codes['5xx'] || 0) + ' (' + pct(codes['5xx'] || 0) + ')');
      L.push('Requests to URLs with a query string: ' + params + ' (' + pct(params) + ')');
      L.push(''); L.push('TOP URLS CRAWLED'); top(urls, 10).forEach(function (u) { L.push('  ' + urls[u] + '  ' + u); });
      function block(title, map) { var k = top(map, 8); if (k.length) { L.push(''); L.push(title); k.forEach(function (u) { L.push('  ' + map[u] + '  ' + u); }); } }
      block('404 / 410 URLS', bad404); block('5xx URLS', err5); block('REDIRECTED URLS (3xx)', redir);
      L.push(''); L.push('BY FILE TYPE'); top(files, 8).forEach(function (e) { L.push('  ' + e + ': ' + files[e]); });
      L.push(''); L.push('BY DAY'); Object.keys(days).sort().slice(0, 14).forEach(function (d) { L.push('  ' + d + ': ' + days[d]); });
    }
    current = L.join('\n'); $('lf-output').textContent = current;
    var notes = [];
    if (!n) notes.push('No requests matched that crawler. Check the crawler choice or that your log includes the user agent field.');
    if (n && (codes['4xx'] || 0) / n > 0.05) notes.push('<strong>More than 5% of crawler requests returned 4xx.</strong> Review the 404 list: fix links to URLs that should exist and redirect moved ones.');
    if (n && (codes['5xx'] || 0)) notes.push('<strong>The crawler received 5xx errors.</strong> Server errors can slow crawling. Check what failed at those times.');
    if (n && params / n > 0.2) notes.push('<strong>Over 20% of crawler hits go to URLs with parameters.</strong> Look for filters, sessions or tracking parameters that create many URLs.');
    if (p.bad / (rows.length + p.bad) > 0.1) notes.push('Some lines could not be read, so your log may use a custom format.');
    notes.push('This matches the user-agent text only. User agents can be faked, so verify Googlebot as Google documents.');
    $('lf-notes').innerHTML = '<ul style="padding-left:18px;margin:0;"><li>' + notes.join('</li><li>') + '</li></ul>';
    $('lf-status').textContent = n + ' crawler request' + (n === 1 ? '' : 's');
  }

  $('lf-input').addEventListener('input', render);
  $('lf-bot').addEventListener('change', render);
  $('lf-file').addEventListener('change', function (e) { var f = e.target.files[0]; if (!f) return; var rd = new FileReader(); rd.onload = function () { $('lf-input').value = String(rd.result).slice(0, 8000000); render(); }; rd.readAsText(f); });
  $('lf-copy').addEventListener('click', function () { if (current && navigator.clipboard) navigator.clipboard.writeText(current); });
  $('lf-download').addEventListener('click', function () { if (!current) return; var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([current], { type: 'text/plain' })); a.download = 'log-file-report.txt'; a.click(); });
})();
</script>
