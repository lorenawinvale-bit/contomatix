<script>
(function () {
  function countSyllables(word) {
    word = word.toLowerCase().replace(/[^a-z]/g, '');
    if (!word) return 0;
    if (word.length <= 3) return 1;
    word = word.replace(/(?:[^laeiouy]es|ed|[^laeiouy]e)$/, '');
    word = word.replace(/^y/, '');
    var matches = word.match(/[aeiouy]{1,2}/g);
    return matches ? matches.length : 1;
  }

  function analyze(text) {
    var words = (text.match(/[A-Za-z0-9'-]+/g) || []);
    var sentences = (text.match(/[^.!?]+[.!?]+/g) || (text.trim() ? [text] : []));
    var wordCount = words.length;
    var sentenceCount = Math.max(sentences.length, wordCount ? 1 : 0);
    var syllableCount = words.reduce(function (sum, w) { return sum + countSyllables(w); }, 0);
    var avgWordsPerSentence = sentenceCount ? wordCount / sentenceCount : 0;
    var avgSyllablesPerWord = wordCount ? syllableCount / wordCount : 0;
    var flesch = wordCount && sentenceCount
      ? 206.835 - 1.015 * avgWordsPerSentence - 84.6 * avgSyllablesPerWord
      : null;
    var passivePattern = /\b(is|are|was|were|be|been|being)\s+(?:\w+ly\s+){0,2}\w+ed\b/gi;
    var passiveCount = (text.match(passivePattern) || []).length;
    return {
      wordCount: wordCount,
      sentenceCount: sentenceCount,
      avgWordsPerSentence: avgWordsPerSentence,
      flesch: flesch,
      passiveCount: passiveCount
    };
  }

  function scoreLabel(score) {
    if (score >= 90) return { label: 'Very easy to read', color: '#0EA5A0' };
    if (score >= 60) return { label: 'Plain English', color: '#0EA5A0' };
    if (score >= 30) return { label: 'Fairly difficult', color: '#F59E0B' };
    return { label: 'Very difficult', color: '#D9534F' };
  }

  function build() {
    var text = document.getElementById('rd-content').value;
    var keyword = document.getElementById('rd-keyword').value.trim().toLowerCase();
    var status = document.getElementById('rd-status');

    if (!text.trim()) {
      document.getElementById('rd-score-num').textContent = '–';
      document.getElementById('rd-score-label').textContent = 'No content yet';
      document.getElementById('rd-score-sub').textContent = 'Paste content on the left to see your score';
      document.getElementById('rd-score-circle').style.borderColor = 'var(--border-light)';
      ['rd-words', 'rd-sentences', 'rd-avg-words'].forEach(function (id) { document.getElementById(id).textContent = '0'; });
      document.getElementById('rd-reading-time').textContent = '0 min';
      document.getElementById('rd-density').textContent = '–';
      document.getElementById('rd-passive').textContent = '0';
      status.textContent = 'Paste content to analyze';
      return;
    }

    var a = analyze(text);
    var scoreRounded = a.flesch !== null ? Math.max(0, Math.min(100, Math.round(a.flesch))) : 0;
    var info = scoreLabel(scoreRounded);

    document.getElementById('rd-score-num').textContent = scoreRounded;
    document.getElementById('rd-score-circle').style.borderColor = info.color;
    document.getElementById('rd-score-label').textContent = info.label;
    document.getElementById('rd-score-sub').textContent = 'Flesch Reading Ease: ' + scoreRounded + ' / 100';
    document.getElementById('rd-words').textContent = a.wordCount;
    document.getElementById('rd-sentences').textContent = a.sentenceCount;
    document.getElementById('rd-avg-words').textContent = a.avgWordsPerSentence.toFixed(1);
    document.getElementById('rd-reading-time').textContent = Math.max(1, Math.round(a.wordCount / 200)) + ' min';
    document.getElementById('rd-passive').textContent = a.passiveCount;

    if (keyword && a.wordCount) {
      var kwWords = keyword.split(/\s+/).length;
      var re = new RegExp(keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
      var occurrences = (text.match(re) || []).length;
      var density = ((occurrences * kwWords) / a.wordCount) * 100;
      document.getElementById('rd-density').textContent = density.toFixed(1) + '% (' + occurrences + 'x)';
    } else {
      document.getElementById('rd-density').textContent = keyword ? '0%' : '–';
    }

    status.textContent = 'Updated';
  }

  document.getElementById('rd-content').addEventListener('input', build);
  document.getElementById('rd-keyword').addEventListener('input', build);
})();
</script>
