<section>
  <div class="container contact-grid llms-tool-grid">
    <div>
      <form class="contact-form llms-form" id="rt-form" onsubmit="return false;" aria-label="Robots.txt generator form">
        <div>
          <label for="rt-mode">Default rule for all crawlers</label>
          <select id="rt-mode">
            <option value="allow">Allow all crawling (recommended for most sites)</option>
            <option value="disallow">Block all crawling (site not ready for indexing)</option>
            <option value="custom">Custom — I'll set specific rules below</option>
          </select>
        </div>
        <div data-group="custom" hidden>
