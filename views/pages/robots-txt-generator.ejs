<script>
(function () {
  var AI_BOTS = ['GPTBot', 'CCBot', 'ClaudeBot', 'Google-Extended', 'anthropic-ai', 'ChatGPT-User'];

  function showGroup(mode) {
    document.querySelector('[data-group="custom"]').hidden = mode !== 'custom';
  }

  function build() {
    var mode = document.getElementById('rt-mode').value;
    var blockAI = document.getElementById('rt-block-ai').checked;
    var sitemap = document.getElementById('rt-sitemap').value.trim();
    var lines = [];

    if (mode === 'allow') {
      lines.push('User-agent: *');
      lines.push('Allow: /');
    } else if (mode === 'disallow') {
      lines.push('User-agent: *');
      lines.push('Disallow: /');
    } else {
      var paths = document.getElementById('rt-disallow').value.split('\n').map(function (l) { return l.trim(); }).filter(Boolean);
      lines.push('User-agent: *');
      if (paths.length) {
        paths.forEach(function (p) { lines.push('Disallow: ' + p); });
      } else {
        lines.push('Allow: /');
      }
    }

    if (blockAI) {
      lines.push('');
      AI_BOTS.forEach(function (bot) {
        lines.push('User-agent: ' + bot);
        lines.push('Disallow: /');
      });
    }

    if (sitemap) {
      lines.push('');
      lines.push('Sitemap: ' + sitemap);
    }

    var text = lines.join('\n') + '\n';
    document.getElementById('rt-output').textContent = text;
    document.getElementById('rt-status').textContent = 'Updated';
    return text;
  }

  document.getElementById('rt-mode').addEventListener('change', function (e) {
    showGroup(e.target.value);
    build();
  });
  document.querySelectorAll('#rt-form input, #rt-form textarea').forEach(function (el) {
    el.addEventListener('input', build);
  });

  document.getElementById('rt-copy').addEventListener('click', function () {
    navigator.clipboard.writeText(document.getElementById('rt-output').textContent).then(function () {
      var status = document.getElementById('rt-status');
      status.textContent = 'Copied!';
      setTimeout(function () { status.textContent = 'Updated'; }, 1800);
    });
  });

  document.getElementById('rt-download').addEventListener('click', function () {
    var text = document.getElementById('rt-output').textContent;
    var blob = new Blob([text], { type: 'text/plain' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'robots.txt';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  build();
})();
</script>
