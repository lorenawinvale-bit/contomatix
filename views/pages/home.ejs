<section class="hero">
  <div id="hero-canvas" class="hero-canvas"></div>
  <div class="container hero-center">
    <div class="hero-badge"><span class="spark">✦</span> White-hat link building &amp; SEO</div>
    <h1>Rankings built on <span class="grad-text">real authority</span>,<br>not <span class="grad-text-warm">shortcuts</span></h1>
    <p class="hero-sub">Contomatix helps brands grow organic traffic through link building, guest posting, on-page &amp; off-page SEO, and keyword research that actually moves the needle.</p>
    <div class="hero-actions">
      <a href="/contact" class="btn btn-primary">Get a free audit &rarr;</a>
      <a href="/services/link-building" class="btn btn-outline">Explore services</a>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><span class="num">5</span><span class="label">Core services</span></div>
      <div class="hero-stat"><span class="num">100%</span><span class="label">White-hat</span></div>
      <div class="hero-stat"><span class="num">24/7</span><span class="label">Support</span></div>
    </div>
  </div>
  <div class="hero-shot">
    <div class="hero-shot-frame">
      <img src="/images/hero-dashboard.svg" alt="SEO dashboard showing organic traffic and keyword rankings going up" width="1200" height="660" fetchpriority="high">
    </div>
  </div>
</section>

<div class="trust-strip">
  <div class="container">
    <p class="trust-label">Campaigns powered by industry-standard SEO platforms</p>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>Ahrefs</span><i>◆</i><span>Semrush</span><i>◆</i><span>Moz</span><i>◆</i><span>Google Search Console</span><i>◆</i><span>Majestic</span><i>◆</i><span>Screaming Frog</span><i>◆</i><span>Surfer</span><i>◆</i><span>Google Analytics</span><i>◆</i>
      <span>Ahrefs</span><i>◆</i><span>Semrush</span><i>◆</i><span>Moz</span><i>◆</i><span>Google Search Console</span><i>◆</i><span>Majestic</span><i>◆</i><span>Screaming Frog</span><i>◆</i><span>Surfer</span><i>◆</i><span>Google Analytics</span><i>◆</i>
    </div>
  </div>
</div>

<section class="services">
  <span class="deco-blob deco-blob-1" aria-hidden="true"></span>
  <span class="deco-blob deco-blob-2" aria-hidden="true"></span>
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">Full SEO strategy</span>
      <h2>One connected strategy — not one-off links</h2>
      <p>Five services that compound with each other: research finds the targets, content and links build the authority, on-page work makes it stick.</p>
    </div>

    <%
    var serviceArt = {
      'link-building':    { img: '/images/illus-links.svg',     chip: '🔗 Manually vetted placements' },
      'guest-posting':    { img: '/images/illus-guestpost.svg', chip: '✍️ Original, editor-approved' },
      'on-page-seo':      { img: '/images/illus-onpage.svg',    chip: '✅ Built to Google\'s own guidelines' },
      'off-page-seo':     { img: '/images/illus-offpage.svg',   chip: '🌍 Authority beyond your site' },
      'keyword-research': { img: '/images/illus-keyword.svg',   chip: '🎯 Real search-intent research' }
    };
    %>
    <div class="service-rows">
      <% services.forEach(function(s, i) { %>
        <div class="service-row <%= i % 2 === 1 ? 'flip' : '' %>">
          <div class="sr-copy">
            <span class="sr-badge"><span class="sr-num">0<%= i + 1 %></span> <%= i === 0 ? '★ Flagship service' : 'Core service' %></span>
            <h3><%
              var words = s.title.split(' ');
              var last = words.pop();
            %><%= words.join(' ') %> <span class="grad-text"><%= last %></span></h3>
            <p class="sr-lead"><%= s.description %></p>
            <ul class="sr-points">
              <% s.points.forEach(function(pt) { %>
                <li><%= pt %></li>
              <% }); %>
            </ul>
            <div class="sr-actions">
              <a href="/services/<%= s.slug %>" class="btn btn-primary">Explore <%= s.title %> &rarr;</a>
              <a href="/contact" class="btn btn-outline">Get a free audit</a>
            </div>
          </div>
          <div class="sr-media">
            <img src="<%= serviceArt[s.slug].img %>" alt="<%= s.title %> illustration" width="760" height="560" loading="lazy">
            <span class="sr-chip"><%= serviceArt[s.slug].chip %></span>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="compare-section">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">The difference</span>
      <h2>Before vs. with Contomatix</h2>
      <p>Drag the slider — this is what a sustained white-hat campaign does to a site's analytics.</p>
    </div>
    <%- include('../partials/compare') %>
  </div>
</section>

<section class="process">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">How it works</span>
      <h2>A simple, transparent process</h2>
    </div>
    <div class="process-list">
      <div class="process-step"><span class="step-num">01</span><h4>Audit</h4><p>We review your site, backlink profile, and competitors.</p></div>
      <div class="process-step"><span class="step-num">02</span><h4>Strategy</h4><p>A roadmap prioritized around the keywords and links that matter most.</p></div>
      <div class="process-step"><span class="step-num">03</span><h4>Execution</h4><p>Outreach, content, and on-page work carried out and tracked.</p></div>
      <div class="process-step"><span class="step-num">04</span><h4>Reporting</h4><p>Monthly reporting so you always know what's working.</p></div>
    </div>
  </div>
</section>

<section class="stats-band">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">Published, not promised</span>
      <h2>Numbers you can actually check</h2>
      <p>Rather than cite client results you can't verify, here's our own public output.</p>
    </div>
    <div class="stats-grid">
      <div class="stat-big"><span class="num" data-count="<%= postCount %>">0</span><span class="suffix">+</span><label>Guides published</label></div>
      <div class="stat-big"><span class="num" data-count="<%= marketCount %>">0</span><span class="suffix"></span><label>Markets hand-verified</label></div>
      <div class="stat-big"><span class="num" data-count="<%= services.length %>">0</span><span class="suffix"></span><label>Core services</label></div>
      <div class="stat-big"><span class="num" data-count="100">0</span><span class="suffix">%</span><label>White-hat, always</label></div>
    </div>
  </div>
</section>

<section class="latest-guides">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">From the blog</span>
      <h2>Recent guides</h2>
      <p>Real, published research — the same city and industry guides referenced in the stats above.</p>
    </div>
    <div class="latest-guides-grid">
      <% latestPosts.forEach(function(p) { %>
        <a class="story-card" href="/blog/<%= p.slug %>">
          <div class="story-thumb">
            <% if (p.image) { %><img src="<%= p.image %>" alt="" width="192" height="152" loading="lazy"><% } %>
          </div>
          <div>
            <span class="story-tag"><%= p.category %></span>
            <div class="story-date">Published <%= p.date %></div>
            <h3><%= p.title %></h3>
          </div>
        </a>
      <% }); %>
    </div>
    <div class="hero-actions" style="justify-content:center; margin-top:28px;">
      <a href="/blog" class="btn btn-outline">Read all guides &rarr;</a>
    </div>
  </div>
</section>

<section class="faq">
  <%
  var homeFaqs = [
    { q: 'How long until I see results?', a: 'Most sites see meaningful keyword movement within 3–6 months. Link building compounds: early links start the momentum, and rankings accelerate as authority builds. We set realistic milestones in your first-month roadmap.' },
    { q: 'Are your links white-hat and safe?', a: 'Yes. Every placement is on a real site with real organic traffic, earned through manual outreach. No PBNs, no link farms, no automated schemes — nothing that puts your domain at risk.' },
    { q: 'Do you place links in existing articles too, or only new ones?', a: 'Both. Our link building service covers outreach-earned placements in new content as well as insertions inside existing, already-ranking articles — whichever passes authority to your site faster for a given target.' },
    { q: 'Do you guarantee #1 rankings?', a: "No — and you should be wary of anyone who does. Google's algorithm isn't for sale. What we do guarantee: real links on vetted sites, transparent reporting, and a strategy adjusted monthly based on what the data shows." },
    { q: 'Can I approve sites before links go live?', a: 'Yes. You get the target list with metrics (DR, traffic, niche) before we place anything, and a live link sheet you can check at any time.' },
    { q: 'How do we get started?', a: "Send us your site through the contact form or WhatsApp. We'll run a free audit of your backlink profile and keywords, then send a plan tailored to your niche — no obligation." }
  ];
  %>
  <div class="container faq-inner">
    <div class="section-head centered">
      <span class="eyebrow">FAQs</span>
      <h2>Questions, answered</h2>
    </div>
    <div class="faq-list">
      <% homeFaqs.forEach(function(f) { %>
        <details>
          <summary><%= f.q %><span class="faq-icon"></span></summary>
          <p><%= f.a %></p>
        </details>
      <% }); %>
    </div>
  </div>

  <script type="application/ld+json">
    <%- JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: homeFaqs.map(function(f) {
        return {
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a }
        };
      })
    }) %>
  </script>
</section>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Contomatix',
    url: site.baseUrl,
    description: 'Contomatix helps brands grow organic traffic through link building, guest posting, on-page & off-page SEO, and keyword research.',
    publisher: { '@id': site.baseUrl + '/#organization' },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: site.baseUrl + '/blog?q={search_term_string}' },
      'query-input': 'required name=search_term_string'
    }
  }) %>
</script>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Contomatix Core Services',
    itemListElement: services.map(function(s, i) {
      return {
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Service',
          name: s.title,
          description: s.summary,
          url: site.baseUrl + '/services/' + s.slug,
          provider: { '@id': site.baseUrl + '/#organization' }
        }
      };
    })
  }) %>
</script>

<section class="cta">
  <div class="container">
    <div class="cta-band">
      <span class="cta-orb cta-orb-1"></span>
      <span class="cta-orb cta-orb-2"></span>
      <span class="cta-orb cta-orb-3"></span>
      <h2>Ready to <span class="grad-text">grow your rankings</span>?</h2>
      <p>Tell us about your site and goals — we'll put together a free audit and a plan tailored to your niche.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">Get a free audit &rarr;</a>
        <a href="https://wa.me/<%= site.whatsappNumber %>" target="_blank" rel="noopener" class="btn btn-glass">Chat on WhatsApp</a>
      </div>
      <p class="cta-note">Free audit · No obligation · Reply within 24 hours</p>
    </div>
  </div>
</section>
