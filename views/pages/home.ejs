<%- include('../partials/lab-hero') %>

<%- include('../partials/tools-video') %>

<%- include('../partials/link-duo') %>

<%- include('../partials/dashboard') %>


<section class="lab-try">
  <style>
  .lab-try{padding:64px 0 8px}
  .lab-try-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:48px;align-items:center}
  .lab-try .k{font-family:var(--font-mono);font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-teal-dim);font-weight:700}
  .lab-try h2{font-family:var(--font-display);font-size:clamp(1.8rem,3.4vw,2.7rem);line-height:1.08;letter-spacing:-.02em;margin:12px 0 14px}
  .lab-try p{color:var(--text-dim);max-width:50ch;margin:0 0 10px}
  .lab-try .hero-vet{max-width:460px;margin:0 auto;width:100%}
  @media (max-width:900px){.lab-try-grid{grid-template-columns:1fr;gap:28px}}
  </style>
  <div class="container lab-try-grid">
    <div>
      <span class="k">Now you try</span>
      <h2>Judge a link the way we do</h2>
      <p>Picture a site that could link to you. Tick what is true and watch the verdict change. These are the same four checks we run by hand on every target before any outreach.</p>
      <p>If a site fails, we do not pitch it. That is how a campaign stays free of risky links.</p>
    </div>
    <div class="hero-vet"><%- include('../partials/vet-widget', { widgetId: 'vet-home' }) %></div>
  </div>
</section>


<section class="services">
  <span class="deco-blob deco-blob-1" aria-hidden="true"></span>
  <span class="deco-blob deco-blob-2" aria-hidden="true"></span>
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">Full SEO strategy</span>
      <h2>One connected strategy: not one-off links</h2>
      <p>Services that compound with each other: research finds the targets, content and links build the authority, on-page and technical work make it stick.</p>
    </div>

    <%- include('../partials/service-grid', { services: services }) %>
  </div>
</section>

<section class="compare-section">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">The difference</span>
      <h2>Before vs. with Contomatix</h2>
      <p>Drag the slider, an illustrative example of what a sustained white-hat campaign is meant to do to a site's analytics.</p>
    </div>
    <%- include('../partials/compare') %>
  </div>
</section>

<section class="process">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">How it works</span>
      <h2>A simple, transparent process</h2>
    </div>
    <div class="process-list">
      <div class="process-step"><span class="step-num">01</span><h3>Audit</h3><p>We review your site, backlink profile, and competitors.</p></div>
      <div class="process-step"><span class="step-num">02</span><h3>Strategy</h3><p>A roadmap prioritized around the keywords and links that matter most.</p></div>
      <div class="process-step"><span class="step-num">03</span><h3>Execution</h3><p>Outreach, content, and on-page work carried out and tracked.</p></div>
      <div class="process-step"><span class="step-num">04</span><h3>Reporting</h3><p>Monthly reporting so you always know what's working.</p></div>
    </div>
  </div>
</section>

<section class="stats-band">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">Published, not promised</span>
      <h2>Numbers you can actually check</h2>
      <p>Rather than cite client results you can't verify, here's our own public output.</p>
    </div>
    <div class="stats-grid">
      <div class="stat-big"><span class="num" data-count="<%= postCount %>"><%= postCount %></span><span class="suffix">+</span><label>Guides published</label></div>
      <div class="stat-big"><span class="num" data-count="<%= marketCount %>"><%= marketCount %></span><span class="suffix"></span><label>Markets hand-verified</label></div>
      <div class="stat-big"><span class="num" data-count="<%= services.length %>"><%= services.length %></span><span class="suffix"></span><label>Core services</label></div>
      <div class="stat-big"><span class="num" data-count="100">100</span><span class="suffix">%</span><label>White-hat, always</label></div>
    </div>
  </div>
</section>

<section class="latest-guides">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">From the blog</span>
      <h2>Recent guides</h2>
      <p>Real, published research, the same city and industry guides referenced in the stats above.</p>
    </div>
    <%    var gpal = { 'Link Building': ['#0EA5A0', '#E3F5F2', '#C5EAE4'], 'On-Page SEO': ['#D97706', '#FDF1DA', '#FADFB0'], 'Keyword Research': ['#DB2777', '#FCE8F1', '#F8CFE1'], 'Technical SEO': ['#334155', '#E7ECF3', '#D3DCE8'], 'Content Strategy': ['#B45309', '#FBEBD3', '#F6D5A5'], 'SEO Reporting': ['#0E7490', '#E1F3F7', '#C3E6EE'] };
    %>
    <div class="latest-guides-grid gx">
      <% latestPosts.forEach(function (p, gi) { var c = gpal[p.category] || gpal['Link Building']; %>
        <a class="gx-card gx-pro<%= gi === 0 ? ' gx-feat' : '' %>" href="/blog/<%= p.slug %>" style="--c:<%= c[0] %>;--i:<%= gi %>">
          <div class="gx-img"><img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy" decoding="async"></div>
          <div class="gx-body">
            <div class="gx-meta"><span class="gx-cat"><%= p.category %></span><span><%= p.date %></span></div>
            <h3><%= p.title %></h3>
            <p class="gx-ex"><%= (p.excerpt || '').length > 130 ? p.excerpt.slice(0, 127).replace(/s+S*$/, '') + '...' : p.excerpt %></p>
            <span class="gx-go">Read the guide <u>&rarr;</u></span>
          </div>
        </a>
      <% }); %>
    </div>
    <div class="hero-actions" style="justify-content:center; margin-top:28px;">
      <a href="/blog" class="btn btn-outline">Read all guides &rarr;</a>
    </div>
  </div>
</section>

<section class="faq">
  <%
  var homeFaqs = [
    { q: 'How long until I see results?', a: 'Most sites see meaningful keyword movement within 3–6 months. Link building compounds: early links start the momentum, and rankings accelerate as authority builds. We set realistic milestones in your first-month roadmap.' },
    { q: 'Are your links white-hat and safe?', a: 'Yes. Every placement is on a real site with real organic traffic, earned through manual outreach. No PBNs, no link farms, no automated schemes, nothing that puts your domain at risk.' },
    { q: 'Do you place links in existing articles too, or only new ones?', a: 'Both. Our link building service covers outreach-earned placements in new content as well as insertions inside existing, already-ranking articles, whichever passes authority to your site faster for a given target.' },
    { q: 'Do you guarantee #1 rankings?', a: "No, and you should be wary of anyone who does. Google's algorithm isn't for sale. What we do guarantee: real links on vetted sites, transparent reporting, and a strategy adjusted monthly based on what the data shows." },
    { q: 'Can I approve sites before links go live?', a: 'Yes. You get the target list with metrics (DR, traffic, niche) before we place anything, and a live link sheet you can check at any time.' },
    { q: 'How do we get started?', a: "Send us your site through the contact form or WhatsApp. We'll run a free audit of your backlink profile and keywords, then send a plan tailored to your niche, no obligation." }
  ];
  %>
  <div class="container faq-inner">
    <div class="section-head centered">
      <span class="eyebrow">FAQs</span>
      <h2>Questions, answered</h2>
    </div>
    <div class="faq-list">
      <% homeFaqs.forEach(function(f) { %>
        <details>
          <summary><%= f.q %><span class="faq-icon"></span></summary>
          <p><%= f.a %></p>
        </details>
      <% }); %>
    </div>
  </div>

  <script type="application/ld+json">
    <%- JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: homeFaqs.map(function(f) {
        return {
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a }
        };
      })
    }) %>
  </script>
</section>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Contomatix',
    url: site.baseUrl,
    description: 'Contomatix helps brands grow organic traffic and AI search visibility through link building, technical & on-page SEO, and AI SEO.',
    publisher: { '@id': site.baseUrl + '/#organization' },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: site.baseUrl + '/blog?q={search_term_string}' },
      'query-input': 'required name=search_term_string'
    }
  }) %>
</script>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Contomatix Core Services',
    itemListElement: services.map(function(s, i) {
      return {
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Service',
          name: s.title,
          description: s.summary,
          url: site.baseUrl + '/services/' + s.slug,
          provider: { '@id': site.baseUrl + '/#organization' }
        }
      };
    })
  }) %>
</script>

<section class="cta">
  <div class="container">
    <div class="cta-band">
      <span class="cta-orb cta-orb-1"></span>
      <span class="cta-orb cta-orb-2"></span>
      <span class="cta-orb cta-orb-3"></span>
      <h2>Ready to <span class="grad-text">grow your rankings</span>?</h2>
      <p>Tell us about your site and goals, we'll put together a free audit and a plan tailored to your niche.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">Get a free audit &rarr;</a>
        <a href="https://wa.me/<%= site.whatsappNumber %>" target="_blank" rel="noopener" class="btn btn-glass">Chat on WhatsApp</a>
      </div>
      <p class="cta-note">Free audit · No obligation · Reply within 24 hours</p>
    </div>
  </div>
</section>
