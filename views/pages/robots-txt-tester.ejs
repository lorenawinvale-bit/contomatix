<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Does the tester fetch my live robots.txt?', acceptedAnswer: { '@type': 'Answer', text: 'No. Paste the contents. Browsers block most cross-site requests to other sites files, and pasting keeps your data off every server, including ours.' } },
      { '@type': 'Question', name: 'Which rule wins when Allow and Disallow both match?', acceptedAnswer: { '@type': 'Answer', text: 'The longer, more specific path wins. If both are the same length, Google uses the least restrictive rule, which is Allow.' } },
      { '@type': 'Question', name: 'Why does my URL show as allowed when I have a Disallow for its folder?', acceptedAnswer: { '@type': 'Answer', text: 'A longer Allow rule may be overriding it, or the rule may sit in a group for a different crawler. The result lists the rule that decided each URL.' } },
      { '@type': 'Question', name: 'Can I test a crawler like GPTBot or ClaudeBot?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Type the crawler name in the crawler field. If your file has no group for it, the tester falls back to the star group, as Google does.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. The rules are applied in your browser with JavaScript - nothing is uploaded, logged, or stored on any server, including ours.' } }
    ]
  }) %>
</script>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var text = '';

  function parseFile(src) {
    var groups = [], cur = null, lastWasUA = false, notes = [], sitemaps = 0;
    var lines = src.split(/\r?\n/);
    lines.forEach(function (raw, i) {
      var l = raw.replace(/#.*/, '').trim();
      if (!l) return;
      var m = /^([A-Za-z-]+)\s*:\s*(.*)$/.exec(l);
      if (!m) { notes.push('Line ' + (i + 1) + ': not a "field: value" line, ignored (' + l.slice(0, 40) + ')'); return; }
      var f = m[1].toLowerCase(), v = m[2].trim();
      if (f === 'user-agent') {
        if (!lastWasUA || !cur) { cur = { agents: [], rules: [] }; groups.push(cur); }
        cur.agents.push(v.toLowerCase());
        lastWasUA = true;
      } else if (f === 'allow' || f === 'disallow') {
        lastWasUA = false;
        if (!cur) { notes.push('Line ' + (i + 1) + ': ' + f + ' appears before any user-agent line, so it applies to no crawler'); return; }
        cur.rules.push({ type: f, path: v, line: i + 1 });
      } else if (f === 'sitemap') {
        sitemaps++;
      } else {
        notes.push('Line ' + (i + 1) + ': "' + m[1] + '" is not supported by Google and is ignored');
      }
    });
    return { groups: groups, notes: notes, sitemaps: sitemaps, bytes: new Blob([src]).size };
  }

  function chooseRules(parsed, ua) {
    var token = ua.toLowerCase();
    var best = -1, bestName = '';
    parsed.groups.forEach(function (g) {
      g.agents.forEach(function (a) {
        if (a !== '*' && token.indexOf(a) === 0 && a.length > best) { best = a.length; bestName = a; }
      });
    });
    var name = best >= 0 ? bestName : '*';
    var rules = [];
    parsed.groups.forEach(function (g) { if (g.agents.indexOf(name) !== -1) rules = rules.concat(g.rules); });
    var exists = parsed.groups.some(function (g) { return g.agents.indexOf(name) !== -1; });
    return { name: name, rules: rules, exists: exists };
  }

  function toRegex(path) {
    var end = false;
    if (path.charAt(path.length - 1) === '$') { end = true; path = path.slice(0, -1); }
    var re = path.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*');
    return new RegExp('^' + re + (end ? '$' : ''));
  }

  function pathOf(u) {
    u = u.trim();
    if (!u) return '';
    try { if (/^[a-z][a-z0-9+.-]*:\/\//i.test(u)) { var x = new URL(u); return x.pathname + x.search; } } catch (e) {}
    return u.charAt(0) === '/' ? u : '/' + u;
  }

  function decide(rules, path) {
    var best = null;
    rules.forEach(function (r) {
      if (!r.path) return;
      if (!toRegex(r.path).test(path)) return;
      var len = r.path.replace(/\$$/, '').length;
      if (!best || len > best.len || (len === best.len && r.type === 'allow' && best.type !== 'allow')) best = { type: r.type, path: r.path, line: r.line, len: len };
    });
    return best;
  }

  function run() {
    var src = $('rt-file').value, ua = $('rt-ua').value.trim() || '*';
    var urls = $('rt-urls').value.split(/\r?\n/).map(function (s) { return s.trim(); }).filter(Boolean);
    var out = $('rt-output'), status = $('rt-status');
    text = '';
    if (!src.trim()) { out.textContent = 'Paste a robots.txt and add URLs to test.'; status.textContent = 'Waiting for input'; return; }
    var parsed = parseFile(src);
    var sel = chooseRules(parsed, ua);
    var L = [];
    L.push('Crawler: ' + ua + '  ->  group used: ' + (sel.exists ? 'User-agent: ' + sel.name : 'none (no matching group, everything is allowed)'));
    if (parsed.bytes > 500 * 1024) L.push('! File is ' + Math.round(parsed.bytes / 1024) + ' KiB. Google ignores content beyond 500 KiB.');
    L.push('');
    var blocked = 0, allowed = 0;
    if (!urls.length) L.push('Add URLs or paths on the left to test them.');
    urls.forEach(function (u) {
      var p = pathOf(u), d = decide(sel.rules, p);
      var isBlocked = !!d && d.type === 'disallow';
      if (isBlocked) blocked++; else allowed++;
      L.push((isBlocked ? 'BLOCKED  ' : 'ALLOWED  ') + p);
      L.push('         ' + (d ? 'decided by line ' + d.line + ': ' + (d.type === 'allow' ? 'Allow: ' : 'Disallow: ') + d.path : (sel.exists ? 'no rule matches this path' : 'no group applies to this crawler')));
    });
    if (parsed.notes.length) { L.push(''); L.push('NOTES'); parsed.notes.slice(0, 15).forEach(function (n) { L.push('  - ' + n); }); }
    if (!parsed.groups.length) { L.push(''); L.push('! No user-agent group found, so this file blocks nothing.'); }
    text = L.join('\n');
    out.textContent = text;
    status.textContent = urls.length ? blocked + ' blocked · ' + allowed + ' allowed' : 'Rules parsed';
  }

  ['rt-file', 'rt-ua', 'rt-urls'].forEach(function (id) { $(id).addEventListener('input', run); });
  $('rt-copy').addEventListener('click', function () {
    if (!text) return;
    var b = $('rt-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
  });
  run();
})();
</script>
