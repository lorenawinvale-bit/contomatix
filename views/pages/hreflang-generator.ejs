<script>
(function () {
  function esc(s) { return (s || '').replace(/&/g, '&amp;'); }

  function parseRows(text) {
    return text.split('\n').map(function (l) { return l.trim(); }).filter(Boolean).map(function (line) {
      var parts = line.split('|').map(function (p) { return p.trim(); });
      return { lang: parts[0] || '', url: parts[1] || '' };
    }).filter(function (r) { return r.lang && r.url; });
  }

  function build() {
    var rows = parseRows(document.getElementById('hf-rows').value);
    var addDefault = document.getElementById('hf-default').checked;
    var format = document.getElementById('hf-format').value;
    var output = document.getElementById('hf-output');
    var status = document.getElementById('hf-status');

    if (!rows.length) {
      output.textContent = '<!-- Add at least one Language | URL row to generate hreflang tags -->';
      status.textContent = 'Add rows to generate';
      return;
    }

    var allRows = rows.slice();
    if (addDefault) allRows.push({ lang: 'x-default', url: rows[0].url });

    var text;
    if (format === 'html') {
      text = allRows.map(function (r) {
        return '<link rel="alternate" hreflang="' + esc(r.lang) + '" href="' + esc(r.url) + '">';
      }).join('\n');
    } else {
      text = rows.map(function (r) {
        var alts = allRows.map(function (a) {
          return '      <xhtml:link rel="alternate" hreflang="' + esc(a.lang) + '" href="' + esc(a.url) + '"/>';
        }).join('\n');
        return '  <url>\n    <loc>' + esc(r.url) + '</loc>\n' + alts + '\n  </url>';
      }).join('\n');
      text = '<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"\n        xmlns:xhtml="http://www.w3.org/1999/xhtml">\n' + text + '\n</urlset>';
    }

    output.textContent = text;
    status.textContent = 'Updated';
  }

  document.querySelectorAll('#hf-form textarea, #hf-form select, #hf-form input[type="checkbox"]').forEach(function (el) {
    el.addEventListener('input', build);
    el.addEventListener('change', build);
  });

  document.getElementById('hf-copy').addEventListener('click', function () {
    var text = document.getElementById('hf-output').textContent;
    if (!text || text.indexOf('Add at least one') !== -1) return;
    navigator.clipboard.writeText(text).then(function () {
      var status = document.getElementById('hf-status');
      status.textContent = 'Copied!';
      setTimeout(function () { status.textContent = 'Updated'; }, 1800);
    });
  });

  build();
})();
</script>
