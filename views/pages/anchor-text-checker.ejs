    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is anchor text?', acceptedAnswer: { '@type': 'Answer', text: 'It is the visible, clickable text of a link. Google says it tells people and search engines something about the page you link to.' } },
      { '@type': 'Question', name: 'What is a good anchor text distribution?', acceptedAnswer: { '@type': 'Answer', text: 'Google gives no target percentages. Natural profiles tend to contain many branded and descriptive anchors and few exact-match ones. Use the tool to spot heavy repetition or generic anchors, not to chase a ratio.' } },
      { '@type': 'Question', name: 'Does the tool fetch my backlinks?', acceptedAnswer: { '@type': 'Answer', text: 'No. It analyses only the anchors or HTML you paste. Export your anchors from Search Console or paste a page HTML.' } },
      { '@type': 'Question', name: 'Are exact match anchors bad?', acceptedAnswer: { '@type': 'Answer', text: 'Not by themselves. Repeating the same keyword-rich anchor across many links can look manipulative, and Google calls keyword stuffing a violation of its spam policies.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything is analysed in your browser with JavaScript - nothing is uploaded, logged, or stored on any server, including ours.' } }
