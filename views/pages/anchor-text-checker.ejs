<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var current = '';
  var GENERIC = /^(click here|here|read more|learn more|more|more info|this|this link|link|website|our website|visit website|visit our website|article|this article|this post|this page|page|go|source|view|see more|continue reading|details|check it out)$/i;

  function parseInput(raw) {
    var anchors = [];
    if (/<a\b[^>]*>/i.test(raw)) {
      var re = /<a\b[^>]*>([\s\S]*?)<\/a>/gi, m;
      while ((m = re.exec(raw))) {
        var t = m[1].replace(/<img[^>]*alt=["']([^"']*)["'][^>]*>/gi, '$1').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();
        anchors.push(t || '(empty or image without alt)');
      }
    } else {
      raw.split('\n').forEach(function (l) { l = l.trim(); if (l) anchors.push(l); });
    }
    return anchors;
  }

  function classify(a, brand, kws) {
    var low = a.toLowerCase(), words = a.split(/\s+/).length;
    if (a.indexOf('(empty') === 0) return 'empty';
    if (/^(https?:\/\/|www\.)\S+$/i.test(a) || /^[a-z0-9-]+(\.[a-z0-9-]+)+(\/\S*)?$/i.test(a)) return 'naked url';
    if (GENERIC.test(a)) return 'generic';
    if (brand && low.indexOf(brand) !== -1) return 'branded';
    if (kws.length && kws.indexOf(low) !== -1) return 'exact match';
    if (kws.length && kws.some(function (k) { return low.indexOf(k) !== -1; })) return 'partial match';
    if (words >= 10) return 'too long';
    return 'descriptive';
  }

  function build() {
    var anchors = parseInput($('at-input').value);
    if (!anchors.length) return null;
    var brand = $('at-brand').value.trim().toLowerCase();
    var kws = $('at-kw').value.split(',').map(function (s) { return s.trim().toLowerCase(); }).filter(Boolean);
    var counts = {}, per = {}, longList = [];
    anchors.forEach(function (a) {
      var c = classify(a, brand, kws); counts[c] = (counts[c] || 0) + 1;
      var k = a.toLowerCase(); per[k] = (per[k] || 0) + 1;
      if (a.split(/\s+/).length >= 10 && c !== 'naked url') longList.push(a);
    });
    var n = anchors.length, order = ['descriptive', 'branded', 'partial match', 'exact match', 'naked url', 'generic', 'too long', 'empty'];
    var uniq = Object.keys(per).length;
    var top = Object.keys(per).sort(function (x, y) { return per[y] - per[x]; }).slice(0, 5).filter(function (k) { return per[k] > 1; });
    var L = [];
    L.push('ANCHOR TEXT REPORT');
    L.push('');
    L.push('Anchors checked: ' + n + ' (' + uniq + ' different)');
    L.push('');
    L.push('BY TYPE');
    order.forEach(function (k) { if (counts[k]) L.push(k + ': ' + counts[k] + ' (' + (counts[k] / n * 100).toFixed(1) + '%)'); });
    if (top.length) { L.push(''); L.push('MOST REPEATED'); top.forEach(function (k) { L.push('"' + k + '": ' + per[k] + ' times (' + (per[k] / n * 100).toFixed(1) + '%)'); }); }
    if (longList.length) { L.push(''); L.push('TOO LONG (10+ words)'); longList.slice(0, 5).forEach(function (a) { L.push('- ' + (a.length > 90 ? a.slice(0, 87) + '...' : a)); }); }
    return { text: L.join('\n'), n: n, counts: counts, per: per, top: top, kws: kws.length, brand: !!brand, uniq: uniq, longCount: longList.length };
  }

  function notes(r) {
    var n = [], g = r.counts.generic || 0, e = r.counts['exact match'] || 0, tl = r.longCount || 0;
    if (g) n.push(g + ' anchor' + (g === 1 ? ' is' : 's are') + ' generic. Google lists "click here", "read more", "website" and "article" as too generic: describe the destination instead.');
    if (r.n >= 5 && e / r.n > 0.3) n.push('More than 30% of anchors are exact match. Repeating one keyword-rich anchor across many links can look manipulative; Google calls keyword stuffing a spam violation. This 30% flag is our own working threshold, not a Google rule.');
    if (r.top.length && r.per[r.top[0]] / r.n > 0.25 && r.n >= 8) n.push('"' + r.top[0] + '" makes up over a quarter of your anchors. Check that the repeated wording fits every context.');
    if (tl) n.push(tl + ' anchor' + (tl === 1 ? ' is' : 's are') + ' ten words or longer. Link only the phrase that names the destination.');
    if (!r.kws) n.push('Add keywords to see exact and partial matches, and your brand name to see branded anchors.');
    n.push('Google gives no ideal percentage for each anchor type. Use the counts to spot patterns, not to hit a ratio.');
    $('at-notes').innerHTML = n.map(function (t) { return '<div>&#9888; ' + t.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</div>'; }).join('');
  }

  function run() {
    var r = build();
    current = r ? r.text : '';
    $('at-output').textContent = r ? r.text : 'Paste some anchors to start.';
    $('at-status').textContent = r ? r.n + ' anchors checked' : 'Waiting for input';
    if (r) notes(r); else $('at-notes').innerHTML = '';
  }

  Array.prototype.slice.call($('at-form').querySelectorAll('input,textarea')).forEach(function (e) { e.addEventListener('input', run); e.addEventListener('change', run); });
  $('at-copy').addEventListener('click', function () {
    if (!current) return; var b = $('at-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(current).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
  });
  $('at-download').addEventListener('click', function () {
    if (!current) return;
    var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([current], { type: 'text/plain' })); a.download = 'anchor-text-report.txt';
    document.body.appendChild(a); a.click(); a.remove();
  });
  run();
})();
</script>
