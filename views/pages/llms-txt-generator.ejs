<script>
(function () {
  function parseRows(text) {
    return text.split('\n').map(function (line) { return line.trim(); }).filter(Boolean).map(function (line) {
      var parts = line.split('|').map(function (p) { return p.trim(); });
      return { label: parts[0] || '', url: parts[1] || '', desc: parts[2] || '' };
    });
  }

  function rowsToMarkdown(rows) {
    return rows.filter(function (r) { return r.label && r.url; }).map(function (r) {
      return '- [' + r.label + '](' + r.url + ')' + (r.desc ? ': ' + r.desc : '');
    }).join('\n');
  }

  function build() {
    var name = document.getElementById('lt-name').value.trim();
    var summary = document.getElementById('lt-summary').value.trim();
    var description = document.getElementById('lt-description').value.trim();
    var pages = rowsToMarkdown(parseRows(document.getElementById('lt-pages').value));
    var optional = rowsToMarkdown(parseRows(document.getElementById('lt-optional').value));

    if (!name) {
      document.getElementById('lt-output').textContent = '# Your llms.txt will appear here';
      document.getElementById('lt-status').textContent = 'Fill in the form to generate';
      return '';
    }

    var out = '# ' + name + '\n';
    if (summary) out += '\n> ' + summary + '\n';
    if (description) out += '\n' + description + '\n';
    if (pages) out += '\n## Pages\n\n' + pages + '\n';
    if (optional) out += '\n## Optional\n\n' + optional + '\n';

    document.getElementById('lt-output').textContent = out.trim() + '\n';
    document.getElementById('lt-status').textContent = 'Updated';
    return out.trim() + '\n';
  }

  ['lt-name', 'lt-summary', 'lt-description', 'lt-pages', 'lt-optional'].forEach(function (id) {
    document.getElementById(id).addEventListener('input', build);
  });

  document.getElementById('lt-copy').addEventListener('click', function () {
    var text = document.getElementById('lt-output').textContent;
    if (!text || text.indexOf('will appear here') !== -1) return;
    navigator.clipboard.writeText(text).then(function () {
      var status = document.getElementById('lt-status');
      status.textContent = 'Copied!';
      setTimeout(function () { status.textContent = 'Updated'; }, 1800);
    });
  });

  document.getElementById('lt-download').addEventListener('click', function () {
    var text = document.getElementById('lt-output').textContent;
    if (!text || text.indexOf('will appear here') !== -1) return;
    var blob = new Blob([text], { type: 'text/plain' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'llms.txt';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
})();
</script>
