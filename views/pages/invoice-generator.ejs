<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
(function () {
  var CURRENCY_SYMBOLS = { USD: '$', EUR: '€', GBP: '£', CAD: 'CA$', AUD: 'AU$', PKR: '₨', INR: '₹', AED: 'AED ' };
  var itemSeq = 0;

  function money(n) {
    n = isFinite(n) ? n : 0;
    return n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function formatDate(iso) {
    if (!iso) return '—';
    var parts = iso.split('-');
    var d = new Date(Date.UTC(+parts[0], +parts[1] - 1, +parts[2]));
    return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
  }

  function autoGrow(el) {
    el.rows = Math.max(el.value.split('\n').length, 1);
  }

  function addLineItem(desc, qty, rate) {
    itemSeq++;
    var row = document.createElement('div');
    row.className = 'invoice-line-item';
    row.dataset.id = itemSeq;
    row.innerHTML =
      '<textarea class="inv-item-desc" rows="1" placeholder="Service or product (Shift+Enter for a new line)">' + (desc || '') + '</textarea>' +
      '<input type="number" class="inv-item-qty" min="0" step="1" value="' + (qty != null ? qty : 1) + '">' +
      '<input type="number" class="inv-item-rate" min="0" step="0.01" value="' + (rate != null ? rate : 0) + '">' +
      '<span class="invoice-line-amount">0.00</span>' +
      '<button type="button" class="invoice-remove-line" aria-label="Remove line item">&times;</button>';
    document.getElementById('inv-items').appendChild(row);
    var desc_el = row.querySelector('.inv-item-desc');
    autoGrow(desc_el);
    row.querySelectorAll('input, textarea').forEach(function (el) { el.addEventListener('input', render); });
    desc_el.addEventListener('input', function () { autoGrow(desc_el); });
    row.querySelector('.invoice-remove-line').addEventListener('click', function () {
      row.remove();
      render();
    });
  }

  function render() {
    var symbol = CURRENCY_SYMBOLS[document.getElementById('inv-currency').value] || '$';

    var fromName = document.getElementById('inv-from-name').value.trim() || 'Your Company Name';
    var fromAddress = document.getElementById('inv-from-address').value.trim();
    var fromEmail = document.getElementById('inv-from-email').value.trim();
    var fromPhone = document.getElementById('inv-from-phone').value.trim();
    document.getElementById('inv-prev-from-name').textContent = fromName;
    document.getElementById('inv-prev-from-address').textContent = fromAddress;
    document.getElementById('inv-prev-from-email').textContent = fromEmail;
    document.getElementById('inv-prev-from-phone').textContent = fromPhone;

    var toName = document.getElementById('inv-to-name').value.trim() || 'Client Name';
    var toAddress = document.getElementById('inv-to-address').value.trim();
    var toEmail = document.getElementById('inv-to-email').value.trim();
    document.getElementById('inv-prev-to-name').textContent = toName;
    document.getElementById('inv-prev-to-address').textContent = toAddress;
    document.getElementById('inv-prev-to-email').textContent = toEmail;

    document.getElementById('inv-prev-number').textContent = document.getElementById('inv-number').value.trim() || 'INV-0001';
    document.getElementById('inv-prev-issue-date').textContent = formatDate(document.getElementById('inv-issue-date').value);
    document.getElementById('inv-prev-due-date').textContent = formatDate(document.getElementById('inv-due-date').value);

    var subtotal = 0;
    var tbody = document.getElementById('inv-prev-items');
    tbody.innerHTML = '';
    document.querySelectorAll('#inv-items .invoice-line-item').forEach(function (row) {
      var desc = row.querySelector('.inv-item-desc').value.trim() || 'Item';
      var qty = parseFloat(row.querySelector('.inv-item-qty').value) || 0;
      var rate = parseFloat(row.querySelector('.inv-item-rate').value) || 0;
      var amount = qty * rate;
      subtotal += amount;
      row.querySelector('.invoice-line-amount').textContent = symbol + money(amount);

      var tr = document.createElement('tr');
      tr.innerHTML = '<td></td><td>' + qty + '</td><td>' + symbol + money(rate) + '</td><td>' + symbol + money(amount) + '</td>';
      tr.children[0].textContent = desc;
      tbody.appendChild(tr);
    });

    var discountPct = parseFloat(document.getElementById('inv-discount').value) || 0;
    var taxPct = parseFloat(document.getElementById('inv-tax').value) || 0;
    var discountAmt = subtotal * (discountPct / 100);
    var afterDiscount = subtotal - discountAmt;
    var taxAmt = afterDiscount * (taxPct / 100);
    var total = afterDiscount + taxAmt;

    document.getElementById('inv-prev-subtotal').textContent = symbol + money(subtotal);
    document.getElementById('inv-prev-total').textContent = symbol + money(total);

    var discRow = document.getElementById('inv-prev-discount-row');
    if (discountPct > 0) {
      discRow.hidden = false;
      document.getElementById('inv-prev-discount').textContent = '-' + symbol + money(discountAmt) + ' (' + discountPct + '%)';
    } else {
      discRow.hidden = true;
    }
    var taxRow = document.getElementById('inv-prev-tax-row');
    if (taxPct > 0) {
      taxRow.hidden = false;
      document.getElementById('inv-prev-tax').textContent = symbol + money(taxAmt) + ' (' + taxPct + '%)';
    } else {
      taxRow.hidden = true;
    }

    document.getElementById('inv-prev-notes').textContent = document.getElementById('inv-notes').value.trim();
    document.getElementById('inv-status').textContent = 'Updated';
  }

  // Seed defaults: today + 14-day due date, two example line items
  var today = new Date();
  var due = new Date(today.getTime() + 14 * 24 * 60 * 60 * 1000);
  document.getElementById('inv-issue-date').value = today.toISOString().slice(0, 10);
  document.getElementById('inv-due-date').value = due.toISOString().slice(0, 10);
  addLineItem('Website design services', 1, 500);
  addLineItem('Monthly SEO retainer', 1, 750);

  document.getElementById('inv-form').addEventListener('input', render);
  document.getElementById('inv-form').addEventListener('change', render);
  document.getElementById('inv-add-item').addEventListener('click', function () { addLineItem('', 1, 0); render(); });

  document.getElementById('inv-logo').addEventListener('change', function (e) {
    var file = e.target.files && e.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (ev) {
      document.getElementById('inv-prev-logo').src = ev.target.result;
      document.getElementById('inv-prev-logo-wrap').hidden = false;
    };
    reader.readAsDataURL(file);
  });

  function buildPdf() {
    var symbol = CURRENCY_SYMBOLS[document.getElementById('inv-currency').value] || '$';
    var doc = new jspdf.jsPDF({ unit: 'pt', format: 'a4' });
    var pageWidth = doc.internal.pageSize.getWidth();
    var pageHeight = doc.internal.pageSize.getHeight();
    var margin = 48;
    var y = margin;

    var fromName = document.getElementById('inv-from-name').value.trim() || 'Your Company Name';
    var fromAddress = document.getElementById('inv-from-address').value.trim();
    var fromEmail = document.getElementById('inv-from-email').value.trim();
    var fromPhone = document.getElementById('inv-from-phone').value.trim();
    var toName = document.getElementById('inv-to-name').value.trim() || 'Client Name';
    var toAddress = document.getElementById('inv-to-address').value.trim();
    var toEmail = document.getElementById('inv-to-email').value.trim();
    var number = document.getElementById('inv-number').value.trim() || 'INV-0001';
    var issueDateFmt = formatDate(document.getElementById('inv-issue-date').value);
    var dueDateFmt = formatDate(document.getElementById('inv-due-date').value);
    var notes = document.getElementById('inv-notes').value.trim();

    // Logo (top-left), if uploaded
    var logoWrap = document.getElementById('inv-prev-logo-wrap');
    var logoImg = document.getElementById('inv-prev-logo');
    var fromX = margin;
    if (!logoWrap.hidden && logoImg.src) {
      try {
        var props = doc.getImageProperties(logoImg.src);
        var logoW = 80, logoH = (props.height / props.width) * logoW;
        doc.addImage(logoImg.src, props.fileType, margin, y, logoW, logoH);
        y += logoH + 12;
      } catch (e) { /* unreadable image data, skip logo in PDF */ }
    }

    // From block (left)
    doc.setFont('helvetica', 'bold'); doc.setFontSize(14); doc.setTextColor(20, 20, 20);
    doc.text(fromName, fromX, y + 12);
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 90, 90);
    var fromLines = fromAddress.split('\n').filter(Boolean).concat([fromEmail, fromPhone].filter(Boolean));
    var fromBlockBottom = y + 12;
    fromLines.forEach(function (line, i) {
      doc.text(line, fromX, y + 30 + i * 13);
      fromBlockBottom = y + 30 + i * 13;
    });

    // INVOICE meta (right, same top line)
    doc.setFont('helvetica', 'bold'); doc.setFontSize(22); doc.setTextColor(20, 20, 20);
    doc.text('INVOICE', pageWidth - margin, y + 14, { align: 'right' });
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 90, 90);
    doc.text('#' + number, pageWidth - margin, y + 32, { align: 'right' });
    doc.setFont('helvetica', 'bold');
    doc.text('Issued:', pageWidth - margin - 78, y + 47, { align: 'right' });
    doc.text('Due:', pageWidth - margin - 78, y + 62, { align: 'right' });
    doc.setFont('helvetica', 'normal');
    doc.text(issueDateFmt, pageWidth - margin, y + 47, { align: 'right' });
    doc.text(dueDateFmt, pageWidth - margin, y + 62, { align: 'right' });

    y = Math.max(fromBlockBottom, y + 62) + 28;

    // Bill To
    doc.setFont('helvetica', 'bold'); doc.setFontSize(9); doc.setTextColor(140, 140, 140);
    doc.text('BILL TO', margin, y);
    y += 16;
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10.5); doc.setTextColor(40, 40, 40);
    var toLines = [toName].concat(toAddress.split('\n').filter(Boolean)).concat(toEmail ? [toEmail] : []);
    toLines.forEach(function (line, i) { doc.text(line, margin, y + i * 14); });
    y += toLines.length * 14 + 22;

    // Table
    var col = { desc: margin, qty: pageWidth - margin - 170, rate: pageWidth - margin - 110, amount: pageWidth - margin };
    var colWidth = { desc: col.qty - margin - 20 };
    doc.setFont('helvetica', 'bold'); doc.setFontSize(8.5); doc.setTextColor(140, 140, 140);
    doc.text('DESCRIPTION', col.desc, y);
    doc.text('QTY', col.qty, y, { align: 'right' });
    doc.text('RATE', col.rate, y, { align: 'right' });
    doc.text('AMOUNT', col.amount, y, { align: 'right' });
    y += 8;
    doc.setDrawColor(210, 210, 210);
    doc.line(margin, y, pageWidth - margin, y);
    y += 16;

    var subtotal = 0;
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10); doc.setTextColor(40, 40, 40);
    document.querySelectorAll('#inv-items .invoice-line-item').forEach(function (row) {
      var desc = row.querySelector('.inv-item-desc').value.trim() || 'Item';
      var qty = parseFloat(row.querySelector('.inv-item-qty').value) || 0;
      var rate = parseFloat(row.querySelector('.inv-item-rate').value) || 0;
      var amount = qty * rate;
      subtotal += amount;

      var descLines = doc.splitTextToSize(desc, colWidth.desc);
      var rowHeight = Math.max(descLines.length, 1) * 13;

      if (y + rowHeight > pageHeight - 160) { doc.addPage(); y = margin; }

      descLines.forEach(function (line, i) { doc.text(line, col.desc, y + i * 13); });
      doc.text(String(qty), col.qty, y, { align: 'right' });
      doc.text(symbol + money(rate), col.rate, y, { align: 'right' });
      doc.text(symbol + money(amount), col.amount, y, { align: 'right' });
      y += rowHeight + 8;
      doc.setDrawColor(238, 238, 238);
      doc.line(margin, y - 6, pageWidth - margin, y - 6);
    });

    var discountPct = parseFloat(document.getElementById('inv-discount').value) || 0;
    var taxPct = parseFloat(document.getElementById('inv-tax').value) || 0;
    var discountAmt = subtotal * (discountPct / 100);
    var afterDiscount = subtotal - discountAmt;
    var taxAmt = afterDiscount * (taxPct / 100);
    var total = afterDiscount + taxAmt;

    y += 12;
    if (y > pageHeight - 140) { doc.addPage(); y = margin; }
    var totalsX = pageWidth - margin - 170;
    doc.setFontSize(10);
    doc.setTextColor(60, 60, 60);
    doc.text('Subtotal', totalsX, y);
    doc.text(symbol + money(subtotal), pageWidth - margin, y, { align: 'right' });
    y += 18;
    if (discountPct > 0) {
      doc.text('Discount (' + discountPct + '%)', totalsX, y);
      doc.text('-' + symbol + money(discountAmt), pageWidth - margin, y, { align: 'right' });
      y += 18;
    }
    if (taxPct > 0) {
      doc.text('Tax (' + taxPct + '%)', totalsX, y);
      doc.text(symbol + money(taxAmt), pageWidth - margin, y, { align: 'right' });
      y += 18;
    }
    doc.setDrawColor(20, 20, 20);
    doc.line(totalsX, y - 4, pageWidth - margin, y - 4);
    y += 12;
    doc.setFont('helvetica', 'bold'); doc.setFontSize(12); doc.setTextColor(20, 20, 20);
    doc.text('Total', totalsX, y);
    doc.text(symbol + money(total), pageWidth - margin, y, { align: 'right' });

    if (notes) {
      y += 40;
      if (y > pageHeight - 80) { doc.addPage(); y = margin; }
      doc.setDrawColor(230, 230, 230);
      doc.line(margin, y - 16, pageWidth - margin, y - 16);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5); doc.setTextColor(90, 90, 90);
      var noteLines = doc.splitTextToSize(notes, pageWidth - margin * 2);
      noteLines.forEach(function (line, i) { doc.text(line, margin, y + i * 13); });
    }

    doc.save((number || 'invoice').replace(/[^a-z0-9-_]/gi, '_') + '.pdf');
  }

  document.getElementById('inv-download').addEventListener('click', buildPdf);
  document.getElementById('inv-reset').addEventListener('click', function () {
    if (confirm('Reset the form? This clears everything you\'ve entered.')) location.reload();
  });

  render();
})();
</script>
