<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is keyword grouping?', acceptedAnswer: { '@type': 'Answer', text: 'It is sorting a list of keywords into sets that can be answered by one page, so you build one page per topic instead of one page per keyword.' } },
      { '@type': 'Question', name: 'Is this semantic keyword clustering?', acceptedAnswer: { '@type': 'Answer', text: 'No. It groups by shared words and phrases. Semantic or SERP-based clustering compares the pages that rank for each keyword, which needs search data that a browser tool does not have.' } },
      { '@type': 'Question', name: 'Does it need search volume?', acceptedAnswer: { '@type': 'Answer', text: 'No. Without volumes the tool still groups and picks the shortest keyword as the primary one. With volumes it picks the highest-volume keyword and adds up each group.' } },
      { '@type': 'Question', name: 'What does same query mean?', acceptedAnswer: { '@type': 'Answer', text: 'Two keywords that use exactly the same words in a different order. Search engines treat these as the same need, so they should share a page.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything is processed in your browser with JavaScript. Nothing is uploaded, logged or stored on any server.' } }
    ]
  }) %>
</script>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var current = '', csv = '', SHOW = {};
  var STOP = {}; 'a an the of for to in on and or how what is are with your you do does can i my best top free online vs versus near me'.split(' ').forEach(function (w) { STOP[w] = 1; });
  var INFO = /^(how|what|why|when|where|guide|tutorial|examples?|ideas?|meaning|definition|learn)$/;
  var COMM = /^(best|top|vs|versus|review|reviews|compare|comparison|alternatives?|software|tools?|platforms?)$/;
  var TRAN = /^(buy|price|pricing|cost|cheap|service|services|agency|company|hire|quote|order|consultant)$/;
  // intent words must not be removed before tagging, so STOP is used for grouping only
  function stem(w) { if (w.length > 4 && /ies$/.test(w)) return w.replace(/ies$/, 'y'); if (w.length > 4 && /(ing|es)$/.test(w)) return w.replace(/(ing|es)$/, ''); if (w.length > 3 && /s$/.test(w) && !/ss$/.test(w)) return w.replace(/s$/, ''); return w; }
  function parse(text) {
    var out = [], seen = {};
    text.split('\n').forEach(function (line) {
      line = line.trim(); if (!line) return;
      var vol = null, kw = line, m = line.match(/^(.*?)[,\t;]\s*([\d.,]+k?)\s*$/i);
      if (m) { kw = m[1].trim(); var v = m[2].toLowerCase().replace(/,/g, ''); vol = /k$/.test(v) ? Math.round(parseFloat(v) * 1000) : Math.round(parseFloat(v)); if (isNaN(vol)) vol = null; }
      kw = kw.replace(/^["']|["']$/g, '').replace(/\s+/g, ' ').toLowerCase(); if (!kw) return;
      if (seen[kw] !== undefined) { if (vol !== null) out[seen[kw]].vol = Math.max(out[seen[kw]].vol || 0, vol); return; }
      seen[kw] = out.length; out.push({ kw: kw, vol: vol });
    });
    return out;
  }
  function intentOf(words) { var t = null; words.forEach(function (w) { if (INFO.test(w)) t = t || 'informational'; else if (TRAN.test(w)) t = (t === 'informational') ? 'mixed' : 'transactional'; else if (COMM.test(w)) t = t || 'commercial'; }); return t || 'unlabelled'; }
  function group(items, min, ignore) {
    items.forEach(function (it) {
      it.words = it.kw.replace(/[^a-z0-9 ]/g, ' ').split(' ').filter(Boolean);
      it.tok = it.words.filter(function (w) { return !STOP[w] && !ignore[w]; }).map(stem);
      it.sig = it.words.map(stem).sort().join(' '); it.intent = intentOf(it.words);
      it.words.forEach(function (w) { if (!SHOW[stem(w)]) SHOW[stem(w)] = w; });
    });
    var left = items.filter(function (it) { return it.tok.length; }), groups = [];
    while (left.length) {
      var cnt = {}, cand = {};
      left.forEach(function (it) {
        var s = {}; it.tok.forEach(function (t, i) { s[t] = 1; if (i < it.tok.length - 1) s[it.tok[i] + ' ' + it.tok[i + 1]] = 1; if (i < it.tok.length - 1) s[it.tok[i + 1] + ' ' + it.tok[i]] = 1; });
        Object.keys(s).forEach(function (k) { cnt[k] = (cnt[k] || 0) + 1; });
      });
      var best = null, bestN = 0, bestScore = 0;
      Object.keys(cnt).forEach(function (k) { var n = cnt[k], sc = n * (k.indexOf(' ') > -1 ? 1.5 : 1); if (n >= min && sc > bestScore) { best = k; bestN = n; bestScore = sc; } });
      if (!best) break;
      var parts = best.split(' ');
      var hit = left.filter(function (it) { return parts.every(function (p) { return it.tok.indexOf(p) > -1; }); });
      var rest = left.filter(function (it) { return hit.indexOf(it) < 0; });
      groups.push({ name: parts.map(function (p) { return SHOW[p] || p; }).join(' '), items: hit }); left = rest;
    }
    return { groups: groups, ungrouped: items.filter(function (it) { return !it.tok.length; }).concat(left) };
  }
  function esc(s) { return '"' + String(s).replace(/"/g, '""') + '"'; }
  function render() {
    var items = parse($('kg-in').value);
    if (!items.length) { $('kg-output').textContent = 'Paste a keyword list to start.'; $('kg-status').textContent = 'Waiting for input'; current = ''; csv = ''; return; }
    var ignore = {}; $('kg-ignore').value.split(',').forEach(function (w) { w = w.trim().toLowerCase(); if (w) ignore[w] = 1; });
    var min = parseInt($('kg-min').value, 10) || 2, hasVol = items.some(function (i) { return i.vol !== null; });
    var res = group(items, min, ignore), L = [], C = ['group,keyword,volume,intent,primary,same_query_as'];
    res.groups.forEach(function (g) {
      g.items.sort(function (a, b) { return (b.vol || 0) - (a.vol || 0) || a.kw.length - b.kw.length; });
      var primary = g.items[0], total = g.items.reduce(function (s, i) { return s + (i.vol || 0); }, 0), sigs = {};
      var intents = {}; g.items.forEach(function (i) { if (i.intent !== 'unlabelled') intents[i.intent] = 1; });
      L.push('GROUP: ' + g.name + '  (' + g.items.length + ' keywords' + (hasVol ? ', ' + total + ' total volume' : '') + ')');
      L.push('  Primary: ' + primary.kw + (primary.vol !== null ? ' (' + primary.vol + ')' : '') + (Object.keys(intents).length > 1 ? '   [mixed intent: consider splitting the page]' : ''));
      g.items.forEach(function (i) {
        var dupe = sigs[i.sig] ? ' = same query as "' + sigs[i.sig] + '"' : ''; if (!sigs[i.sig]) sigs[i.sig] = i.kw;
        L.push('  - ' + i.kw + (i.vol !== null ? ' (' + i.vol + ')' : '') + '  [' + i.intent + ']' + dupe);
        C.push([esc(g.name), esc(i.kw), i.vol === null ? '' : i.vol, i.intent, i === primary ? 'yes' : '', dupe ? esc(sigs[i.sig]) : ''].join(','));
      });
      L.push('');
    });
    if (res.ungrouped.length) {
      L.push('UNGROUPED (' + res.ungrouped.length + '): one-offs, each may need its own page or can be dropped');
      res.ungrouped.forEach(function (i) { L.push('  - ' + i.kw + (i.vol !== null ? ' (' + i.vol + ')' : '')); C.push(['ungrouped', esc(i.kw), i.vol === null ? '' : i.vol, i.intent, '', ''].join(',')); });
    }
    current = L.join('\n'); csv = C.join('\n');
    $('kg-output').textContent = current;
    $('kg-status').textContent = res.groups.length + ' group' + (res.groups.length === 1 ? '' : 's') + ', ' + res.ungrouped.length + ' ungrouped';
  }
  ['kg-in', 'kg-min', 'kg-ignore'].forEach(function (id) { $(id).addEventListener('input', render); $(id).addEventListener('change', render); });
  $('kg-copy').addEventListener('click', function () { if (current && navigator.clipboard) navigator.clipboard.writeText(current); });
  $('kg-download').addEventListener('click', function () { if (!csv) return; var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = 'keyword-groups.csv'; a.click(); });
})();
</script>
