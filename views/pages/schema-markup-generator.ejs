<script>
(function () {
  function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

  function parseRows(text, cols) {
    return text.split('\n').map(function (l) { return l.trim(); }).filter(Boolean).map(function (line) {
      var parts = line.split('|').map(function (p) { return p.trim(); });
      var out = {};
      cols.forEach(function (c, i) { out[c] = parts[i] || ''; });
      return out;
    });
  }

  function buildFaq() {
    var rows = parseRows(document.getElementById('sc-faq-rows').value, ['q', 'a']).filter(function (r) { return r.q && r.a; });
    if (!rows.length) return null;
    return {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: rows.map(function (r) {
        return { '@type': 'Question', name: r.q, acceptedAnswer: { '@type': 'Answer', text: r.a } };
      })
    };
  }

  function buildHowto() {
    var name = document.getElementById('sc-howto-name').value.trim();
    if (!name) return null;
    var desc = document.getElementById('sc-howto-desc').value.trim();
    var steps = parseRows(document.getElementById('sc-howto-steps').value, ['name', 'text']).filter(function (r) { return r.name && r.text; });
    var obj = { '@context': 'https://schema.org', '@type': 'HowTo', name: name };
    if (desc) obj.description = desc;
    if (steps.length) {
      obj.step = steps.map(function (s, i) {
        return { '@type': 'HowToStep', position: i + 1, name: s.name, text: s.text };
      });
    }
    return obj;
  }

  function buildLocalBusiness() {
    var name = document.getElementById('sc-lb-name').value.trim();
    if (!name) return null;
    var obj = { '@context': 'https://schema.org', '@type': 'LocalBusiness', name: name };
    var desc = document.getElementById('sc-lb-desc').value.trim();
    if (desc) obj.description = desc;
    var street = document.getElementById('sc-lb-address').value.trim();
    var city = document.getElementById('sc-lb-city').value.trim();
    var state = document.getElementById('sc-lb-state').value.trim();
    var zip = document.getElementById('sc-lb-zip').value.trim();
    var country = document.getElementById('sc-lb-country').value.trim();
    if (street || city || state || zip || country) {
      obj.address = { '@type': 'PostalAddress' };
      if (street) obj.address.streetAddress = street;
      if (city) obj.address.addressLocality = city;
      if (state) obj.address.addressRegion = state;
      if (zip) obj.address.postalCode = zip;
      if (country) obj.address.addressCountry = country;
    }
    var phone = document.getElementById('sc-lb-phone').value.trim();
    if (phone) obj.telephone = phone;
    var url = document.getElementById('sc-lb-url').value.trim();
    if (url) obj.url = url;
    return obj;
  }

  function buildArticle() {
    var headline = document.getElementById('sc-art-headline').value.trim();
    if (!headline) return null;
    var obj = { '@context': 'https://schema.org', '@type': 'Article', headline: headline };
    var desc = document.getElementById('sc-art-desc').value.trim();
    if (desc) obj.description = desc;
    var author = document.getElementById('sc-art-author').value.trim();
    if (author) obj.author = { '@type': 'Person', name: author };
    var date = document.getElementById('sc-art-date').value.trim();
    if (date) obj.datePublished = date;
    var image = document.getElementById('sc-art-image').value.trim();
    if (image) obj.image = image;
    var url = document.getElementById('sc-art-url').value.trim();
    if (url) obj.mainEntityOfPage = url;
    return obj;
  }

  var builders = { faq: buildFaq, howto: buildHowto, localbusiness: buildLocalBusiness, article: buildArticle };

  function showGroup(type) {
    ['faq', 'howto', 'localbusiness', 'article'].forEach(function (g) {
      document.querySelector('[data-group="' + g + '"]').hidden = g !== type;
    });
  }

  function build() {
    var type = document.getElementById('sc-type').value;
    var obj = builders[type]();
    var output = document.getElementById('sc-output');
    var status = document.getElementById('sc-status');
    if (!obj) {
      output.textContent = '<!-- Your schema markup will appear here -->';
      status.textContent = 'Fill in the form to generate';
      return;
    }
    var json = JSON.stringify(obj, null, 2);
    output.textContent = '<script type="application/ld+json">\n' + json + '\n<\/script>';
    status.textContent = 'Updated';
  }

  document.getElementById('sc-type').addEventListener('change', function (e) {
    showGroup(e.target.value);
    build();
  });

  document.querySelectorAll('#schema-form input, #schema-form textarea').forEach(function (el) {
    el.addEventListener('input', build);
  });

  document.getElementById('sc-copy').addEventListener('click', function () {
    var text = document.getElementById('sc-output').textContent;
    if (!text || text.indexOf('will appear here') !== -1) return;
    navigator.clipboard.writeText(text).then(function () {
      var status = document.getElementById('sc-status');
      status.textContent = 'Copied!';
      setTimeout(function () { status.textContent = 'Updated'; }, 1800);
    });
  });

  document.getElementById('sc-download').addEventListener('click', function () {
    var text = document.getElementById('sc-output').textContent;
    if (!text || text.indexOf('will appear here') !== -1) return;
    var blob = new Blob([text], { type: 'text/html' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'schema-markup.html';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
})();
</script>
