<section class="page-hero">
  <div id="ambient-canvas" class="ambient-canvas"></div>
  <div class="container page-hero-inner">
    <span class="eyebrow">Free Tool</span>
    <h1>Free Link Building Outreach Email Generator — Short Emails That Name Something Real</h1>
    <p>Pick a tactic, add one specific detail about the page you are writing to, and this <strong>link building outreach email generator</strong> writes a short email, three subject lines and a follow-up. It checks the draft for filler and spammy phrases. Nothing is invented: every claim comes from what you type. No signup, nothing leaves your browser.</p>
  </div>
</section>

<section>
  <div class="container contact-grid llms-tool-grid">
    <div>
      <form class="contact-form llms-form" id="oe-form" onsubmit="return false;" aria-label="Link building outreach email generator form">
        <div>
          <label for="oe-tactic">Outreach tactic</label>
          <select id="oe-tactic">
            <option value="resource">Resource page suggestion</option>
            <option value="broken">Broken link replacement</option>
            <option value="insert">Link insertion in an existing article</option>
            <option value="guest">Guest article pitch</option>
            <option value="mention">Unlinked brand mention</option>
          </select>
        </div>
        <div>
          <label for="oe-name">Your name</label>
          <input type="text" id="oe-name" placeholder="e.g. Sam Carter">
        </div>
        <div>
          <label for="oe-company">Your company or site</label>
          <input type="text" id="oe-company" placeholder="e.g. Acme Analytics">
        </div>
        <div>
          <label for="oe-first">Their first name</label>
          <input type="text" id="oe-first" placeholder="e.g. Priya">
        </div>
        <div>
          <label for="oe-page">Their page URL or title</label>
          <input type="text" id="oe-page" placeholder="e.g. example.com/seo-resources">
        </div>
        <div>
          <label for="oe-hook">One specific thing about their page</label>
          <input type="text" id="oe-hook" placeholder="e.g. the section on log file analysis was the clearest I have read">
        </div>
        <div>
          <label for="oe-broken">Broken link URL (broken link tactic)</label>
          <input type="text" id="oe-broken" placeholder="e.g. oldsite.com/guide">
        </div>
        <div>
          <label for="oe-title">Your page title</label>
          <input type="text" id="oe-title" placeholder="e.g. Sitemap Priority: What 20 Sitemaps Show">
        </div>
        <div>
          <label for="oe-url">Your page URL</label>
          <input type="text" id="oe-url" placeholder="e.g. contomatix.com/blog/sitemap-priority">
        </div>
        <div>
          <label for="oe-value">What your page adds, in one sentence</label>
          <input type="text" id="oe-value" placeholder="e.g. it shows how 20 real sitemaps use the priority tag">
        </div>
        <div>
          <label for="oe-ideas">Article ideas (guest pitch, one per line)</label>
          <textarea id="oe-ideas" rows="3" placeholder="How 20 real sitemaps use lastmod&#10;What broke when we removed a sitemap"></textarea>
        </div>
      </form>
    </div>

    <div class="contact-info-card llms-preview-card">
      <div class="llms-preview-head">
        <strong>Your outreach email</strong>
        <span id="oe-status" class="llms-status">Waiting for input</span>
      </div>
      <pre id="oe-output" class="llms-output" style="max-height:520px;white-space:pre-wrap;">Fill in your name, their first name, your page title and URL to start.</pre>
      <div id="oe-checks" style="margin-top:12px;font-size:0.92rem;line-height:1.6;"></div>
      <div class="llms-actions" style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;">
        <button type="button" class="btn btn-primary" id="oe-copy">Copy</button>
        <button type="button" class="btn btn-glass" id="oe-download">Download .txt</button>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container llms-explainer">

    <h2>What This Outreach Email Generator Writes</h2>
    <ul class="service-points">
      <li><strong>Three subject lines</strong> that describe the email's content instead of using hype</li>
      <li><strong>A short email</strong> built for one tactic: resource page, broken link, link insertion, guest pitch or unlinked mention</li>
      <li><strong>A follow-up</strong> to send once, about a week later, that adds a reason and gives an easy way out</li>
      <li><strong>A draft check</strong> for word count, a missing personal detail, and phrases that make outreach look automated</li>
    </ul>

    <h2>How the Five Tactics Differ</h2>
    <p>A <strong>resource page</strong> email suggests your page for a list the owner already maintains, so the ask is small. A <strong>broken link</strong> email starts by telling the owner something useful (a link on their page returns an error) and offers a replacement. A <strong>link insertion</strong> email points to a specific passage in an existing article and says what your page adds to it. A <strong>guest article</strong> pitch offers two or three concrete topics rather than asking whether they accept guest posts. An <strong>unlinked mention</strong> email thanks the writer for naming you and asks, politely, whether they would link the name to the right page.</p>

    <h2>What Makes a Link Building Outreach Email Work</h2>
    <p>Link building outreach is a request to a stranger, so the email needs to answer three questions quickly: why you are writing to this person, what you are offering, and what you want them to do. Keep it short, name something specific from their page, make one clear ask and say it is fine to decline. Avoid offering anything in return for a link, since buying and selling links that pass ranking credit is against Google's link spam policy unless the link is qualified with nofollow or sponsored. The generator never writes an offer of payment or a link exchange.</p>
    <p>Replies are never guaranteed. A well-written email improves your chance, but the owner may be busy, may have no space on the page or may simply not agree. Treat each reply as information and keep your list of prospects relevant to your topic so a no costs you little.</p>

    <h2>Link Building Outreach Email Generator FAQs</h2>
    <div class="faq-list" style="margin-top: 22px;">
      <details>
        <summary>How long should an outreach email be?<span class="faq-icon"></span></summary>
        <p>Short enough to read in a few seconds. The generator warns when a draft is over 150 words, which is a working guideline rather than a rule from Google or any study.</p>
      </details>
      <details>
        <summary>Does the tool find email addresses or send emails?<span class="faq-icon"></span></summary>
        <p>No. It only writes text. You find the right contact and send the message from your own mailbox.</p>
      </details>
      <details>
        <summary>Why does it ask for one specific detail about their page?<span class="faq-icon"></span></summary>
        <p>A specific detail shows you read the page. Generic praise is the most common sign of a mass email, so the checker flags a draft without one.</p>
      </details>
      <details>
        <summary>Should I offer money or a link swap?<span class="faq-icon"></span></summary>
        <p>No. Google's link spam policy covers exchanging money or goods for links that pass ranking credit. Paid placements are acceptable only when qualified with nofollow or sponsored, and that belongs in a separate, transparent conversation.</p>
      </details>
      <details>
        <summary>How many follow-ups should I send?<span class="faq-icon"></span></summary>
        <p>One follow-up about a week later is enough for most prospects. The generator writes a single follow-up that adds a reason and lets the reader say no.</p>
      </details>
      <details>
        <summary>Does this tool store or send my data anywhere?<span class="faq-icon"></span></summary>
        <p>No. Everything is written in your browser with JavaScript — nothing is uploaded, logged, or stored on any server, including ours.</p>
      </details>
    </div>

    <div class="cta-band" style="margin-top: 44px;">
      <span class="cta-orb cta-orb-1"></span>
      <span class="cta-orb cta-orb-2"></span>
      <h2>Want the outreach done for you?</h2>
      <p>Contomatix builds editorial, relevant links for businesses and agencies.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
        <a href="https://wa.me/<%= site.whatsappNumber %>" target="_blank" rel="noopener" class="btn btn-glass">Chat on WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Link Building Outreach Email Generator',
    url: site.baseUrl + '/tools/outreach-email-generator',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any (browser-based)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Write a short link building outreach email, subject lines and a follow-up for resource pages, broken links, link insertions, guest pitches and unlinked mentions. Free, no signup.',
    provider: { '@id': site.baseUrl + '/#organization' }
  }) %>
</script>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.baseUrl },
      { '@type': 'ListItem', position: 2, name: 'Free Tools', item: site.baseUrl + '/tools' },
      { '@type': 'ListItem', position: 3, name: 'Link Building Outreach Email Generator', item: site.baseUrl + '/tools/outreach-email-generator' }
    ]
  }) %>
</script>

<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How long should an outreach email be?', acceptedAnswer: { '@type': 'Answer', text: 'Short enough to read in a few seconds. The generator warns when a draft is over 150 words, which is a working guideline rather than a rule from Google.' } },
      { '@type': 'Question', name: 'Does the tool find email addresses or send emails?', acceptedAnswer: { '@type': 'Answer', text: 'No. It only writes text. You find the contact and send the message from your own mailbox.' } },
      { '@type': 'Question', name: 'Why does it ask for one specific detail about their page?', acceptedAnswer: { '@type': 'Answer', text: 'A specific detail shows you read the page. Generic praise is a common sign of a mass email, so the checker flags a draft without one.' } },
      { '@type': 'Question', name: 'Should I offer money or a link swap?', acceptedAnswer: { '@type': 'Answer', text: 'No. Google link spam policy covers exchanging money or goods for links that pass ranking credit. Paid placements are acceptable only when qualified with nofollow or sponsored.' } },
      { '@type': 'Question', name: 'Does this tool store or send my data anywhere?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything is written in your browser with JavaScript - nothing is uploaded, logged, or stored on any server, including ours.' } }
    ]
  }) %>
</script>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var current = '';
  var FILLER = ['hope this email finds you well', 'dofollow', 'do-follow', 'link exchange', 'link swap', 'guaranteed', 'high da', 'high dr', 'paid link', 'best regards from', 'dear sir', 'dear webmaster'];

  function v(id) { return $(id).value.trim(); }
  function lines(id) { return $(id).value.split('\n').map(function (s) { return s.trim(); }).filter(Boolean); }
  function topic(title) { return title.replace(/[:|\-–].*$/, '').trim() || title; }

  function build() {
    var tactic = v('oe-tactic'), name = v('oe-name'), first = v('oe-first'), title = v('oe-title'), url = v('oe-url');
    if (!name || !first || !title || !url) return null;
    var company = v('oe-company'), page = v('oe-page'), hook = v('oe-hook'), broken = v('oe-broken'), value = v('oe-value'), ideas = lines('oe-ideas');
    var sig = name + (company ? '\n' + company : '');
    var pg = page ? page : 'your site';
    var hookLine = hook ? ' ' + hook.charAt(0).toUpperCase() + hook.slice(1).replace(/\.$/, '') + '.' : '';
    var valueClause = value ? ' ' + value.charAt(0).toUpperCase() + value.slice(1).replace(/\.$/, '') + '.' : '';
    var subjects = [], body = '', follow = '';

    if (tactic === 'resource') {
      subjects = ['A suggestion for ' + pg, '"' + title + '" for your resources list', 'Quick idea for your ' + topic(title).toLowerCase() + ' resources'];
      body = 'Hi ' + first + ',\n\nI was reading ' + pg + '.' + hookLine + '\n\nI wrote ' + title + ' (' + url + ').' + valueClause + ' It might fit your list of resources on the topic.\n\nIf it is useful, feel free to add it. If it is not a fit, no problem at all.\n\nThanks,\n' + sig;
      follow = 'Hi ' + first + ',\n\nA quick follow-up on my note about ' + title + '. I know resource lists take time to maintain, so I wanted to make it easy: the page is ' + url + ' and you can say no and I will not write again.\n\nThanks,\n' + sig;
    } else if (tactic === 'broken') {
      subjects = ['A broken link on ' + pg, 'Dead link' + (broken ? ' to ' + broken : '') + ' on your page', 'Heads up about a 404 on ' + pg];
      body = 'Hi ' + first + ',\n\nI was reading ' + pg + '.' + hookLine + '\n\nOne thing you may want to know: the link to ' + (broken || '[broken URL]') + ' returns an error, so readers who click it hit a dead end.\n\nI have a page on the same topic that could replace it: ' + title + ' (' + url + ').' + valueClause + ' Feel free to swap it in if it fits, or simply remove the broken link.\n\nThanks,\n' + sig;
      follow = 'Hi ' + first + ',\n\nFollowing up on the broken link' + (broken ? ' to ' + broken : '') + ' on ' + pg + '. It may be worth fixing either way. If ' + title + ' (' + url + ') is a fit as a replacement, I would be glad; if not, no worries.\n\nThanks,\n' + sig;
    } else if (tactic === 'insert') {
      subjects = ['A thought on ' + pg, 'Something that may add to ' + pg, 'A source for your article on ' + topic(title).toLowerCase()];
      body = 'Hi ' + first + ',\n\nI read ' + pg + '.' + hookLine + '\n\nThe article touches on a point that ' + title + ' (' + url + ') covers in more detail.' + valueClause + ' If you think it would help your readers, you could link to it where the topic comes up.\n\nEither way, thank you for a useful article.\n\n' + sig;
      follow = 'Hi ' + first + ',\n\nA short follow-up on ' + title + ' (' + url + '). If it does not fit the article, that is completely fine.\n\nThanks,\n' + sig;
    } else if (tactic === 'guest') {
      subjects = ['Article ideas for ' + pg, 'Topic ideas for your readers', 'Would any of these suit ' + pg + '?'];
      var list = ideas.length ? ideas.map(function (i, k) { return (k + 1) + '. ' + i; }).join('\n') : '1. [Add your first idea]\n2. [Add your second idea]';
      body = 'Hi ' + first + ',\n\nI have been reading ' + pg + '.' + hookLine + '\n\nI would like to suggest an article for your readers. Here are two or three topics:\n\n' + list + '\n\nFor reference, a recent piece of mine is ' + title + ' (' + url + ').' + valueClause + ' If one of these topics interests you, I can send a short outline first.\n\nThanks,\n' + sig;
      follow = 'Hi ' + first + ',\n\nFollowing up on my article ideas for ' + pg + '. If none of them are right, tell me what your readers are asking about and I will suggest something closer.\n\nThanks,\n' + sig;
    } else {
      subjects = ['Thanks for mentioning ' + (company || 'us'), 'A small request about your mention of ' + (company || 'our name'), 'Thank you, and a quick question'];
      body = 'Hi ' + first + ',\n\nThank you for mentioning ' + (company || 'us') + ' in ' + pg + '.' + hookLine + '\n\nIf you are happy to, would you link the name to ' + url + '? It would help readers find the right page' + (value ? ', where ' + value.replace(/\.$/, '') : '') + '.\n\nThanks again,\n' + sig;
      follow = 'Hi ' + first + ',\n\nA gentle follow-up about the mention of ' + (company || 'us') + ' in ' + pg + '. The page is ' + url + '. No problem at all if you prefer to leave it as it is.\n\nThanks,\n' + sig;
    }

    var out = 'SUBJECT LINES\n' + subjects.map(function (s, i) { return (i + 1) + '. ' + s; }).join('\n') + '\n\nEMAIL\n' + body + '\n\nFOLLOW-UP (send once, about a week later)\n' + follow;
    return { text: out, body: body, follow: follow, hook: hook, tactic: tactic, broken: broken, ideas: ideas };
  }

  function words(s) { return s.split(/\s+/).filter(Boolean).length; }

  function checks(r) {
    var items = [];
    var w = words(r.body);
    items.push([w <= 150, 'Email length: ' + w + ' words' + (w <= 150 ? ' (short)' : ' (over 150, consider trimming)')]);
    items.push([!!r.hook, r.hook ? 'Contains a specific detail about their page' : 'Add one specific detail about their page: generic emails look automated']);
    var low = (r.body + ' ' + r.follow).toLowerCase(), hit = FILLER.filter(function (f) { return low.indexOf(f) !== -1; });
    items.push([!hit.length, hit.length ? 'Phrases that read as automated or spammy: ' + hit.join(', ') : 'No filler or spammy phrases found']);
    if (r.tactic === 'broken') items.push([!!r.broken, r.broken ? 'Names the broken URL' : 'Add the broken URL so the owner can verify it']);
    if (r.tactic === 'guest') items.push([r.ideas.length >= 2, r.ideas.length >= 2 ? 'Offers ' + r.ideas.length + ' concrete topics' : 'Offer at least two concrete topics']);
    items.push([true, 'One clear ask, and an easy way to say no']);
    $('oe-checks').innerHTML = items.map(function (i) { return '<div>' + (i[0] ? '&#10003; ' : '&#9888; ') + i[1].replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</div>'; }).join('');
  }

  function run() {
    var r = build();
    current = r ? r.text : '';
    $('oe-output').textContent = r ? r.text : 'Fill in your name, their first name, your page title and URL to start.';
    $('oe-status').textContent = r ? 'Draft ready' : 'Waiting for input';
    if (r) checks(r); else $('oe-checks').innerHTML = '';
  }

  Array.prototype.slice.call($('oe-form').querySelectorAll('input,select,textarea')).forEach(function (e) {
    e.addEventListener('input', run); e.addEventListener('change', run);
  });
  $('oe-copy').addEventListener('click', function () {
    if (!current) return;
    var b = $('oe-copy');
    if (navigator.clipboard) navigator.clipboard.writeText(current).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
  });
  $('oe-download').addEventListener('click', function () {
    if (!current) return;
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([current], { type: 'text/plain' }));
    a.download = 'outreach-email.txt';
    document.body.appendChild(a); a.click(); a.remove();
  });
  run();
})();
</script>
