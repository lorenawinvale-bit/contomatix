<style>
.svc-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:8px}
.svc-card{position:relative;display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--border);border-radius:22px;overflow:hidden;text-decoration:none;color:inherit;box-shadow:var(--shadow-soft);transition:transform .25s cubic-bezier(.22,.9,.35,1),box-shadow .25s,border-color .25s;--mx:50%;--my:30%}
.svc-card::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;transition:opacity .3s;background:radial-gradient(260px circle at var(--mx) var(--my),rgba(14,165,160,.14),transparent 70%)}
.svc-card:hover,.svc-card:focus-visible{transform:translateY(-6px);box-shadow:0 30px 60px -26px rgba(22,25,42,.35);border-color:rgba(14,165,160,.5)}
.svc-card:hover::after{opacity:1}
.svc-stage{position:relative;height:176px;background:var(--tint,#E6F6F4);border-bottom:1px solid var(--border)}
.svc-stage svg{position:absolute;inset:10px 8px 4px;width:calc(100% - 16px);height:calc(100% - 14px);overflow:visible}
.svc-live{display:inline-flex;align-items:center;gap:6px;margin-left:8px;padding-left:10px;border-left:1px solid var(--border-light);font-family:var(--font-mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;color:var(--text-faint);font-weight:600}
.svc-live i{width:6px;height:6px;border-radius:50%;background:var(--accent-teal);animation:svcBlink 1.6s ease-in-out infinite}
.svc-body{display:flex;flex-direction:column;gap:8px;padding:18px 18px 18px;flex:1}
.svc-num{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.1em;color:var(--accent-teal-dim);font-weight:700}
.svc-body h3{font-family:var(--font-display);font-size:1.22rem;line-height:1.15;margin:0;letter-spacing:-.01em}
.svc-body p{margin:0;color:var(--text-dim);font-size:.9rem;line-height:1.5;flex:1}
.svc-go{margin-top:6px;font-weight:700;font-size:.88rem;color:var(--accent-teal-dim);display:inline-flex;align-items:center;gap:6px}
.svc-go span{display:inline-block;transition:transform .3s}.svc-card:hover .svc-go span{transform:translateX(5px)}
/* scene vocabulary */
.svc-stage svg text{font-family:var(--font-mono);font-size:9.5px;fill:#16192A;font-weight:600}
.svc-stage .base{fill:none;stroke:#D5C9B6;stroke-width:1.4;stroke-dasharray:3 4}
.svc-stage .dr{fill:none;stroke-width:2.4;stroke-linecap:round;stroke-dasharray:100;stroke-dashoffset:100;transition:stroke-dashoffset .25s ease}
.svc-stage .dr.ok{stroke:#0EA5A0}.svc-stage .dr.on{stroke-dashoffset:0}
.svc-stage .nd rect{fill:#fff;stroke:#E2D8C7;stroke-width:1.2}.svc-stage .nd.you rect{stroke:#0EA5A0;stroke-width:1.6}
.svc-stage .nd2{fill:#fff;stroke:#D5C9B6;stroke-width:1.4}.svc-stage .nd2s circle{fill:#fff;stroke:#D5C9B6;stroke-width:1.4}
.svc-stage .card{fill:#fff;stroke:#E2D8C7;stroke-width:1.2}
.svc-stage .ln{fill:#E7DFD2}.svc-stage .ln2{fill:#EFE8DB}.svc-stage .tr{fill:#EFE8DB}.svc-stage .zn{fill:rgba(14,165,160,.22)}
.svc-stage .navy{fill:#16192A}.svc-stage .fl-navy{fill:#16192A}.svc-stage .fl-ok,.svc-stage .ok-f{fill:#0EA5A0}.svc-stage .fl-no{fill:#E5484D}.svc-stage .fl-amber,.svc-stage .am-f{fill:#F5A623}
.svc-stage .hl{fill:rgba(20,184,166,.22)}.svc-stage .halo{fill:rgba(14,165,160,.12);stroke:rgba(14,165,160,.35)}
.svc-stage .ring-ok{fill:none;stroke:#0EA5A0;stroke-width:1.8}
.svc-stage .scn{fill:none;stroke:#F5A623;stroke-width:2}
.svc-stage .ck{fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.svc-stage .wt{fill:#fff;font-size:8.5px;font-weight:700}.svc-stage .wt2{fill:#fff;font-size:9px;font-weight:700}
.svc-stage .lb{fill:#7A8294;font-size:8px;letter-spacing:.12em}.svc-stage .lb2{fill:#0A6E69;font-size:8px;letter-spacing:.14em;font-weight:700}.svc-stage .big{font-size:12px}
.svc-stage .stamp{fill:none;stroke:#0A8782;stroke-width:1.8}.svc-stage .st{fill:#0A8782;font-size:9px;letter-spacing:.12em;font-weight:800}
.svc-stage .tx{font-size:9.5px}.svc-stage .nd text{font-size:8.3px}.svc-stage .nd.you text{font-size:8px}
/* motion primitives, switched by the sequencer */
.svc-stage .pp{opacity:0;transform-origin:0 0;transform:scale(.3);transition:opacity .3s,transform .25s cubic-bezier(.3,1.7,.5,1)}
.svc-stage .pp.on{opacity:1;transform:scale(1)}.svc-stage .pp.off{opacity:0;transform:scale(.3)}
.svc-stage .gw{transform:scaleX(0);transition:transform .25s cubic-bezier(.3,.8,.3,1)}.svc-stage .gw.on{transform:scaleX(1)}
.svc-stage .gy{transform:scaleY(0);transition:transform .25s cubic-bezier(.3,.9,.3,1)}.svc-stage .gy.on{transform:scaleY(1)}
.svc-stage .fd{opacity:0;transition:opacity .25s}.svc-stage .fd.on{opacity:1}.svc-stage .base1{opacity:1}.svc-stage .base1.off{opacity:0}
.svc-stage .sl{opacity:0;transform:translateY(8px);transition:opacity .25s,transform .25s cubic-bezier(.22,.9,.35,1)}.svc-stage .sl.r{transform:translateX(16px)}.svc-stage .sl.on{opacity:1;transform:none}

.svc-stage .shk.on{animation:svcShake .5s .1s}
.svc-stage .pulse{fill:none;stroke:#0EA5A0;stroke-width:1.6;opacity:0;transform-origin:center}.svc-stage .pulse.on{animation:svcPing 1.3s ease-out infinite}
.svc-stage .dr.off{stroke-dashoffset:100}.svc-stage .fd.off{opacity:0}
@keyframes svcBlink{50%{opacity:.25}}@keyframes svcShake{25%{transform:translateX(-3px)}50%{transform:translateX(3px)}75%{transform:translateX(-2px)}}@keyframes svcPing{0%{opacity:.9;transform:scale(.6)}100%{opacity:0;transform:scale(2.4)}}
@media (max-width:1100px){.svc-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:600px){.svc-grid{grid-template-columns:1fr}.svc-stage{height:190px}}
@media (prefers-reduced-motion:reduce) and (min-width:99999px){.svc-card,.svc-go span{transition:none}.svc-live i{animation:none}.svc-stage .pp,.svc-stage .gw,.svc-stage .gy,.svc-stage .fd,.svc-stage .sl,.svc-stage .dr{transition:none}}
</style>
<div class="svc-grid">
<% services.forEach(function (s, i) { var sc = scenes[s.slug]; %>
  <a class="svc-card" href="/services/<%= s.slug %>" style="--tint:<%= tints[i % tints.length] %>">
    <div class="svc-stage" data-stage data-steps="<%= sc.steps %>" data-ms="<%= sc.ms %>" aria-hidden="true">
      <svg viewBox="0 0 320 190" preserveAspectRatio="xMidYMid meet"><%- origin(sc.svg) %></svg>
    </div>
    <div class="svc-body">
      <span class="svc-num">0<%= i + 1 %><%= i === 0 ? ' ★' : '' %> <span class="svc-live"><i></i><%= sc.label %></span></span>
      <h3><%= s.title %></h3>
      <p><%= s.summary %></p>
      <span class="svc-go">Explore <span>&rarr;</span></span>
    </div>
  </a>
<% }); %>
</div>
<script>
(function(){
var stages=[].slice.call(document.querySelectorAll('[data-stage]'));if(!stages.length)return;
var reduce=true; /* motion budget: cards show their finished state, no looping demos */
function els(st,n,attr){return[].slice.call(st.querySelectorAll('['+attr+'="'+n+'"]'))}
function setAll(st,on){var n=+st.dataset.steps;for(var k=1;k<=n;k++){els(st,k,'data-k').forEach(function(e){e.classList.toggle('on',on);e.classList.remove('off')});els(st,k,'data-ko').forEach(function(e){e.classList.toggle('off',on)})}}
function run(st){var n=+st.dataset.steps,ms=+st.dataset.ms||800,i=0,t=0,go=false;
 function tick(){if(!go)return;i++;
  if(i<=n){els(st,i,'data-k').forEach(function(e){e.classList.add('on');e.classList.remove('off')});els(st,i,'data-ko').forEach(function(e){e.classList.add('off')});t=setTimeout(tick,ms)}
  else if(i===n+1){t=setTimeout(tick,1900)}
  else{setAll(st,false);i=0;t=setTimeout(tick,600)}}
 st._run={start:function(){if(go)return;go=true;t=setTimeout(tick,500)},stop:function(){go=false;clearTimeout(t);setAll(st,false);i=0}}}
stages.forEach(function(st){if(reduce){setAll(st,true);return}run(st)});
if(reduce)return;
if(!('IntersectionObserver' in window)){stages.forEach(function(s){s._run.start()});return}
var io=new IntersectionObserver(function(es){es.forEach(function(e){var r=e.target._run;if(!r)return;e.isIntersecting?r.start():r.stop()})},{threshold:.25});
stages.forEach(function(s){io.observe(s)});
document.querySelectorAll('.svc-card').forEach(function(c){var raf=0;c.addEventListener('pointermove',function(e){if(raf)return;raf=requestAnimationFrame(function(){raf=0;var b=c.getBoundingClientRect();c.style.setProperty('--mx',(e.clientX-b.left)+'px');c.style.setProperty('--my',(e.clientY-b.top)+'px')})},{passive:true})});
})();
</script>
