function origin(svg){return svg.replace(/<(rect|circle)([^>]*?)>/g,function(m,tag,attrs){var cls=(attrs.match(/class="([^"]*)"/)||[])[1]||'';if(!/(gw|gy|pulse|pp)/.test(cls))return m;
 function n(a){var r=attrs.match(new RegExp('(?:^|\s)'+a+'="(-?[\d.]+)"'));return r?parseFloat(r[1]):null}
 var ox,oy;if(/gw/.test(cls)){ox=n('x');oy=n('y')+n('height')/2}else if(/gy/.test(cls)){ox=n('x')+n('width')/2;oy=n('y')+n('height')}else if(n('cx')!==null){ox=n('cx');oy=n('cy')}else if(n('width')!==null){ox=n('x')+n('width')/2;oy=n('y')+n('height')/2}else return m;
 var add='transform-origin:'+ox+'px '+oy+'px;';if(/style="/.test(attrs))return '<'+tag+attrs.replace(/style="/,'style="'+add)+'>';return '<'+tag+attrs+' style="'+add+'">'}) }
var tints = ['#E6F6F4','#FDF1DC','#E8F1FB','#FDE9F2','#F0ECFB','#E6F6F4','#FDF1DC','#E8F1FB'];
