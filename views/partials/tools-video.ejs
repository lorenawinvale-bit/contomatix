<%
/* "Watch our free tools work": heading, a designed thumbnail with the play button, and three step cards.
   Each tool is named once: the card jumps to its part of the video and carries the link to the tool. Video loads only when played (preload none). */
var chapters = [
  ['0:02', 'Geo grid rank planner', 'Enter a keyword and centre point, get a grid to check local rankings.', 1.6, '/tools/geo-grid-rank-planner'],
  ['0:08', 'Keyword mapping tool', 'Paste keywords and URLs, see which page each keyword belongs on.', 8.2, '/tools/keyword-mapping-tool'],
  ['0:16', 'LLM SEO checker', 'Paste a robots.txt and see which AI crawlers can read your site.', 16.4, '/tools/llm-seo-checker']
];
var base = (typeof site !== 'undefined' && site.baseUrl) ? site.baseUrl : 'https://contomatix.com';
%>
<style>
.tv{position:relative;padding:76px 0 90px}
.tv-head{max-width:760px;margin:0 auto 38px;text-align:center}
.tv-head h2{font-family:var(--font-display);font-size:clamp(2.2rem,4.6vw,3.7rem);line-height:1.03;letter-spacing:-.055em;margin:14px 0 14px;font-weight:700}
.tv-head p{margin:0 auto;max-width:58ch;color:var(--text-dim);font-size:1.08rem;line-height:1.6}
.tv-shell{max-width:1180px;margin:0 auto;padding:10px;border-radius:30px;background:rgba(255,255,255,.7);border:1px solid #E1D6C2;box-shadow:0 40px 80px -36px rgba(8,50,60,.42)}
.tv-frame{position:relative;border-radius:21px;overflow:hidden;background:#16192A;aspect-ratio:1160/570;width:100%}
.tv-frame video{display:block;width:100%;height:100%;object-fit:cover;background:#16192A}
.tv-play{position:absolute;inset:0;width:100%;border:0;padding:0;cursor:pointer;background:transparent;transition:opacity .25s}
.tv-play span{position:absolute;left:7.7%;bottom:8%;display:inline-flex;align-items:center;gap:13px;background:#14B8A6;color:#08201F;font:800 1rem/1 var(--font-body);border-radius:999px;padding:8px 24px 8px 8px;box-shadow:0 18px 34px -14px rgba(20,184,166,.8);transition:transform .25s}
.tv-play i{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#fff}
.tv-play svg{width:18px;height:18px;margin-left:3px;fill:#0B807C}
.tv-play:hover span{transform:translateY(-3px)}
.tv-frame.is-playing .tv-play{opacity:0;pointer-events:none}
.tv-ch{list-style:none;max-width:1180px;margin:22px auto 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.tv-ch li{display:flex;flex-direction:column;background:#fff;border:1px solid var(--px-line,#E4DBCB);border-radius:18px;overflow:hidden;box-shadow:0 14px 28px -24px rgba(8,50,60,.4);transition:border-color .25s}
.tv-ch li:hover,.tv-ch li.a{border-color:#0EA5A0}.tv-ch li.a{box-shadow:inset 0 3px 0 #14B8A6,0 14px 28px -20px rgba(8,50,60,.4)}
.tv-ch button{flex:1;display:grid;grid-template-columns:44px 1fr;align-items:start;gap:14px;text-align:left;font:inherit;cursor:pointer;padding:18px 18px 12px;background:none;border:0;color:var(--text)}
.tv-ch b{display:grid;place-items:center;width:44px;height:44px;border-radius:13px;background:rgba(20,184,166,.13);color:#0A6E69;font-family:var(--font-display);font-size:1.05rem}
.tv-ch strong{display:block;font-family:var(--font-display);font-size:1.04rem;letter-spacing:-.02em}.tv-ch small{display:block;margin-top:3px;color:var(--text-dim);font-size:.82rem;line-height:1.45}
.tv-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:11px 18px;border-top:1px dashed #E4DBCB;font-size:.82rem;font-weight:700}
.tv-foot time{font-family:var(--font-mono);color:#6B7585}.tv-foot a{color:var(--accent-teal-dim);text-decoration:none}.tv-foot a:hover{text-decoration:underline}
.tv-all{text-align:center;margin-top:24px}
@media (max-width:900px){.tv{padding:54px 0 66px}.tv-ch{grid-template-columns:1fr}.tv-frame{aspect-ratio:16/9;border-radius:14px}.tv-shell{padding:6px;border-radius:20px}.tv-play span{left:50%;bottom:6%;transform:translateX(-50%);font-size:.82rem;padding:5px 16px 5px 5px;white-space:nowrap}.tv-play:hover span{transform:translateX(-50%)}.tv-play i{width:32px;height:32px}.tv-play svg{width:13px;height:13px}}
</style>
<section class="tv" id="watch-the-tools">
  <div class="container">
    <div class="tv-head">
      <span class="eyebrow">Free tools</span>
      <h2>Watch our free tools work</h2>
      <p>A real screen recording, not a mock-up. Every tool on this site runs in your browser, and nothing you type is sent anywhere.</p>
    </div>
    <div class="tv-shell">
      <div class="tv-frame" data-tv>
        <video preload="none" playsinline controlslist="nodownload" poster="/videos/free-tools-demo-poster.jpg?v=<%= site.assetVersion %>" width="1160" height="570" aria-label="Screen recording of three Contomatix free tools in use"><source src="/videos/free-tools-demo.mp4?v=<%= site.assetVersion %>" type="video/mp4"></video>
        <button class="tv-play" type="button" aria-label="Play the 25 second video"><span><i><svg viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z"/></svg></i>Watch the demo, 25 seconds</span></button>
      </div>
    </div>
    <ol class="tv-ch">
      <% chapters.forEach(function (c, i) { %><li><button type="button" data-seek="<%= c[3] %>"><b><%= i + 1 %></b><span><strong><%= c[1] %></strong><small><%= c[2] %></small></span></button><div class="tv-foot"><time>&#9654; <%= c[0] %></time><a href="<%= c[4] %>">Open tool &rarr;</a></div></li><% }); %>
    </ol>
    <div class="tv-all"><a href="/tools" class="btn btn-outline">See all free tools &rarr;</a></div>
  </div>
  <script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'VideoObject', name: 'Contomatix free SEO tools in use', description: 'A 25 second screen recording of the Contomatix geo grid rank planner, keyword mapping tool and LLM SEO checker.', thumbnailUrl: base + '/videos/free-tools-demo-poster.jpg', uploadDate: '2026-11-29', duration: 'PT25S', contentUrl: base + '/videos/free-tools-demo.mp4', embedUrl: base + '/#watch-the-tools' }) %></script>
</section>
<script>
(function(){var f=document.querySelector('[data-tv]');if(!f)return;var v=f.querySelector('video'),p=f.querySelector('.tv-play'),btns=[].slice.call(document.querySelectorAll('[data-seek]'));
function go(t){f.classList.add('is-playing');v.setAttribute('controls','');var s=function(){try{if(typeof t==='number')v.currentTime=t}catch(e){}v.play().catch(function(){})};if(v.readyState>0)s();else{v.addEventListener('loadedmetadata',s,{once:true});v.load()}}
p.addEventListener('click',function(){go(0)});
btns.forEach(function(b){b.addEventListener('click',function(){f.scrollIntoView({behavior:'smooth',block:'center'});go(+b.dataset.seek)})});
function mark(k){btns.forEach(function(b,i){b.parentNode.classList.toggle('a',i===k)})}
v.addEventListener('timeupdate',function(){var t=v.currentTime,k=-1;btns.forEach(function(b,i){if(t>=+b.dataset.seek-.1)k=i});mark(v.paused?-1:k)});
v.addEventListener('ended',function(){f.classList.remove('is-playing');mark(-1)})})();
</script>
