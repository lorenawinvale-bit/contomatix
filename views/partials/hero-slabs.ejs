<%
/* Hero visual: three glass slabs (example sites) rise, a scan beam passes through them, the passing sites light up and link, the failing one dims.
   Pure CSS 3D, no images. Example sites are labelled as examples. */
%>
<style>
.hs{position:relative;height:500px;perspective:1500px;--mx:0;--my:0}
.hs-glow{position:absolute;left:50%;top:60%;width:620px;height:400px;transform:translate(-50%,-50%);background:radial-gradient(closest-side,rgba(20,184,166,.5),transparent 70%)}
.hs-glow.b{top:42%;width:420px;height:300px;background:radial-gradient(closest-side,rgba(245,166,35,.28),transparent 70%)}
.hs-iso{position:absolute;left:50%;top:54%;width:0;height:0;transform-style:preserve-3d;transform:translate(-50%,-50%) rotateX(calc(58deg + var(--my)*6deg)) rotateZ(calc(-38deg + var(--mx)*10deg)) scale(1.5);transition:transform .5s cubic-bezier(.22,.9,.35,1)}
.hs-floor{position:absolute;left:-190px;top:-190px;width:380px;height:380px;transform:translateZ(-40px);background:radial-gradient(rgba(14,100,100,.42) 1.2px,transparent 1.4px) 0 0/20px 20px;opacity:.8;-webkit-mask-image:radial-gradient(closest-side,#000 40%,transparent);mask-image:radial-gradient(closest-side,#000 40%,transparent)}
.hs-slab{position:absolute;left:-100px;top:-100px;width:200px;height:200px;border-radius:26px;transform-style:preserve-3d;transform:translateZ(var(--z));animation:hsRise 11s cubic-bezier(.3,.8,.3,1) infinite both}
.hs-slab .t{position:absolute;inset:0;border-radius:inherit;background:linear-gradient(135deg,#fff 0%,#EAF8F5 60%,#D9F1EC 100%);border:1px solid rgba(255,255,255,.95);box-shadow:inset 0 0 0 1px rgba(14,165,160,.18),inset 0 -18px 30px rgba(14,165,160,.1),0 0 0 1px rgba(8,50,60,.05)}
.hs-slab .e{position:absolute;inset:0;border-radius:inherit;transform:translateZ(-12px);background:linear-gradient(135deg,#9FDDD4,#5FBFB4);box-shadow:0 30px 40px rgba(8,50,60,.25)}
.hs-slab .s{position:absolute;inset:16px;border-radius:14px;background:#fff;box-shadow:0 0 0 1px rgba(8,50,60,.06),0 6px 12px -6px rgba(8,50,60,.2);padding:12px;overflow:hidden}
.hs-slab .s .b{display:flex;gap:4px;margin-bottom:10px}.hs-slab .s .b i{width:6px;height:6px;border-radius:50%;background:#E3DACB}.hs-slab .s .b i:first-child{background:var(--accent-teal)}
.hs-slab .s .l{height:6px;border-radius:3px;background:#EFE8DB;margin-bottom:7px}.hs-slab .s .l.h{height:9px;background:#16192A;width:70%}.hs-slab .s .l.k{background:rgba(20,184,166,.35);width:55%}
.hs-slab .s .d{position:absolute;left:12px;bottom:10px;font-family:var(--font-mono);font-size:8.5px;font-weight:700;color:#5F6878}
.hs-s1{--z:132px}.hs-s2{--z:66px;animation-delay:.12s}.hs-s3{--z:0px;animation-delay:.24s;animation-name:hsRiseBad}
.hs-s3 .t{background:linear-gradient(135deg,#fff,#F7ECEC 70%,#F1DADA);box-shadow:inset 0 0 0 1px rgba(229,72,77,.25),inset 0 -18px 30px rgba(229,72,77,.08)}
.hs-s3 .e{background:linear-gradient(135deg,#E9B3B5,#D98C90)}.hs-s3 .s .l.k{background:rgba(229,72,77,.35)}
.hs-scan{position:absolute;left:-110px;top:-110px;width:220px;height:220px;border-radius:30px;background:linear-gradient(135deg,rgba(20,184,166,.28),rgba(94,234,212,.08));border:1.5px solid rgba(20,184,166,.8);box-shadow:0 0 36px 8px rgba(20,184,166,.45);opacity:0;animation:hsScan 11s cubic-bezier(.45,0,.3,1) infinite both}
.hs-beam{position:absolute;left:0;top:0;width:5px;height:66px;margin-left:-2px;border-radius:3px;transform-origin:50% 100%;background:linear-gradient(0deg,rgba(20,184,166,.2),#2DD4BF);box-shadow:0 0 18px 3px rgba(45,212,191,.7);animation:hsBeam 11s cubic-bezier(.3,.8,.3,1) infinite both}
.hs-b1{--bx:70px;--by:-70px;transform:translate3d(70px,-70px,66px) rotateX(-90deg) scaleY(0)}.hs-b2{--bx:-70px;--by:70px;animation-delay:.18s;transform:translate3d(-70px,70px,66px) rotateX(-90deg) scaleY(0)}
.hs-lab{position:absolute;z-index:3;display:flex;align-items:center;gap:9px;padding:9px 14px 9px 10px;border-radius:13px;background:rgba(255,255,255,.88);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.95);box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 14px 28px -12px rgba(8,50,60,.4);font-size:.78rem;font-weight:700;white-space:nowrap;opacity:0;animation:hsLab 11s cubic-bezier(.3,1.3,.5,1) infinite both}
.hs-lab small{display:block;font-weight:500;color:#6B7585;font-size:.66rem;font-family:var(--font-mono)}
.hs-lab b{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:var(--accent-teal);flex:0 0 25px}.hs-lab b svg{width:11px;height:11px;stroke:#fff;stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round}
.hs-lab.no b{background:#E5484D}
.hs-l1{right:0;top:92px;animation-delay:3.3s}.hs-l2{right:8px;top:238px;animation-delay:4.1s}.hs-l3{left:0;bottom:104px;animation-delay:2.5s}
.hs-l4{left:50%;bottom:18px;margin-left:-100px;animation-name:hsLab4;animation-delay:5.6s}
.hs-top{position:absolute;left:0;right:0;top:6px;display:flex;justify-content:center;gap:8px;align-items:center;font-family:var(--font-mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:#4E5A68;font-weight:700}
.hs-top i{width:6px;height:6px;border-radius:50%;background:var(--accent-teal);animation:hsBlink 1.6s infinite}
.hs-px{position:absolute;left:50%;top:40%;width:0;height:0;pointer-events:none}.hs-px i{position:absolute;display:block;width:var(--s);height:var(--s);border-radius:2px;background:var(--c);left:var(--x);top:0;opacity:0;animation:hsPx var(--d) ease-out infinite;animation-delay:var(--w)}
@keyframes hsBlink{50%{opacity:.25}}
@keyframes hsPx{0%{opacity:0;transform:translateY(0) scale(1)}15%{opacity:.95}100%{opacity:0;transform:translateY(-130px) scale(.4)}}
@keyframes hsRise{0%{transform:translateZ(0);opacity:0}6%{opacity:1}14%{transform:translateZ(var(--z))}86%{transform:translateZ(calc(var(--z) + 3px));opacity:1}93%{transform:translateZ(var(--z));opacity:1}98%,100%{transform:translateZ(0);opacity:0}}
@keyframes hsRiseBad{0%{transform:translateZ(0);opacity:0}6%{opacity:1}14%{transform:translateZ(var(--z))}50%{transform:translateZ(var(--z));opacity:1}58%,90%{transform:translateZ(var(--z));opacity:.5}93%{opacity:.5}98%,100%{transform:translateZ(0);opacity:0}}
@keyframes hsScan{0%,16%{transform:translateZ(-6px);opacity:0}18%{opacity:1}44%{transform:translateZ(150px);opacity:1}48%,100%{transform:translateZ(150px);opacity:0}}
@keyframes hsBeam{0%,52%{transform:translate3d(var(--bx),var(--by),66px) rotateX(-90deg) scaleY(0)}60%,86%{transform:translate3d(var(--bx),var(--by),66px) rotateX(-90deg) scaleY(1)}92%,100%{transform:translate3d(var(--bx),var(--by),66px) rotateX(-90deg) scaleY(0)}}
@keyframes hsLab{0%{opacity:0;transform:translateY(10px) scale(.96)}3%{opacity:1;transform:none}60%{opacity:1;transform:none}66%,100%{opacity:0;transform:translateY(10px) scale(.96)}}
@keyframes hsLab4{0%{opacity:0;transform:translateY(14px) scale(.9)}4%{opacity:1;transform:none}80%{opacity:1;transform:none}86%,100%{opacity:0;transform:translateY(14px) scale(.9)}}
@media (max-width:900px){.hs{height:430px}.hs-iso{transform:translate(-50%,-50%) rotateX(58deg) rotateZ(-38deg) scale(1.2)}}
</style>
<div class="hs" data-hs aria-hidden="true">
  <div class="hs-top"><i></i>Live vetting &middot; example sites</div>
  <div class="hs-glow"></div><div class="hs-glow b"></div>
  <div class="hs-px"><% [[-70,8,'#14B8A6',3.2,0],[-40,6,'#F5A623',3.8,.6],[-8,9,'#14B8A6',3.4,1.3],[26,6,'#F472B6',4,.3],[58,8,'#14B8A6',3.6,1.9],[-92,6,'#F5A623',3,1],[88,6,'#F472B6',3.3,2.4],[10,5,'#0EA5A0',4.2,2.8],[110,7,'#14B8A6',3.5,.9],[-116,5,'#F5A623',3.9,3.3]].forEach(function (p) { %><i style="--x:<%= p[0] %>px;--s:<%= p[1] %>px;--c:<%= p[2] %>;--d:<%= p[3] %>s;--w:<%= p[4] %>s"></i><% }); %></div>
  <div class="hs-iso">
    <div class="hs-floor"></div>
    <% [['hs-s3', 'linkfarm.example'], ['hs-s2', 'industry.example'], ['hs-s1', 'journal.example']].forEach(function (s) { %>
    <div class="hs-slab <%= s[0] %>"><div class="e"></div><div class="t"></div><div class="s"><div class="b"><i></i><i></i><i></i></div><div class="l h"></div><div class="l"></div><div class="l k"></div><div class="l" style="width:80%"></div><span class="d"><%= s[1] %></span></div></div>
    <% }); %>
    <i class="hs-beam hs-b1"></i><i class="hs-beam hs-b2"></i>
    <div class="hs-scan"></div>
  </div>
  <div class="hs-lab hs-l3 no"><b><svg viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8"/></svg></b><span>linkfarm.example<small>sells links, skipped</small></span></div>
  <div class="hs-lab hs-l2"><b><svg viewBox="0 0 16 16"><path d="M3 8.5l3.2 3L13 4.5"/></svg></b><span>industry.example<small>relevant, clean links</small></span></div>
  <div class="hs-lab hs-l1"><b><svg viewBox="0 0 16 16"><path d="M3 8.5l3.2 3L13 4.5"/></svg></b><span>journal.example<small>4 of 4 checks</small></span></div>
  <div class="hs-lab hs-l4"><b><svg viewBox="0 0 16 16"><path d="M3 8.5l3.2 3L13 4.5"/></svg></b><span>2 links ready for approval<small>sample data</small></span></div>
</div>
<script>
(function(){var s=document.querySelector('[data-hs]');if(!s||(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)||!matchMedia('(pointer:fine)').matches)return;var raf=0;
s.addEventListener('pointermove',function(e){if(raf)return;raf=requestAnimationFrame(function(){raf=0;var r=s.getBoundingClientRect();s.style.setProperty('--mx',((e.clientX-r.left)/r.width-.5).toFixed(3));s.style.setProperty('--my',((e.clientY-r.top)/r.height-.5).toFixed(3))})},{passive:true});
s.addEventListener('pointerleave',function(){s.style.setProperty('--mx',0);s.style.setProperty('--my',0)})})();
</script>
