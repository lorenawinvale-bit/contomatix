<footer class="site-footer">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container footer-grid">
    <div class="footer-brand-col">
      <div class="brand footer-brand">
        <span class="brand-mark" aria-hidden="true">
          <%- include('./logo', { logoSize: 34, logoId: 'logo-ftr' }) %>
        </span>
        <span class="brand-name">Conto<span class="brand-accent">matix</span></span>
      </div>
      <p class="footer-blurb">Link building, audits and free SEO tools, built on real data and tested before we publish.</p>
      <div class="footer-social">
        <a href="https://www.facebook.com/profile.php?id=61594091741317" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.2-1.5 1.5-1.5h1.4V4.9c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.9V11H8v3h2.5v7h3z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/contomatix/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M6.5 8.5H3.8V20h2.7V8.5zM5.1 3.5a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2zM20.2 13c0-3-1.6-4.7-4-4.7-1.6 0-2.5.9-2.9 1.6V8.5h-2.7V20h2.7v-6.1c0-1.4.7-2.4 2-2.4s1.9.9 1.9 2.4V20h2.7l.3-7z"/></svg>
        </a>
      </div>
      <div class="footer-cta">
        <a href="/contact" class="footer-btn footer-btn-primary">Request a free audit</a>
        <a href="https://wa.me/<%= site.whatsappNumber %>" target="_blank" rel="noopener" class="footer-btn footer-btn-ghost">WhatsApp us</a>
      </div>
    </div>

    <div class="footer-col">
      <h2>Services</h2>
      <ul>
        <% services.forEach(function(s) { %>
          <li><a href="/services/<%= s.slug %>"><%= s.title %></a></li>
        <% }); %>
        <li><a class="footer-more" href="/services">All services &rarr;</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>Free Tools</h2>
      <% var featuredTools = ['technical-seo-audit-tool', 'schema-markup-generator', 'sitemap-generator', 'robots-txt-generator', 'llms-txt-generator', 'meta-tag-generator', 'seo-report-generator', 'link-prospect-scorer'];
         var newestSlugs = ['link-prospect-scorer', 'sitemap-finder', 'content-marketing-roi-calculator'];
         var shownTools = featuredTools.map(function (s) { return tools.find(function (t) { return t.slug === s; }); }).filter(Boolean); %>
      <ul>
        <% shownTools.forEach(function(t) { %>
          <li><a href="/tools/<%= t.slug %>"><%= t.title %></a><% if (newestSlugs.indexOf(t.slug) !== -1) { %> <span class="footer-badge">New</span><% } %></li>
        <% }); %>
        <li><a class="footer-more" href="/tools">All <%= tools.length %> free tools &rarr;</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>Popular guides</h2>
      <ul>
        <li><a href="/blog/relevant-backlinks">Relevant backlinks</a></li>
        <li><a href="/blog/check-backlinks-of-website">Check backlinks of a website</a></li>
        <li><a href="/blog/link-building-campaign">Link building campaign</a></li>
        <li><a href="/blog/internal-link-building">Internal link building</a></li>
        <li><a href="/blog/how-to-index-backlinks">How to index backlinks</a></li>
        <li><a href="/blog/search-console-impressions-explained">Search Console impressions</a></li>
        <li><a class="footer-more" href="/blog">All articles &rarr;</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>Company</h2>
      <ul>
        <li><a href="/about">About us</a></li>
        <li><a href="/team">Team</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="mailto:<%= site.contactEmail %>">Email us</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom-bar">
    <p>&copy; <%= new Date().getFullYear() %> Contomatix. All rights reserved.</p>
    <div class="footer-legal">
      <a href="/terms">Terms</a>
      <a href="/privacy-policy">Privacy policy</a>
      <a href="/contact">Contact</a>
      <a href="https://www.designrush.com/agency/search-engine-optimization" target="_blank" rel="nofollow sponsored noopener">Find us on DesignRush</a>
    </div>
  </div>
</footer>
