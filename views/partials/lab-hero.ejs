<%
/* "Link Lab" hero: an animated specimen inspection. Pure CSS/SVG (transform, opacity, stroke-dashoffset), no images, no JS needed to run.
   Specimens are fictional (.example domains) and labelled as examples. Inline critical CSS so the hero needs no extra request. */
var specimens = [
  { id: 'a', domain: 'northpeak-journal.example', kind: 'Industry blog', score: 4, v: 0, verdict: 'We would place it', cls: 'ok',
    checks: [['Real organic traffic', 1], ['Relevant to your niche', 1], ['Clean outbound links', 1], ['Editorial placement', 1]] },
  { id: 'b', domain: 'bulk-links-hub.example', kind: 'Link directory', score: 1, v: 94, verdict: 'We would walk away', cls: 'no',
    checks: [['Real organic traffic', 0], ['Relevant to your niche', 1], ['Clean outbound links', 0], ['Editorial placement', 0]] }
];
%>
<style>
.lab-hero{position:relative;overflow:hidden;padding:112px 0 96px;border-bottom:1px solid var(--border);isolation:isolate;
  background:
   linear-gradient(var(--bg),var(--bg));}
.lab-hero::before{content:"";position:absolute;inset:0;z-index:-2;opacity:.55;
  background-image:linear-gradient(rgba(22,25,42,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(22,25,42,.045) 1px,transparent 1px);
  background-size:40px 40px;-webkit-mask-image:radial-gradient(70% 80% at 70% 40%,#000 30%,transparent 100%);mask-image:radial-gradient(70% 80% at 70% 40%,#000 30%,transparent 100%)}
.lab-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:48px;align-items:center}
.lab-kicker{display:inline-flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-teal-dim);font-weight:700}
.lab-kicker i{width:8px;height:8px;border-radius:50%;background:var(--accent-teal);box-shadow:0 0 0 0 rgba(14,165,160,.5);animation:labPulse 2.4s ease-out infinite}
.lab-copy h1{font-family:var(--font-display);font-size:clamp(2.6rem,6.2vw,4.7rem);line-height:1.01;letter-spacing:-.058em;margin:20px 0 34px;font-weight:700;color:var(--text)}
.lab-copy h1 .u{position:relative;white-space:nowrap}
.lab-copy h1 .u svg{position:absolute;left:0;bottom:-.24em;width:100%;height:.3em;overflow:visible}
.lab-copy h1 .u path{stroke:var(--accent-teal);stroke-width:5;fill:none;stroke-linecap:round;stroke-dasharray:420;stroke-dashoffset:420;animation:labDraw 1.1s .5s cubic-bezier(.65,0,.35,1) forwards}
.lab-sub{max-width:52ch;font-size:clamp(1.02rem,1.4vw,1.16rem);color:var(--text-dim);margin:0}
.lab-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.lab-facts{display:flex;flex-wrap:wrap;gap:8px 22px;margin:30px 0 0;padding:0;list-style:none;font-family:var(--font-mono);font-size:.78rem;color:var(--text-dim)}
.lab-facts b{color:var(--text);font-weight:700}
.lab-facts li::before{content:"";display:inline-block;width:7px;height:7px;border-radius:2px;background:var(--accent-amber);margin-right:8px;transform:rotate(45deg)}

.lab-type{margin:14px 0 0;font-family:var(--font-mono);font-size:.92rem;color:var(--text);font-weight:600;min-height:1.6em}.lab-type .ty{color:#0A6E69}.lab-type .cur{display:inline-block;width:.55em;height:1.05em;margin-left:2px;vertical-align:-.16em;background:var(--accent-teal);animation:labCur 1s steps(1) infinite}@keyframes labCur{50%{opacity:0}}
.tf-col{position:relative;min-width:0}
/* the instrument */
.lab{position:relative;height:452px;contain:layout;--mx:0;--my:0}
.lab-par{position:absolute;inset:0;transform:translate3d(calc(var(--mx)*-12px),calc(var(--my)*-9px),0);transition:transform .25s cubic-bezier(.22,.9,.35,1)}
.lab-chip{position:absolute;z-index:3;display:inline-flex;align-items:center;gap:8px;padding:8px 12px 8px 8px;border-radius:999px;background:rgba(255,255,255,.78);backdrop-filter:blur(14px) saturate(1.5);-webkit-backdrop-filter:blur(14px) saturate(1.5);border:1px solid rgba(255,255,255,.9);box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 12px 28px -12px rgba(22,25,42,.35);font-size:.76rem;font-weight:700;color:var(--text);white-space:nowrap;animation:labFloat 6.5s ease-in-out infinite alternate}
.lab-chip b{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:var(--accent-teal);color:#fff}
.lab-chip b svg{width:11px;height:11px;stroke:#fff;stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round}
.lab-chip.c1{right:6px;top:-2px;transform:translate3d(calc(var(--mx)*-26px),calc(var(--my)*-18px),0)}
.lab-chip.c2{left:18px;bottom:-4px;animation-delay:-3s;transform:translate3d(calc(var(--mx)*-30px),calc(var(--my)*-20px),0)}
.lab-chip.c2 b{background:var(--accent-amber)}
@keyframes labFloat{from{margin-top:-5px}to{margin-top:6px}}
.lab-blob{position:absolute;z-index:-1;width:560px;height:560px;border-radius:50%;pointer-events:none;will-change:transform;animation:labDrift 22s ease-in-out infinite alternate}
.lab-blob.b1{right:-140px;top:-170px;background:radial-gradient(circle,rgba(20,184,166,.20),transparent 66%)}
.lab-blob.b2{left:-220px;bottom:-260px;background:radial-gradient(circle,rgba(245,166,35,.22),transparent 66%);animation-delay:-9s}
@keyframes labDrift{from{transform:translate3d(0,0,0) scale(1)}to{transform:translate3d(-60px,40px,0) scale(1.12)}}
.lab-label{position:absolute;left:0;right:0;top:0;display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--text-faint)}
.spec{position:absolute;left:0;right:0;top:50px;background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:18px 20px 20px;box-shadow:0 1px 0 rgba(255,255,255,.95) inset,0 0 0 1px rgba(22,25,42,.035),0 3px 6px rgba(22,25,42,.04),0 18px 34px -14px rgba(22,25,42,.14),0 50px 90px -34px rgba(22,25,42,.34),0 0 80px -30px rgba(14,165,160,.4);opacity:0;will-change:transform,opacity;animation:specLife 14s linear infinite both;animation-delay:var(--o)}
.spec-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:14px;border-bottom:1px dashed var(--border-light)}
.spec-site{display:flex;align-items:center;gap:10px;min-width:0}
.spec-fav{flex:0 0 30px;height:30px;border-radius:9px;background:var(--bg-alt);border:1px solid var(--border);display:grid;place-items:center;font-family:var(--font-display);font-weight:700;font-size:.8rem;color:var(--text-dim)}
.spec-name{font-family:var(--font-mono);font-size:.84rem;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.spec-kind{display:block;font-family:var(--font-body);font-size:.72rem;color:var(--text-faint);font-weight:500}
.spec-tag{flex:0 0 auto;font-family:var(--font-mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;padding:4px 8px;border-radius:999px;background:var(--bg-alt);color:var(--text-dim);border:1px solid var(--border)}
.spec-body{position:relative;height:178px;overflow:hidden}
.spec-rows{margin:0;padding:6px 0 0;list-style:none}
.spec-rows li{display:flex;align-items:center;justify-content:space-between;height:42px;border-bottom:1px solid var(--bg-alt);font-size:.92rem;font-weight:600;color:var(--text)}
.spec-rows li:last-child{border-bottom:0}
.ck{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;opacity:0;will-change:transform,opacity;animation:ckIn 14s linear infinite both;animation-delay:calc(var(--d) + var(--o))}
.ck svg{width:13px;height:13px;stroke:#fff;stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round}
.ck.p{background:var(--accent-teal)}.ck.f{background:#E5484D}
.scan{position:absolute;left:-4px;right:-4px;top:0;height:2px;background:linear-gradient(90deg,transparent,var(--accent-teal-bright),transparent);box-shadow:0 0 18px 4px rgba(20,184,166,.45);opacity:0;will-change:transform,opacity;animation:scanMove 14s linear infinite both;animation-delay:calc(.5s + var(--o))}
.spec-foot{display:flex;align-items:center;gap:16px;padding-top:14px;border-top:1px dashed var(--border-light)}
.ring{position:relative;flex:0 0 58px;height:58px}
.ring svg{width:58px;height:58px;transform:rotate(-90deg)}
.ring circle{fill:none;stroke-width:5.5;stroke-linecap:round}
.ring .tr{stroke:var(--surface-2)}
.ring .fg{stroke-dasharray:125.7;stroke-dashoffset:125.7;opacity:0;animation:ringFill 14s linear infinite both;animation-delay:calc(3.6s + var(--o))}
.spec.ok .fg{stroke:var(--accent-teal)}.spec.no .fg{stroke:#E5484D}
.ring b{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--font-display);font-weight:700;font-size:.92rem}
.verdict{position:relative}
.verdict strong{display:inline-block;font-family:var(--font-display);font-size:1.05rem;line-height:1.1;padding:6px 12px;border:2px solid currentColor;border-radius:8px;text-transform:uppercase;letter-spacing:.05em;font-size:.82rem;opacity:0;transform-origin:left center;will-change:transform,opacity;animation:stampIn 14s linear infinite both;animation-delay:calc(4.4s + var(--o))}
.spec.ok .verdict strong{color:#0B807C}.spec.no .verdict strong{color:#C93A3F}
.lab.paused *{animation-play-state:paused!important}
.px:not(.is-ready) .lab-blob,.px:not(.is-ready) .lab-chip,.px:not(.is-ready) .spec,.px:not(.is-ready) .spec *{animation-play-state:paused}

@keyframes specLife{0%{opacity:0;transform:translateY(16px) scale(.985)}3%{opacity:1;transform:none}47%{opacity:1;transform:none}50%{opacity:0;transform:translateY(-12px)}100%{opacity:0}}
@keyframes ckIn{0%{opacity:0;transform:scale(.3)}1.6%{opacity:1;transform:scale(1.18)}2.6%{transform:scale(1)}50%{opacity:1;transform:scale(1)}52%,100%{opacity:0;transform:scale(1)}}
@keyframes scanMove{0%{opacity:0;transform:translateY(0)}1%{opacity:1}13%{opacity:1;transform:translateY(176px)}14%,100%{opacity:0;transform:translateY(176px)}}
@keyframes ringFill{0%{opacity:0;stroke-dashoffset:125.7}1%{opacity:1}9%{stroke-dashoffset:var(--v)}50%{opacity:1;stroke-dashoffset:var(--v)}52%,100%{opacity:0;stroke-dashoffset:var(--v)}}
@keyframes stampIn{0%{opacity:0;transform:scale(1.9) rotate(-12deg)}3%{opacity:1;transform:scale(1) rotate(-4deg)}5%{transform:scale(1.04) rotate(-4deg)}6%{transform:scale(1) rotate(-4deg)}50%{opacity:1;transform:scale(1) rotate(-4deg)}52%,100%{opacity:0;transform:scale(1) rotate(-4deg)}}
@keyframes labDraw{to{stroke-dashoffset:0}}
@keyframes labPulse{0%{box-shadow:0 0 0 0 rgba(14,165,160,.5)}70%,100%{box-shadow:0 0 0 10px rgba(14,165,160,0)}}
.lab-copy>:not(h1){animation:labUp .7s cubic-bezier(.22,.9,.35,1) both}
.lab-copy>:nth-child(3){animation-delay:.05s}.lab-copy>:nth-child(4){animation-delay:.12s}.lab-copy>:nth-child(5){animation-delay:.2s}
@keyframes labUp{from{opacity:.001;transform:translateY(12px)}to{opacity:1;transform:none}}
@media (max-width:900px){.lab-hero{padding-top:96px}.lab-grid{grid-template-columns:1fr;gap:34px}.lab{height:380px}}
@media (prefers-reduced-motion:reduce) and (min-width:99999px){
 .lab-copy>*,.lab-copy h1 .u path,.lab-kicker i{animation:none!important}.lab-copy h1 .u path{stroke-dashoffset:0}
 .spec,.ck,.scan,.ring .fg,.verdict strong{animation:none!important}
 .spec.s-a{opacity:1}.spec.s-b{display:none}.ck,.verdict strong{opacity:1}.ring .fg{opacity:1;stroke-dashoffset:var(--v)}.scan{display:none}}
</style>
<section class="lab-hero">
  <span class="lab-blob b1" aria-hidden="true"></span><span class="lab-blob b2" aria-hidden="true"></span>
  <div class="container lab-grid">
    <div class="lab-copy">
      <span class="lab-kicker"><i></i>Link lab &middot; manual vetting</span>
      <h1>Links worth placing, <span class="u">or none at all<svg viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true"><path d="M3 8 C 60 2, 120 11, 180 5 S 270 3, 297 7"/></svg></span>.</h1>
      <p class="lab-sub">Contomatix builds links, technical and on-page SEO and AI search visibility the checkable way. Every target site is inspected by hand before we ask for a single placement.</p>
      <p class="lab-type" aria-live="off">We vet <span class="ty" data-words="every link|every site|every placement|every outreach email"></span> by hand.</p>
      <div class="lab-actions">
        <a href="/contact" class="btn btn-primary">Get a free audit &rarr;</a>
        <a href="/services" class="btn btn-outline">Explore services</a>
      </div>
      <ul class="lab-facts">
        <li><b><%= typeof postCount !== 'undefined' ? postCount : '370' %></b> guides published</li>
        <li><b>4</b>-point check on every site</li>
        <li><b>0</b> PBNs or link blasts</li>
      </ul>
    </div>
    <div class="tf-col"><%- include('hero-slabs') %></div>
  </div>
</section>
<script>
(function(){var l=document.querySelector('[data-lab]');if(!l||!('IntersectionObserver' in window))return;
new IntersectionObserver(function(e){l.classList.toggle('paused',!e[0].isIntersecting)},{threshold:0.05}).observe(l)})();
</script>
