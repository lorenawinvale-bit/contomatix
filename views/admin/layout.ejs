<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> — Contomatix Admin</title>
  <style>
    :root {
      --bg: #0f1117; --panel: #171a23; --panel-2: #1e2230; --border: #2a2f3f;
      --text: #e7e9ee; --text-dim: #9aa0b2; --accent: #6c8cff; --accent-2: #4f6fe0;
      --danger: #e5566b; --success: #3ecf8e; --radius: 10px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--bg); color: var(--text);
      font-family: -apple-system, "Segoe UI", Inter, Roboto, sans-serif;
      font-size: 15px; line-height: 1.5;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .topbar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 24px; background: var(--panel); border-bottom: 1px solid var(--border);
    }
    .topbar .brand { font-weight: 700; letter-spacing: -0.02em; }
    .topbar .brand span { color: var(--accent); }
    .topbar nav a { color: var(--text-dim); margin-right: 18px; font-size: 14px; }
    .topbar nav a:hover { color: var(--text); }
    .container { max-width: 980px; margin: 0 auto; padding: 32px 24px 80px; }
    .btn {
      display: inline-block; padding: 9px 16px; border-radius: var(--radius);
      background: var(--accent); color: #fff; border: none; cursor: pointer;
      font-size: 14px; font-weight: 600; text-decoration: none;
    }
    .btn:hover { background: var(--accent-2); text-decoration: none; }
    .btn-outline { background: transparent; border: 1px solid var(--border); color: var(--text); }
    .btn-outline:hover { border-color: var(--accent); background: var(--panel-2); }
    .btn-danger { background: transparent; border: 1px solid var(--danger); color: var(--danger); }
    .btn-danger:hover { background: rgba(229,86,107,0.12); }
    .btn-sm { padding: 6px 12px; font-size: 13px; }
    .card {
      background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 24px;
    }
    h1 { font-size: 22px; margin: 0 0 4px; }
    h2 { font-size: 17px; margin: 0 0 12px; }
    .muted { color: var(--text-dim); font-size: 13px; }
    .flash {
      padding: 12px 16px; border-radius: var(--radius); margin-bottom: 20px; font-size: 14px;
    }
    .flash-error { background: rgba(229,86,107,0.12); border: 1px solid var(--danger); color: #ffb3bd; }
    .flash-success { background: rgba(62,207,142,0.12); border: 1px solid var(--success); color: #9df2c9; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--border); font-size: 14px; vertical-align: top; }
    th { color: var(--text-dim); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
    tr:hover td { background: rgba(255,255,255,0.02); }
    .actions { white-space: nowrap; }
    .actions form { display: inline; }
    label { display: block; font-size: 13px; font-weight: 600; margin: 18px 0 6px; color: var(--text-dim); }
    label:first-child { margin-top: 0; }
    input[type=text], input[type=date], input[type=password], select, textarea {
      width: 100%; padding: 10px 12px; border-radius: var(--radius);
      background: var(--panel-2); border: 1px solid var(--border); color: var(--text);
      font-size: 14px; font-family: inherit;
    }
    textarea { min-height: 90px; resize: vertical; }
    textarea.content-editor { min-height: 480px; font-family: "JetBrains Mono", Consolas, monospace; font-size: 13px; }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); }
    .hint { font-size: 12px; color: var(--text-dim); margin-top: 4px; }
    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .top-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .login-wrap { max-width: 360px; margin: 90px auto; }
    .pill { display: inline-block; background: var(--panel-2); border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px; font-size: 12px; color: var(--text-dim); }
  </style>
</head>
<body>
  <% if (typeof hideNav === 'undefined' || !hideNav) { %>
  <div class="topbar">
    <div class="brand">Contomatix<span>.</span> Admin</div>
    <nav>
      <a href="/admin">Posts</a>
      <a href="/" target="_blank">View site &rarr;</a>
      <a href="/admin/logout">Log out</a>
    </nav>
  </div>
  <% } %>
  <div class="container">
    <%- body %>
  </div>
</body>
</html>
